+//! MCP servers that opt in as channels push `notifications/claude/channel` events, which reach
+//! the model of the root thread that owns the server as `<channel>` user input.
+
+use std::collections::BTreeMap;
+use std::io::Write as _;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::Duration;
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::bail;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::ThreadStartResponse;
+use codex_app_server_protocol::TurnStartParams;
+use codex_app_server_protocol::TurnStartResponse;
+use codex_app_server_protocol::UserInput as V2UserInput;
+use codex_features::Feature;
+use core_test_support::responses;
+use core_test_support::responses::ResponsesRequest;
+use core_test_support::skip_if_no_network;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use tempfile::TempDir;
+use tokio::time::Instant;
+use tokio::time::sleep;
+use tokio::time::timeout;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::matchers::method;
+use wiremock::matchers::path_regex;
+
+const SERVER_SCRIPT: &str = include_str!("mcp_channels_server.py");
+const CHANNEL_CAPABILITY: &str = "claude/channel";
+const READ_TIMEOUT: Duration = Duration::from_secs(30);
+/// How long a notification that must not be delivered gets to show up anyway.
+const QUIET_PERIOD: Duration = Duration::from_secs(1);
+const POLL_INTERVAL: Duration = Duration::from_millis(50);
+/// Time given to a sub-agent's MCP startup to launch servers after its first model request.
+const SUBAGENT_SETTLE: Duration = Duration::from_secs(3);
+
+#[derive(Clone, Copy)]
+struct ServerSpec {
+    name: &'static str,
+    /// `mcp_servers.<name>.channel`; `None` leaves the key out of the config.
+    channel: Option<bool>,
+    /// Whether the server declares `capabilities.experimental["claude/channel"]`.
+    capability: bool,
+}
+
+const CHANNEL: ServerSpec = ServerSpec {
+    name: "chan",
+    channel: Some(true),
+    capability: true,
+};
+
+/// Handle on one fake MCP server process: its inbox (lines become notifications) and its
+/// record (JSON lines written by the server).
+struct FakeServer {
+    name: &'static str,
+    inbox: PathBuf,
+    record: PathBuf,
+}
+
+impl FakeServer {
+    fn push(&self, params: &[Value]) -> Result<()> {
+        let mut lines = String::new();
+        for value in params {
+            lines.push_str(&serde_json::to_string(value)?);
+            lines.push('\n');
+        }
+        // One write per call so the server never sees half of a batch.
+        let mut inbox = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(&self.inbox)?;
+        inbox.write_all(lines.as_bytes())?;
+        Ok(())
+    }
+
+    fn records(&self, event: &str) -> Result<Vec<Value>> {
+        let text = match std::fs::read_to_string(&self.record) {
+            Ok(text) => text,
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),
+            Err(err) => return Err(err.into()),
+        };
+        let records = text
+            .lines()
+            .map(|line| serde_json::from_str::<Value>(line).context("record line"))
+            .collect::<Result<Vec<_>>>()?;
+        Ok(records
+            .into_iter()
+            .filter(|record| record["event"] == event)
+            .collect())
+    }
+
+    fn start_count(&self) -> Result<usize> {
+        Ok(self.records("start")?.len())
+    }
+
+    fn sent_notifications(&self) -> Result<Vec<Value>> {
+        Ok(self
+            .records("notification")?
+            .into_iter()
+            .map(|record| record["params"].clone())
+            .collect())
+    }
+
+    /// Capabilities Codex sent in its first `initialize` request to this server.
+    fn client_capabilities(&self) -> Result<Value> {
+        let initialize = self
+            .records("initialize")?
+            .into_iter()
+            .next()
+            .with_context(|| format!("server `{}` never received initialize", self.name))?;
+        Ok(initialize["params"]["capabilities"].clone())
+    }
+}
+
+/// One `<channel>` element as the model sees it, with attribute values and body still escaped.
+#[derive(Debug, Clone, PartialEq)]
+struct ChannelElement {
+    attributes: Vec<(String, String)>,
+    raw_body: String,
+}
+
+impl ChannelElement {
+    /// Parses an input text of the form `<channel k="v">\nBODY\n</channel>`.
+    fn parse(text: &str) -> Option<Self> {
+        let rest = text.strip_prefix("<channel")?;
+        let mut attributes = Vec::new();
+        let mut rest = rest;
+        loop {
+            let trimmed = rest.trim_start_matches(' ');
+            if let Some(after) = trimmed.strip_prefix('>') {
+                rest = after;
+                break;
+            }
+            if trimmed.len() == rest.len() {
+                return None;
+            }
+            let (name, after_name) = trimmed.split_once("=\"")?;
+            let (value, after_value) = after_name.split_once('"')?;
+            attributes.push((name.to_string(), value.to_string()));
+            rest = after_value;
+        }
+        let raw_body = rest.strip_prefix('\n')?.strip_suffix("\n</channel>")?;
+        Some(Self {
+            attributes,
+            raw_body: raw_body.to_string(),
+        })
+    }
+
+    fn body(&self) -> String {
+        unescape(&self.raw_body)
+    }
+
+    fn attribute(&self, name: &str) -> Option<String> {
+        self.attributes
+            .iter()
+            .find(|(key, _)| key == name)
+            .map(|(_, value)| unescape(value))
+    }
+}
+
+fn unescape(text: &str) -> String {
+    text.replace("&lt;", "<")
+        .replace("&gt;", ">")
+        .replace("&quot;", "\"")
+        .replace("&amp;", "&")
+}
+
+/// Every `<channel>` input text of user messages, in request order and item order.
+fn channel_elements(request: &ResponsesRequest) -> Vec<ChannelElement> {
+    request
+        .message_input_texts("user")
+        .iter()
+        .filter(|text| text.starts_with("<channel"))
+        .map(|text| {
+            ChannelElement::parse(text)
+                .unwrap_or_else(|| panic!("malformed <channel> input text: {text:?}"))
+        })
+        .collect()
+}
+
+struct Harness {
+    model: MockServer,
+    app: TestAppServer,
+    thread_id: String,
+    servers: BTreeMap<&'static str, FakeServer>,
+    _home: TempDir,
+}
+
+struct HarnessOptions<'a> {
+    specs: &'a [ServerSpec],
+    features: &'a [Feature],
+    /// Notifications already in a server's inbox before Codex starts it.
+    preloaded: &'a [(&'static str, Value)],
+}
+
+impl Harness {
+    async fn start(specs: &[ServerSpec]) -> Result<Self> {
+        Self::start_with(HarnessOptions {
+            specs,
+            features: &[],
+            preloaded: &[],
+        })
+        .await
+    }
+
+    async fn start_with(options: HarnessOptions<'_>) -> Result<Self> {
+        let model = responses::start_mock_server().await;
+        // Any request not claimed by a test-specific mock ends its turn with a short answer.
+        Mock::given(method("POST"))
+            .and(path_regex(".*/responses$"))
+            .respond_with(responses::sse_response(responses::sse(vec![
+                responses::ev_response_created("resp-default"),
+                responses::ev_assistant_message("msg-default", "ok"),
+                responses::ev_completed("resp-default"),
+            ])))
+            .with_priority(u8::MAX)
+            .mount(&model)
+            .await;
+
+        let home = TempDir::new()?;
+        let script = home.path().join("mcp_channels_server.py");
+        std::fs::write(&script, SERVER_SCRIPT)?;
+        let mut servers = BTreeMap::new();
+        let mut mcp_config = String::new();
+        for spec in options.specs {
+            let server = FakeServer {
+                name: spec.name,
+                inbox: home.path().join(format!("{}.inbox", spec.name)),
+                record: home.path().join(format!("{}.record", spec.name)),
+            };
+            mcp_config.push_str(&server_toml(spec, &script, &server)?);
+            servers.insert(spec.name, server);
+        }
+        for (name, params) in options.preloaded {
+            servers
+                .get(name)
+                .with_context(|| format!("no server named {name}"))?
+                .push(std::slice::from_ref(params))?;
+        }
+        let mut config = MockResponsesConfig::new(&model.uri()).with_extra_config(&mcp_config);
+        for feature in options.features {
+            config = config.enable_feature(*feature);
+        }
+        config.write(home.path())?;
+
+        let mut app = TestAppServer::builder()
+            .with_codex_home(home.path())
+            .build_initialized()
+            .await?;
+        let ThreadStartResponse { thread, .. } = app
+            .start_thread(ThreadStartParams {
+                model: Some("mock-model".to_string()),
+                ..Default::default()
+            })
+            .await?;
+        let mut harness = Self {
+            model,
+            app,
+            thread_id: thread.id,
+            servers,
+            _home: home,
+        };
+        for spec in options.specs {
+            harness.wait_for_server_ready(spec.name).await?;
+        }
+        Ok(harness)
+    }
+
+    fn server(&self, name: &str) -> &FakeServer {
+        &self.servers[name]
+    }
+
+    async fn wait_for_server_ready(&mut self, name: &str) -> Result<()> {
+        let description = format!("MCP server `{name}` ready");
+        timeout(
+            READ_TIMEOUT,
+            self.app
+                .read_stream_until_matching_notification(&description, |notification| {
+                    notification.method == "mcpServer/startupStatus/updated"
+                        && notification.params.as_ref().is_some_and(|params| {
+                            params["name"] == name && params["status"] == "ready"
+                        })
+                }),
+        )
+        .await
+        .with_context(|| format!("timed out waiting for {description}"))??;
+        Ok(())
+    }
+
+    async fn start_user_turn(&mut self, text: &str) -> Result<()> {
+        let thread_id = self.thread_id.clone();
+        let _: TurnStartResponse = self
+            .app
+            .request(|request_id| ClientRequest::TurnStart {
+                request_id,
+                params: TurnStartParams {
+                    thread_id,
+                    client_user_message_id: None,
+                    input: vec![V2UserInput::Text {
+                        text: text.to_string(),
+                        text_elements: Vec::new(),
+                    }],
+                    ..Default::default()
+                },
+            })
+            .await?;
+        Ok(())
+    }
+
+    async fn requests(&self) -> Vec<ResponsesRequest> {
+        responses::received_responses_requests(&self.model).await
+    }
+
+    /// Channel elements in order of first appearance across all model requests, each with the
+    /// index of the request that first carried it.
+    async fn delivered(&self) -> Vec<(usize, ChannelElement)> {
+        let mut seen: Vec<(usize, ChannelElement)> = Vec::new();
+        for (index, request) in self.requests().await.iter().enumerate() {
+            for element in channel_elements(request) {
+                if !seen.iter().any(|(_, known)| known == &element) {
+                    seen.push((index, element));
+                }
+            }
+        }
+        seen
+    }
+
+    /// Waits until some model request carries a channel element whose body is `content`.
+    async fn wait_for_delivery(
+        &self,
+        server: &str,
+        content: &str,
+    ) -> Result<(usize, ChannelElement)> {
+        let deadline = Instant::now() + READ_TIMEOUT;
+        loop {
+            let delivered = self.delivered().await;
+            if let Some(found) = delivered
+                .iter()
+                .find(|(_, element)| element.body() == content)
+            {
+                return Ok(found.clone());
+            }
+            if Instant::now() >= deadline {
+                let sent = self.server(server).sent_notifications()?;
+                let requests = self.requests().await.len();
+                let bodies: Vec<String> = delivered.iter().map(|(_, e)| e.body()).collect();
+                bail!(
+                    "no model request carried a <channel> element with body {content:?} within \
+                     {READ_TIMEOUT:?}.\n  server `{server}` sent: {sent:?}\n  model requests \
+                     received: {requests}\n  <channel> bodies seen: {bodies:?}"
+                );
+            }
+            sleep(POLL_INTERVAL).await;
+        }
+    }
+
+    async fn assert_never_delivered(&self, needle: &str) {
+        for (index, request) in self.requests().await.iter().enumerate() {
+            assert!(
+                !request.body_contains_text(needle),
+                "model request #{index} contains {needle:?}, which must not be delivered"
+            );
+        }
+    }
+}
+
+fn server_toml(spec: &ServerSpec, script: &Path, server: &FakeServer) -> Result<String> {
+    let python = if cfg!(windows) { "python" } else { "python3" };
+    let mut args = vec![
+        path_str(script)?,
+        "--inbox",
+        path_str(&server.inbox)?,
+        "--record",
+        path_str(&server.record)?,
+    ];
+    if !spec.capability {
+        args.push("--no-capability");
+    }
+    // JSON strings and string arrays are valid TOML basic strings and inline arrays.
+    let mut toml = format!(
+        "\n[mcp_servers.{name}]\ncommand = {command}\nargs = {args}\nstartup_timeout_sec = 30\n\
+         default_tools_approval_mode = \"approve\"\n",
+        name = spec.name,
+        command = serde_json::to_string(python)?,
+        args = serde_json::to_string(&args)?,
+    );
+    if let Some(channel) = spec.channel {
+        toml.push_str(&format!("channel = {channel}\n"));
+    }
+    Ok(toml)
+}
+
+fn path_str(path: &Path) -> Result<&str> {
+    path.to_str().context("test paths must be UTF-8")
+}
+
+#[tokio::test]
+async fn idle_thread_starts_a_turn_with_the_channel_message() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let harness = Harness::start(&[CHANNEL]).await?;
+
+    harness.server("chan").push(&[json!({
+        "content": "ping 42",
+        "meta": {"chat_id": "x"},
+    })])?;
+
+    let (index, _) = harness.wait_for_delivery("chan", "ping 42").await?;
+    let request = &harness.requests().await[index];
+    assert!(
+        request
+            .message_input_texts("user")
+            .contains(&"<channel source=\"chan\" chat_id=\"x\">\nping 42\n</channel>".to_string()),
+        "expected the exact <channel> input text; user texts were {:?}",
+        request.message_input_texts("user")
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn notification_during_a_turn_is_queued_and_delivered_after_it() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    const PROMPT: &str = "call the emit tool";
+    const CALL_ID: &str = "call-emit";
+    let mut harness = Harness::start(&[CHANNEL]).await?;
+    let emit_args = json!({"messages": [{"content": "during the turn"}]});
+    responses::mount_sse_once(
+        &harness.model,
+        responses::sse(vec![
+            responses::ev_response_created("resp-tool"),
+            responses::ev_function_call_with_namespace(
+                CALL_ID,
+                "mcp__chan",
+                "emit",
+                &emit_args.to_string(),
+            ),
+            responses::ev_completed("resp-tool"),
+        ]),
+    )
+    .await;
+    responses::mount_sse_once(
+        &harness.model,
+        responses::sse(vec![
+            responses::ev_response_created("resp-final"),
+            responses::ev_assistant_message("msg-final", "tool done"),
+            responses::ev_completed("resp-final"),
+        ]),
+    )
+    .await;
+
+    harness.start_user_turn(PROMPT).await?;
+
+    let (index, element) = harness.wait_for_delivery("chan", "during the turn").await?;
+    let requests = harness.requests().await;
+    assert!(
+        requests[0]
+            .message_input_texts("user")
+            .iter()
+            .any(|text| text == PROMPT),
+        "first model request should be the user turn"
+    );
+    assert!(
+        requests[1].function_call_output_text(CALL_ID).is_some(),
+        "second model request should continue the user turn after the emit tool call"
+    );
+    assert_eq!(
+        channel_elements(&requests[1]),
+        Vec::new(),
+        "the notification arrived while the user turn was running; it must wait for the turn to \
+         end instead of being injected into the turn's follow-up request"
+    );
+    assert!(
+        index >= 2,
+        "the queued notification must start a new turn after the user turn, but it first \
+         appeared in model request #{index}"
+    );
+    assert_eq!(element.attribute("source").as_deref(), Some("chan"));
+    Ok(())
+}
+
+#[tokio::test]
+async fn servers_without_opt_in_or_capability_are_ignored() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let ignored = [
+        ServerSpec {
+            name: "plain",
+            channel: None,
+            capability: true,
+        },
+        ServerSpec {
+            name: "off",
+            channel: Some(false),
+            capability: true,
+        },
+        ServerSpec {
+            name: "nocap",
+            channel: Some(true),
+            capability: false,
+        },
+    ];
+    let mut specs = ignored.to_vec();
+    specs.push(CHANNEL);
+    let harness = Harness::start(&specs).await?;
+
+    for spec in &ignored {
+        harness.server(spec.name).push(&[json!({
+            "content": format!("ignored from {}", spec.name),
+        })])?;
+    }
+    sleep(QUIET_PERIOD).await;
+    harness
+        .server("chan")
+        .push(&[json!({"content": "control"})])?;
+    harness.wait_for_delivery("chan", "control").await?;
+    sleep(QUIET_PERIOD).await;
+
+    for spec in &ignored {
+        let server = harness.server(spec.name);
+        assert_eq!(
+            server.sent_notifications()?.len(),
+            1,
+            "server `{}` should have sent its notification",
+            spec.name
+        );
+        harness
+            .assert_never_delivered(&format!("ignored from {}", spec.name))
+            .await;
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn client_declares_channel_capability_only_to_opted_in_servers() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let specs = [
+        CHANNEL,
+        ServerSpec {
+            name: "nocap",
+            channel: Some(true),
+            capability: false,
+        },
+        ServerSpec {
+            name: "plain",
+            channel: None,
+            capability: true,
+        },
+        ServerSpec {
+            name: "off",
+            channel: Some(false),
+            capability: true,
+        },
+    ];
+    let harness = Harness::start(&specs).await?;
+
+    for name in ["chan", "nocap"] {
+        let capabilities = harness.server(name).client_capabilities()?;
+        assert_eq!(
+            capabilities["experimental"][CHANNEL_CAPABILITY],
+            json!({}),
+            "server `{name}` has channel = true, so Codex must declare \
+             experimental[\"{CHANNEL_CAPABILITY}\"] in initialize; got {capabilities}"
+        );
+    }
+    for name in ["plain", "off"] {
+        let capabilities = harness.server(name).client_capabilities()?;
+        assert!(
+            capabilities
+                .get("experimental")
+                .and_then(|experimental| experimental.get(CHANNEL_CAPABILITY))
+                .is_none(),
+            "server `{name}` did not opt in, so its initialize must stay as upstream; got \
+             {capabilities}"
+        );
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn notifications_are_delivered_once_and_in_order() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let harness = Harness::start(&[CHANNEL]).await?;
+
+    harness.server("chan").push(&[
+        json!({"content": "first"}),
+        json!({"content": "second"}),
+        json!({"content": "third"}),
+    ])?;
+
+    harness.wait_for_delivery("chan", "third").await?;
+    let order: Vec<String> = harness
+        .delivered()
+        .await
+        .into_iter()
+        .map(|(_, element)| element.body())
+        .collect();
+    assert_eq!(order, vec!["first", "second", "third"]);
+    let last = harness
+        .requests()
+        .await
+        .pop()
+        .context("at least one model request")?;
+    let bodies: Vec<String> = channel_elements(&last)
+        .iter()
+        .map(ChannelElement::body)
+        .collect();
+    assert_eq!(
+        bodies,
+        vec!["first", "second", "third"],
+        "the latest model request should carry each notification exactly once, in order"
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn meta_keeps_only_valid_string_entries_after_source() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let harness = Harness::start(&[CHANNEL]).await?;
+
+    harness.server("chan").push(&[json!({
+        "content": "meta check",
+        "meta": {
+            "chat_id": "x",
+            "A1_b": "y",
+            "bad-key": "dash",
+            "with space": "space",
+            "dotted.key": "dot",
+            "ünï": "unicode",
+            "": "empty",
+            "source": "spoofed",
+            "number": 7,
+            "object": {"nested": "value"},
+            "flag": true,
+        },
+    })])?;
+
+    let (_, element) = harness.wait_for_delivery("chan", "meta check").await?;
+    assert_eq!(
+        element.attributes,
+        vec![
+            ("source".to_string(), "chan".to_string()),
+            ("A1_b".to_string(), "y".to_string()),
+            ("chat_id".to_string(), "x".to_string()),
+        ],
+        "expected source first, then valid string meta entries in key order"
+    );
+    Ok(())
+}
