diff --git a/codex-rs/tui/src/status_line_file.rs b/codex-rs/tui/src/status_line_file.rs
new file mode 100644
index 0000000000..280851ab75
--- /dev/null
+++ b/codex-rs/tui/src/status_line_file.rs
@@ -0,0 +1,459 @@
+//! Status line items provided by an external program through a JSON file.
+//!
+//! When `tui.status_line_file`, or the `CODEX_STATUS_LINE_FILE` environment variable, names a
+//! file, its fields can be referenced from `tui.status_line` as `file:<key>` items next to the
+//! built-in items. Any program may write the file:
+//!
+//! ```json
+//! {"fields": {"build": "build ok", "queue": 3}}
+//! ```
+//!
+//! Values are strings or numbers. Missing files, invalid JSON, unknown keys and other value types
+//! hide the corresponding items without warnings; control characters are replaced with spaces and
+//! long values are truncated with an ellipsis. Writers should replace the file atomically (write a
+//! temporary file, then rename it) so a half-written file is never read.
+//!
+//! `{session_id}` in the path expands to the id of the session shown by the TUI, the value shell
+//! commands receive as `CODEX_SESSION_ID`, so each instance and session can use its own file.
+//! When the session changes, values read from the previous file are discarded immediately.
+//!
+//! A background thread polls the file's metadata and re-reads it only when it changes. Rendering
+//! never touches the file system: it only clones an `Arc` of the last parsed values, and the
+//! watcher schedules a frame whenever those values change.
+
+use std::collections::BTreeMap;
+use std::fmt;
+use std::fs::File;
+use std::io::Read;
+use std::path::Path;
+use std::path::PathBuf;
+use std::str::FromStr;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::MutexGuard;
+use std::sync::OnceLock;
+use std::sync::PoisonError;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::sync::mpsc;
+use std::sync::mpsc::RecvTimeoutError;
+use std::time::Duration;
+use std::time::SystemTime;
+
+use codex_protocol::ThreadId;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use unicode_segmentation::UnicodeSegmentation;
+use unicode_width::UnicodeWidthStr;
+
+use crate::bottom_pane::StatusLineItem;
+use crate::tui::FrameRequester;
+
+/// Environment variable naming the status line file; it takes precedence over the config.
+pub(crate) const STATUS_LINE_FILE_ENV_VAR: &str = "CODEX_STATUS_LINE_FILE";
+
+/// Prefix of status line item ids that refer to fields of the status line file.
+///
+/// Built-in ids are kebab-case, so a colon can never collide with them.
+pub(crate) const STATUS_LINE_FILE_ITEM_PREFIX: &str = "file:";
+
+/// Path placeholder replaced with the current session id.
+pub(crate) const SESSION_ID_PLACEHOLDER: &str = "{session_id}";
+
+/// Maximum display width of one field value, ellipsis included.
+pub(crate) const MAX_FIELD_WIDTH: usize = 48;
+
+/// Maximum length of a field key, in bytes.
+const MAX_KEY_LEN: usize = 64;
+
+/// Files larger than this are ignored.
+const MAX_FILE_BYTES: u64 = 64 * 1024;
+
+/// How often the watcher checks the file's metadata.
+const POLL_INTERVAL: Duration = Duration::from_millis(500);
+
+/// One configured status line item: a built-in item or a field of the status line file.
+#[derive(Clone, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub(crate) enum StatusLineEntry {
+    Builtin(StatusLineItem),
+    File(String),
+}
+
+impl StatusLineEntry {
+    /// Built-in items in configured order, without file fields.
+    pub(crate) fn builtin_items(entries: &[Self]) -> Vec<StatusLineItem> {
+        entries
+            .iter()
+            .filter_map(|entry| match entry {
+                Self::Builtin(item) => Some(*item),
+                Self::File(_) => None,
+            })
+            .collect()
+    }
+}
+
+impl From<StatusLineItem> for StatusLineEntry {
+    fn from(item: StatusLineItem) -> Self {
+        Self::Builtin(item)
+    }
+}
+
+impl FromStr for StatusLineEntry {
+    type Err = strum::ParseError;
+
+    fn from_str(id: &str) -> Result<Self, Self::Err> {
+        match id.strip_prefix(STATUS_LINE_FILE_ITEM_PREFIX) {
+            Some(key) if is_valid_key(key) => Ok(Self::File(key.to_string())),
+            Some(_) => Err(strum::ParseError::VariantNotFound),
+            None => id.parse().map(Self::Builtin),
+        }
+    }
+}
+
+impl fmt::Display for StatusLineEntry {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Builtin(item) => item.fmt(f),
+            Self::File(key) => write!(f, "{STATUS_LINE_FILE_ITEM_PREFIX}{key}"),
+        }
+    }
+}
+
+/// Displayable field values parsed from the status line file.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub(crate) struct StatusLineFileFields {
+    values: BTreeMap<String, String>,
+}
+
+impl StatusLineFileFields {
+    /// Parses the file contents. Anything unusable yields no fields rather than an error.
+    pub(crate) fn parse(contents: &[u8]) -> Self {
+        let Ok(serde_json::Value::Object(root)) = serde_json::from_slice(contents) else {
+            return Self::default();
+        };
+        let Some(serde_json::Value::Object(fields)) = root.get("fields") else {
+            return Self::default();
+        };
+        let values = fields
+            .iter()
+            .filter(|(key, _)| is_valid_key(key))
+            .filter_map(|(key, value)| {
+                let text = match value {
+                    serde_json::Value::String(text) => normalize_value(text),
+                    serde_json::Value::Number(number) => normalize_value(&number.to_string()),
+                    _ => None,
+                }?;
+                Some((key.clone(), text))
+            })
+            .collect();
+        Self { values }
+    }
+
+    pub(crate) fn get(&self, key: &str) -> Option<&str> {
+        self.values.get(key).map(String::as_str)
+    }
+
+    /// Field keys in sorted order.
+    pub(crate) fn keys(&self) -> impl Iterator<Item = &str> {
+        self.values.keys().map(String::as_str)
+    }
+
+    pub(crate) fn is_empty(&self) -> bool {
+        self.values.is_empty()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn from_pairs<'a>(pairs: impl IntoIterator<Item = (&'a str, &'a str)>) -> Self {
+        Self {
+            values: pairs
+                .into_iter()
+                .map(|(key, value)| (key.to_string(), value.to_string()))
+                .collect(),
+        }
+    }
+}
+
+/// The shared empty value, so unchanged empty snapshots compare equal with [`Arc::ptr_eq`].
+pub(crate) fn empty_fields() -> Arc<StatusLineFileFields> {
+    static EMPTY: OnceLock<Arc<StatusLineFileFields>> = OnceLock::new();
+    Arc::clone(EMPTY.get_or_init(Default::default))
+}
+
+fn is_valid_key(key: &str) -> bool {
+    !key.is_empty()
+        && key.len() <= MAX_KEY_LEN
+        && key
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b'.'))
+}
+
+/// Collapses whitespace and control characters into single spaces and limits the display width.
+fn normalize_value(raw: &str) -> Option<String> {
+    let text = raw
+        .split(|ch: char| ch.is_whitespace() || ch.is_control())
+        .filter(|part| !part.is_empty())
+        .collect::<Vec<_>>()
+        .join(" ");
+    (!text.is_empty()).then(|| truncate_to_width(text, MAX_FIELD_WIDTH))
+}
+
+fn truncate_to_width(text: String, max_width: usize) -> String {
+    if text.width() <= max_width {
+        return text;
+    }
+    let mut truncated = String::new();
+    let mut width = 0;
+    for grapheme in text.graphemes(/*is_extended*/ true) {
+        let grapheme_width = grapheme.width();
+        if width + grapheme_width >= max_width {
+            break;
+        }
+        truncated.push_str(grapheme);
+        width += grapheme_width;
+    }
+    let mut truncated = truncated.trim_end().to_string();
+    truncated.push('…');
+    truncated
+}
+
+/// Expands [`SESSION_ID_PLACEHOLDER`]; a path that needs a session id has none until one exists.
+pub(crate) fn resolve_path(template: &Path, session_id: Option<ThreadId>) -> Option<PathBuf> {
+    match template.to_str() {
+        Some(text) if text.contains(SESSION_ID_PLACEHOLDER) => session_id
+            .map(|id| PathBuf::from(text.replace(SESSION_ID_PLACEHOLDER, &id.to_string()))),
+        _ => Some(template.to_path_buf()),
+    }
+}
+
+/// Path template from the environment, read once; relative paths use the startup directory.
+fn env_template() -> Option<&'static Path> {
+    static TEMPLATE: OnceLock<Option<PathBuf>> = OnceLock::new();
+    TEMPLATE
+        .get_or_init(|| {
+            let value = std::env::var_os(STATUS_LINE_FILE_ENV_VAR)?;
+            if value.is_empty() {
+                return None;
+            }
+            std::path::absolute(PathBuf::from(value)).ok()
+        })
+        .as_deref()
+}
+
+/// Watches one file at a time from a background thread.
+pub(crate) struct StatusLineFileWatcher {
+    path: Option<PathBuf>,
+    epoch: u64,
+    published: Arc<Mutex<Published>>,
+    targets: mpsc::Sender<WatchTarget>,
+}
+
+struct Published {
+    epoch: u64,
+    fields: Arc<StatusLineFileFields>,
+}
+
+struct WatchTarget {
+    epoch: u64,
+    path: Option<PathBuf>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct FileSignature {
+    modified: Option<SystemTime>,
+    len: u64,
+    #[cfg(unix)]
+    inode: u64,
+}
+
+impl StatusLineFileWatcher {
+    /// Starts the watcher thread; `on_change` runs on it whenever the published fields change.
+    pub(crate) fn spawn(
+        poll_interval: Duration,
+        on_change: impl Fn() + Send + 'static,
+    ) -> std::io::Result<Self> {
+        let published = Arc::new(Mutex::new(Published {
+            epoch: 0,
+            fields: empty_fields(),
+        }));
+        let (targets, receiver) = mpsc::channel();
+        let thread_published = Arc::clone(&published);
+        std::thread::Builder::new()
+            .name("status-line-file".to_string())
+            .spawn(move || watch_loop(&receiver, &thread_published, poll_interval, &on_change))?;
+        Ok(Self {
+            path: None,
+            epoch: 0,
+            published,
+            targets,
+        })
+    }
+
+    /// Watches `path` instead of the current file, discarding values read from the old one.
+    pub(crate) fn set_path(&mut self, path: Option<PathBuf>) {
+        if self.path == path {
+            return;
+        }
+        self.epoch += 1;
+        self.path.clone_from(&path);
+        {
+            let mut published = lock(&self.published);
+            published.epoch = self.epoch;
+            published.fields = empty_fields();
+        }
+        let _ = self.targets.send(WatchTarget {
+            epoch: self.epoch,
+            path,
+        });
+    }
+
+    pub(crate) fn fields(&self) -> Arc<StatusLineFileFields> {
+        Arc::clone(&lock(&self.published).fields)
+    }
+}
+
+fn watch_loop(
+    receiver: &mpsc::Receiver<WatchTarget>,
+    published: &Mutex<Published>,
+    poll_interval: Duration,
+    on_change: &dyn Fn(),
+) {
+    let mut target = WatchTarget {
+        epoch: 0,
+        path: None,
+    };
+    let mut last_signature = None;
+    loop {
+        match receiver.recv_timeout(poll_interval) {
+            Ok(next) => {
+                target = receiver.try_iter().last().unwrap_or(next);
+                last_signature = None;
+            }
+            Err(RecvTimeoutError::Timeout) => {}
+            Err(RecvTimeoutError::Disconnected) => return,
+        }
+        let Some(path) = target.path.as_deref() else {
+            continue;
+        };
+        let signature = file_signature(path);
+        if signature == last_signature {
+            continue;
+        }
+        last_signature = signature;
+        let fields = match signature {
+            Some(signature) if signature.len <= MAX_FILE_BYTES => read_fields(path),
+            _ => StatusLineFileFields::default(),
+        };
+        if publish(published, target.epoch, fields) {
+            on_change();
+        }
+    }
+}
+
+fn file_signature(path: &Path) -> Option<FileSignature> {
+    let metadata = std::fs::metadata(path).ok()?;
+    Some(FileSignature {
+        modified: metadata.modified().ok(),
+        len: metadata.len(),
+        #[cfg(unix)]
+        inode: std::os::unix::fs::MetadataExt::ino(&metadata),
+    })
+}
+
+fn read_fields(path: &Path) -> StatusLineFileFields {
+    let mut contents = Vec::new();
+    let read =
+        File::open(path).and_then(|file| file.take(MAX_FILE_BYTES + 1).read_to_end(&mut contents));
+    match read {
+        Ok(len) if len as u64 <= MAX_FILE_BYTES => StatusLineFileFields::parse(&contents),
+        Ok(_) => StatusLineFileFields::default(),
+        Err(err) => {
+            tracing::debug!(error = %err, path = %path.display(), "failed to read status line file");
+            StatusLineFileFields::default()
+        }
+    }
+}
+
+/// Publishes fields read for `epoch`; returns whether visible values changed.
+fn publish(published: &Mutex<Published>, epoch: u64, fields: StatusLineFileFields) -> bool {
+    let mut published = lock(published);
+    if published.epoch != epoch || *published.fields == fields {
+        return false;
+    }
+    published.fields = if fields.is_empty() {
+        empty_fields()
+    } else {
+        Arc::new(fields)
+    };
+    true
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+/// The process-wide watcher: one status line file per running Codex instance.
+struct Instance {
+    watcher: StatusLineFileWatcher,
+    template: Option<PathBuf>,
+    session_id: Option<ThreadId>,
+}
+
+static INSTANCE: Mutex<Option<Instance>> = Mutex::new(None);
+static SPAWN_FAILED: AtomicBool = AtomicBool::new(false);
+
+/// Points the process-wide watcher at the configured file for `session_id`.
+///
+/// Cheap enough to call before every frame. Nothing is started until a path is configured.
+pub(crate) fn sync(
+    config_path: Option<&AbsolutePathBuf>,
+    session_id: Option<ThreadId>,
+    frame_requester: &FrameRequester,
+) {
+    let template = env_template().or(config_path.map(AbsolutePathBuf::as_path));
+    let mut instance = lock(&INSTANCE);
+    if let Some(instance) = instance.as_ref()
+        && instance.template.as_deref() == template
+        && instance.session_id == session_id
+    {
+        return;
+    }
+    if instance.is_none() {
+        if template.is_none() || SPAWN_FAILED.load(Ordering::Relaxed) {
+            return;
+        }
+        let frame_requester = frame_requester.clone();
+        match StatusLineFileWatcher::spawn(POLL_INTERVAL, move || {
+            frame_requester.schedule_frame();
+        }) {
+            Ok(watcher) => {
+                *instance = Some(Instance {
+                    watcher,
+                    template: None,
+                    session_id: None,
+                });
+            }
+            Err(err) => {
+                SPAWN_FAILED.store(true, Ordering::Relaxed);
+                tracing::warn!(error = %err, "failed to start the status line file watcher");
+                return;
+            }
+        }
+    }
+    if let Some(instance) = instance.as_mut() {
+        instance.template = template.map(Path::to_path_buf);
+        instance.session_id = session_id;
+        instance
+            .watcher
+            .set_path(template.and_then(|template| resolve_path(template, session_id)));
+    }
+}
+
+/// Latest fields of the process-wide status line file.
+pub(crate) fn current_fields() -> Arc<StatusLineFileFields> {
+    lock(&INSTANCE)
+        .as_ref()
+        .map_or_else(empty_fields, |instance| instance.watcher.fields())
+}
