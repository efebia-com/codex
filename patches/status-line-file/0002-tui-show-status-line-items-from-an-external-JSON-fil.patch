+fn watcher_reports_only_visible_changes() {
+    let dir = TempDir::new().expect("temp dir");
+    let path = dir.path().join("status.json");
+    write_atomically(&path, r#"{"fields": {"build": "ok"}}"#);
+    let mut test = TestWatcher::spawn();
+    test.watcher.set_path(Some(path.clone()));
+    // The first read is the only change so far. Its notification follows the publish, so wait for
+    // the notification itself rather than for the values.
+    test.changes
+        .recv_timeout(TEST_TIMEOUT)
+        .expect("change reported for the first read");
+    let snapshot = test.watcher.fields();
+    assert_eq!(*snapshot, fields(&[("build", "ok")]));
+
+    // Same visible values with different formatting and an ignored key.
+    write_atomically(&path, r#"{"fields": {"build": " ok ", "flag": false}}"#);
+    std::thread::sleep(TEST_POLL_INTERVAL * 20);
+    assert!(
+        test.changes.try_recv().is_err(),
+        "no change should be reported"
+    );
+    assert!(Arc::ptr_eq(&test.watcher.fields(), &snapshot));
+}
