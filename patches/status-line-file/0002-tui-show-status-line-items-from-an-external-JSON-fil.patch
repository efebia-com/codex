+#[test]
+fn watcher_follows_file_changes() {
+    let dir = TempDir::new().expect("temp dir");
+    let path = dir.path().join("status.json");
+    let mut test = TestWatcher::spawn();
+    test.watcher.set_path(Some(path.clone()));
+    assert!(
+        test.watcher.fields().is_empty(),
+        "missing file has no fields"
+    );
+
+    write_atomically(&path, r#"{"fields": {"build": "running"}}"#);
+    test.wait_for(&fields(&[("build", "running")]));
+
+    write_atomically(&path, r#"{"fields": {"build": "ok", "queue": 2}}"#);
+    test.wait_for(&fields(&[("build", "ok"), ("queue", "2")]));
+
+    write_atomically(&path, "{\"fields\": {\"build\": ");
+    test.wait_for(&StatusLineFileFields::default());
+
+    write_atomically(&path, r#"{"fields": {"build": "back"}}"#);
+    test.wait_for(&fields(&[("build", "back")]));
+
+    std::fs::remove_file(&path).expect("remove file");
+    test.wait_for(&StatusLineFileFields::default());
