+    let wide = parsed.get("wide").expect("wide value");
+    assert_eq!(wide, format!("{}…", "界".repeat((MAX_FIELD_WIDTH - 1) / 2)));
+    assert!(wide.width() <= MAX_FIELD_WIDTH);
