+struct TestWatcher {
+    watcher: StatusLineFileWatcher,
+    changes: mpsc::Receiver<()>,
+}
+
+impl TestWatcher {
+    fn spawn() -> Self {
+        let (tx, changes) = mpsc::channel();
+        let watcher = StatusLineFileWatcher::spawn(TEST_POLL_INTERVAL, move || {
+            let _ = tx.send(());
+        })
+        .expect("spawn watcher");
+        Self { watcher, changes }
+    }
+
+    fn wait_for(&self, expected: &StatusLineFileFields) {
+        let deadline = Instant::now() + TEST_TIMEOUT;
+        while *self.watcher.fields() != *expected {
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            assert!(
+                !remaining.is_zero(),
+                "timed out waiting for {expected:?}, have {:?}",
+                self.watcher.fields()
+            );
+            let _ = self
+                .changes
+                .recv_timeout(remaining.min(TEST_POLL_INTERVAL * 10));
+        }
+    }
+}
+
+fn write_atomically(path: &Path, contents: &str) {
+    let temp = path.with_extension("tmp");
+    std::fs::write(&temp, contents).expect("write temp file");
+    std::fs::rename(&temp, path).expect("rename temp file");
+}
