@@ -0,0 +1,29 @@
+//! `file:<key>` status-line items backed by the status line file.
+//!
+//! The file itself is watched off the render path by [`crate::status_line_file`]; this module
+//! only swaps in the latest parsed snapshot and resolves item values from it.
+
+use super::*;
+use crate::status_line_file::StatusLineEntry;
+
+impl ChatWidget {
+    /// Refreshes the status line when the watcher has published new file fields.
+    pub(super) fn refresh_status_line_if_file_changed(&mut self) {
+        let latest = crate::status_line_file::current_fields();
+        if !Arc::ptr_eq(&latest, &self.status_line_file_fields) {
+            self.status_line_file_fields = latest;
+            self.refresh_status_line();
+        }
+    }
+
+    /// Resolves one configured status-line entry; `None` omits it, as for built-in items.
+    pub(super) fn status_line_entry_value(&mut self, entry: &StatusLineEntry) -> Option<String> {
+        match entry {
+            StatusLineEntry::Builtin(item) => self.status_line_value_for_item(*item),
+            StatusLineEntry::File(key) => self
+                .status_line_file_fields
+                .get(key)
+                .map(ToString::to_string),
+        }
+    }
+}
