+//! `file:<key>` status-line items backed by an externally written JSON file.
+
+use super::*;
+use crate::status_line_file::StatusLineFileFields;
+use pretty_assertions::assert_eq;
+
+fn set_file_fields(chat: &mut ChatWidget, pairs: &[(&str, &str)]) {
+    chat.status_line_file_fields =
+        Arc::new(StatusLineFileFields::from_pairs(pairs.iter().copied()));
+}
+
+#[tokio::test]
+async fn status_line_renders_file_fields_in_configured_order() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let thread_id = ThreadId::from_u128(/*value*/ 42);
+    chat.thread_id = Some(thread_id);
+    set_file_fields(&mut chat, &[("build", "build ok"), ("queue", "3 queued")]);
+    chat.local_settings.tui.status_line = Some(vec![
+        "file:queue".to_string(),
+        "thread-id".to_string(),
+        "file:missing".to_string(),
+        "file:build".to_string(),
+    ]);
+
+    chat.refresh_status_line();
+
+    assert_eq!(
+        status_line_text(&chat),
+        Some(format!("3 queued · {thread_id} · build ok"))
+    );
+    assert!(
+        drain_insert_history(&mut rx).is_empty(),
+        "file items must not be reported as invalid"
+    );
+}
+
+#[tokio::test]
+async fn status_line_with_only_unavailable_file_fields_stays_quiet() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.local_settings.tui.status_line = Some(vec!["file:build".to_string()]);
+
+    chat.refresh_status_line();
+
+    assert_eq!(status_line_text(&chat).unwrap_or_default(), "");
+    assert!(drain_insert_history(&mut rx).is_empty());
+}
+
+#[tokio::test]
+async fn malformed_file_item_ids_warn_like_other_invalid_items() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.local_settings.tui.status_line =
+        Some(vec!["file:build".to_string(), "file:bad key".to_string()]);
+
+    chat.refresh_status_line();
+
+    let cells = drain_insert_history_transcript(&mut rx);
+    assert_eq!(cells.len(), 1, "expected one warning history cell");
+    let rendered = lines_to_single_string(&cells[0]);
+    assert!(
+        rendered.contains("file:bad key") && !rendered.contains("\"file:build\""),
+        "unexpected warning: {rendered}"
+    );
+}
+
+#[tokio::test]
+async fn status_line_drops_file_fields_when_the_watcher_publishes_new_ones() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.local_settings.tui.status_line =
+        Some(vec!["file:build".to_string(), "run-state".to_string()]);
+    set_file_fields(&mut chat, &[("build", "build ok")]);
+    chat.refresh_status_line();
+    assert_eq!(
+        status_line_text(&chat),
+        Some("build ok · Ready".to_string())
+    );
+
+    // No file is watched in tests, so the process-wide snapshot is empty.
+    chat.refresh_status_line_if_file_changed();
+
+    assert_eq!(status_line_text(&chat), Some("Ready".to_string()));
+    let unchanged = Arc::clone(&chat.status_line_file_fields);
+    chat.refresh_status_line_if_file_changed();
+    assert!(Arc::ptr_eq(&unchanged, &chat.status_line_file_fields));
+}
+
+#[tokio::test]
+async fn statusline_command_accepts_file_items() {
+    let (mut chat, mut events, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    set_file_fields(&mut chat, &[("build", "build ok")]);
+
+    chat.dispatch_command_with_args(
+        SlashCommand::Statusline,
+        "file:build run-state file:later".to_string(),
+        Vec::new(),
+    );
+
+    assert_eq!(
+        chat.local_settings.tui.status_line,
+        Some(vec![
+            "file:build".to_string(),
+            "run-state".to_string(),
+            "file:later".to_string(),
+        ])
+    );
+    assert_eq!(
+        status_line_text(&chat),
+        Some("build ok · Ready".to_string())
+    );
+    let errors = std::iter::from_fn(|| events.try_recv().ok())
+        .filter(|event| matches!(event, AppEvent::InsertHistoryCell(_)))
+        .count();
+    assert_eq!(errors, 0);
+}
+
+#[tokio::test]
+async fn status_line_file_fields_footer_snapshot() {
+    use ratatui::Terminal;
+    use ratatui::backend::TestBackend;
+
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.show_welcome_banner = false;
+    chat.local_settings.tui.status_line_use_colors = false;
+    chat.status_line_file_fields = Arc::new(StatusLineFileFields::parse(
+        br#"{"fields": {
+            "build": "build ok",
+            "deploy": "staging deploy\nwaiting for approval from the release team"
+        }}"#,
+    ));
+    chat.local_settings.tui.status_line = Some(vec![
+        "run-state".to_string(),
+        "file:build".to_string(),
+        "file:deploy".to_string(),
+    ]);
+    chat.refresh_status_line();
+
+    let width = 80;
+    let height = chat.desired_height(width);
+    let mut terminal = Terminal::new(TestBackend::new(width, height)).expect("create terminal");
+    terminal
+        .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+        .expect("draw status line file footer");
+    assert_chatwidget_snapshot!(
+        "status_line_file_fields_footer",
+        normalized_backend_snapshot(terminal.backend())
+    );
+}
