# Extension tests, run from codex-rs/ after every series is applied.
#
# Format: <extension>: <arguments for cargo test>
# An extension may have several lines; each line is one cargo test command.
# Only extensions listed in patches/series are run; a command listed under two
# extensions runs once.

mcp-session-env: -p codex-config --lib mcp_codex_env
mcp-session-env: -p codex-rmcp-client --lib codex_source
mcp-session-env: -p codex-mcp --lib session_env
mcp-session-env: -p codex-core --test all mcp_session_env
# Both series change the generated config schema.
mcp-session-env: -p codex-core --lib config::schema::tests

channels: -p codex-rmcp-client --lib custom_notifications
channels: -p codex-mcp --lib channel
channels: -p codex-channels-extension
channels: -p codex-core --lib config::schema::tests

channels-tests: -p codex-app-server --test all mcp_channels

status-line-file: -p codex-tui status_line
status-line-file: -p codex-core --lib config::schema::tests

channels-inject: -p codex-config channel_during_turn
channels-inject: -p codex-core --lib config::schema::tests
channels-inject: -p codex-rmcp-client --lib custom_notifications
channels-inject: -p codex-mcp --lib channel
channels-inject: -p codex-channels-extension
channels-inject: -p codex-app-server --test all mcp_channels

channels-inject-tests: -p codex-app-server --test all mcp_channels::during_turn
