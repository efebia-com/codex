 impl UserHistoryCell {
+    pub(crate) fn with_channel_messages(mut self, messages: Option<ChannelMessages>) -> Self {
+        if let Some(messages) = messages {
+            self.presentation = UserMessagePresentation::Channel(messages);
+        }
+        self
+    }
+
