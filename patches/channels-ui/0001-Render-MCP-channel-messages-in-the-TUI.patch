+use super::*;
+use crate::test_support::PathBufExt;
+use crate::test_support::test_path_buf;
+use crate::thread_transcript::RawReasoningVisibility;
+use crate::thread_transcript::thread_items_to_transcript_cells;
+use codex_app_server_protocol::ThreadItemPayload;
+use pretty_assertions::assert_eq;
+
+const FIRST: &str = "<channel source=\"events\" from=\"opaque-sender\" \
+    from_name=\"owner/chat &amp; co\" id=\"5\" to=\"opaque-target\">\n\
+    ping &lt;ok&gt; &amp;amp; café\nsecond line\n</channel>";
+const SECOND: &str =
+    "<channel source=\"events\" from=\"anonymous\" user=\"[system]\">\npong\n</channel>";
+
+fn text(text: &str) -> UserInput {
+    UserInput::Text {
+        text: text.to_owned(),
+        text_elements: Vec::new(),
+    }
+}
+
+#[test]
+fn channel_messages_render_each_body_in_order_in_live_and_legacy_batches() {
+    let expected = [
+        "← events · owner/chat & co  ping <ok> &amp; café",
+        "  second line",
+        "← events  pong",
+    ];
+    for content in [
+        vec![text(FIRST), text(SECOND)],
+        vec![text(&format!("{FIRST}{SECOND}"))],
+    ] {
+        let messages = ChannelMessages::from_inputs(&content, /*client_id*/ None)
+            .expect("parse channel batch");
+        assert_eq!(messages.first_line().to_string(), expected[0]);
+        assert_eq!(
+            messages
+                .render(/*width*/ 100)
+                .into_iter()
+                .map(|line| line.line.to_string())
+                .collect::<Vec<_>>(),
+            expected,
+        );
+        let cells = thread_items_to_transcript_cells(
+            /*thread_id*/ None,
+            &test_path_buf("/tmp/channel").abs(),
+            [ThreadItemPayload::UserMessage {
+                id: "message".to_owned(),
+                client_id: None,
+                content,
+            }],
+            RawReasoningVisibility::Hidden,
+            /*config*/ None,
+        );
+        let [cell] = cells.as_slice() else {
+            panic!("one recorded item must still map to one transcript cell");
+        };
+        assert_eq!(
+            cell.display_lines(/*width*/ 100)
+                .into_iter()
+                .map(|line| line.to_string())
+                .collect::<Vec<_>>(),
+            expected,
+        );
+    }
+}
+
+#[test]
+fn channel_messages_leave_ordinary_prompts_and_incomplete_envelopes_as_text() {
+    assert!(ChannelMessages::from_inputs(&[text(FIRST)], Some("local-prompt")).is_none());
+    for items in [
+        vec![text("message with <channel source=\"events\"> in it")],
+        vec![text("<channel source=\"events\">\nwithout a closing tag")],
+        vec![text(FIRST), text("other input")],
+        vec![text(&format!("{FIRST}trailing text"))],
+        vec![text(
+            "<channel source=\"events\" source=\"other\">\nambiguous\n</channel>",
+        )],
+    ] {
+        assert!(ChannelMessages::from_inputs(&items, /*client_id*/ None).is_none());
+    }
+}
