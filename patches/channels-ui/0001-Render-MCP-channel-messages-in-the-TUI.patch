diff --git a/codex-rs/tui/src/history_cell/channel.rs b/codex-rs/tui/src/history_cell/channel.rs
new file mode 100644
index 00000000..7f078181
--- /dev/null
+++ b/codex-rs/tui/src/history_cell/channel.rs
@@ -0,0 +1,147 @@
+//! Presentation of MCP channel messages in the transcript.
+
+use codex_app_server_protocol::UserInput;
+use quick_xml::Reader;
+use quick_xml::XmlVersion;
+use quick_xml::escape::unescape;
+use quick_xml::events::Event;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+
+use super::messages::sanitize_user_text;
+use crate::style::accent_color;
+use crate::terminal_hyperlinks::HyperlinkLine;
+use crate::terminal_hyperlinks::adaptive_wrap_hyperlink_lines;
+use crate::terminal_hyperlinks::annotate_web_urls;
+use crate::wrapping::RtOptions;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ChannelMessages(Vec<ChannelMessage>);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct ChannelMessage {
+    label: String,
+    text: String,
+}
+
+impl ChannelMessages {
+    pub(crate) fn from_inputs(items: &[UserInput], client_id: Option<&str>) -> Option<Self> {
+        // The extension has no client submission ID. Match its complete envelope so XML
+        // pasted into a local prompt, partial envelopes and mixed input keep their normal rendering.
+        if client_id.is_some() || items.is_empty() {
+            return None;
+        }
+        let mut messages = Vec::new();
+        for item in items {
+            let UserInput::Text {
+                text,
+                text_elements,
+            } = item
+            else {
+                return None;
+            };
+            if !text_elements.is_empty() {
+                return None;
+            }
+            // Older history concatenates a batch's text inputs into a single string.
+            let mut remaining = text.as_str();
+            loop {
+                let (message, rest) = ChannelMessage::parse(remaining)?;
+                messages.push(message);
+                if rest.is_empty() {
+                    break;
+                }
+                remaining = rest;
+            }
+        }
+        Some(Self(messages))
+    }
+
+    pub(crate) fn first_line(&self) -> Line<'static> {
+        self.0.first().map_or_else(Line::default, |message| {
+            let first = message.text.lines().next().unwrap_or_default();
+            message_header("←", &message.label, first)
+        })
+    }
+
+    pub(super) fn render(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.0
+            .iter()
+            .flat_map(|message| channel_lines("←", &message.label, &message.text, width))
+            .collect()
+    }
+}
+
+impl ChannelMessage {
+    fn parse(text: &str) -> Option<(Self, &str)> {
+        if !text.starts_with("<channel source=\"") {
+            return None;
+        }
+        let mut reader = Reader::from_str(text);
+        let Event::Start(tag) = reader.read_event().ok()? else {
+            return None;
+        };
+        let body = text
+            .get(usize::try_from(reader.buffer_position()).ok()?..)?
+            .strip_prefix('\n')?;
+        let (body, rest) = body.split_once("\n</channel>")?;
+        if body.contains(['<', '>']) {
+            return None;
+        }
+        let mut source = None;
+        let mut sender = None;
+        for attribute in tag.attributes() {
+            let attribute = attribute.ok()?;
+            let target = match attribute.key.as_ref() {
+                b"source" => &mut source,
+                b"from_name" => &mut sender,
+                _ => continue,
+            };
+            let value = attribute
+                .decoded_and_normalized_value(XmlVersion::Implicit1_0, reader.decoder())
+                .ok()?;
+            *target = Some(sanitize_user_text(value).into_owned());
+        }
+        let mut label = source.filter(|source| !source.trim().is_empty())?;
+        if let Some(sender) = sender.filter(|sender| !sender.trim().is_empty()) {
+            label.push_str(" · ");
+            label.push_str(sender.trim());
+        }
+        let text = sanitize_user_text(unescape(body).ok()?).into_owned();
+        Some((Self { label, text }, rest))
+    }
+}
+
+fn message_header(arrow: &'static str, label: &str, text: &str) -> Line<'static> {
+    let mut spans = vec![arrow.fg(accent_color()), " ".into(), label.to_owned().dim()];
+    if !text.is_empty() {
+        spans.extend(["  ".into(), text.to_owned().into()]);
+    }
+    Line::from(spans)
+}
+
+pub(super) fn channel_lines(
+    arrow: &'static str,
+    label: &str,
+    text: &str,
+    width: u16,
+) -> Vec<HyperlinkLine> {
+    if width == 0 {
+        return Vec::new();
+    }
+    let mut rows = text.split('\n');
+    let first = message_header(arrow, label, rows.next().unwrap_or_default());
+    let lines = std::iter::once(first)
+        .chain(rows.map(|row| Line::from(row.to_owned())))
+        .collect();
+    adaptive_wrap_hyperlink_lines(
+        &annotate_web_urls(lines),
+        RtOptions::new(usize::from(width))
+            .break_words(/*break_words*/ true)
+            .subsequent_indent("  ".into()),
+    )
+}
+
+#[cfg(test)]
+#[path = "channel_tests.rs"]
+mod tests;
