+#[tokio::test]
+async fn channel_messages_show_outgoing_text_and_delivery_result_with_expandable_details() {
+    let mut config = super::super::tests::test_config().await;
+    config.config_layer_stack = config
+        .config_layer_stack
+        .with_user_config(
+            &config.codex_home.join("config.toml"),
+            toml::from_str("[mcp_servers.events]\ncommand = \"events\"\nchannel = true")
+                .expect("parse channel config"),
+        )
+        .expect("set channel config");
+    let invocation = McpInvocation {
+        environment_id: None,
+        server: "events".to_owned(),
+        tool: "send".to_owned(),
+        arguments: Some(json!({"to": "opaque-target", "from": "opaque-sender", "text": "pong"})),
+    };
+    let ordinary = new_active_mcp_tool_call(
+        "id".to_owned(),
+        invocation.clone(),
+        /*animations_enabled*/ false,
+    );
+    assert!(
+        ordinary
+            .display_lines(/*width*/ 120)
+            .iter()
+            .any(|line| line.to_string().contains("opaque-target"))
+    );
+    let mut cell = new_active_mcp_tool_call(
+        "id".to_owned(),
+        invocation,
+        /*animations_enabled*/ false,
+    )
+    .with_channel_presentation(Some(&config));
+    assert_eq!(
+        cell.display_lines(/*width*/ 120)[0].to_string(),
+        "→ events · sending  pong",
+    );
+    cell.complete(
+        Duration::ZERO,
+        Ok(CallToolResult {
+            content: vec![json!({"type": "text", "text": "rejected"})],
+            structured_content: None,
+            is_error: None,
+            meta: None,
+        }),
+    );
+    let text = |lines: Vec<Line<'static>>| {
+        lines
+            .into_iter()
+            .map(|line| line.to_string())
+            .collect::<Vec<_>>()
+    };
+    let expected = ["→ events  pong", "  └ rejected"];
+    assert_eq!(text(cell.display_lines(/*width*/ 120)), expected);
+    assert_eq!(
+        text(visible_lines(cell.compact_hyperlink_lines(/*width*/ 120))),
+        expected,
+    );
+    assert!(cell.tool_call_labels().is_empty());
+    let details = text(cell.transcript_lines(/*width*/ 120)).join("\n");
+    assert!(details.contains("opaque-target"));
+    assert!(details.contains("opaque-sender"));
+}
