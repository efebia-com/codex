+#[test]
+fn config_toml_deserializes_status_line_style() {
+    use codex_config::types::StatusLineStyle;
+
+    for (source, expected) in [
+        ("[tui]", StatusLineStyle::Default),
+        (
+            "[tui]\nstatus_line_style = \"default\"",
+            StatusLineStyle::Default,
+        ),
+        (
+            "[tui]\nstatus_line_style = \"compact\"",
+            StatusLineStyle::Compact,
+        ),
+    ] {
+        let cfg: ConfigToml = toml::from_str(source).unwrap();
+        assert_eq!(cfg.tui.unwrap().status_line_style, expected);
+    }
+    assert!(toml::from_str::<ConfigToml>("[tui]\nstatus_line_style = \"unknown\"").is_err());
+}
