@@ -0,0 +1,220 @@
+//! Compact rendering for the configurable built-in status line.
+
+use chrono::DateTime;
+use chrono::TimeZone;
+use chrono::Utc;
+use ratatui::style::Color;
+use ratatui::style::Style;
+use ratatui::text::Span;
+
+use super::StatusLineItem;
+use crate::status::RateLimitWindowDisplay;
+use crate::status_line_file::StatusLineEntry;
+use crate::style::secondary_text_style;
+use crate::terminal_hyperlinks::HyperlinkLine;
+
+const GRAY: u8 = 246;
+const RED: u8 = 196;
+const ORANGE: u8 = 208;
+const YELLOW: u8 = 220;
+const GREEN: u8 = 71;
+const BLUE: u8 = 33;
+const VIOLET: u8 = 140;
+
+// This opt-in style uses a fixed 256-color terminal palette.
+#[allow(clippy::disallowed_methods)]
+pub(crate) fn compact_status_line_from_segments(
+    segments: impl IntoIterator<Item = (StatusLineEntry, String)>,
+    use_colors: bool,
+    pull_request_url: Option<&str>,
+) -> Option<HyperlinkLine> {
+    let style = |color| {
+        if use_colors {
+            Style::default().fg(Color::Indexed(color))
+        } else {
+            secondary_text_style()
+        }
+    };
+    let mut line = HyperlinkLine::default();
+    for (entry, mut text) in segments {
+        text.retain(|ch| !ch.is_control());
+        if !line.line.spans.is_empty() {
+            line.line.push_span(Span::styled(" │ ", style(GRAY)));
+        }
+        let color = match entry {
+            StatusLineEntry::File(_) => VIOLET,
+            StatusLineEntry::Builtin(item) => match item {
+                StatusLineItem::ModelWithReasoning => {
+                    if let Some((model, effort)) = text.rsplit_once('/') {
+                        line.line
+                            .push_span(Span::styled(model.to_owned(), style(RED)));
+                        line.line.push_span(Span::styled("/", style(GRAY)));
+                        line.line
+                            .push_span(Span::styled(effort.to_owned(), style(ORANGE)));
+                        continue;
+                    }
+                    RED
+                }
+                StatusLineItem::ModelName => RED,
+                StatusLineItem::Reasoning => ORANGE,
+                StatusLineItem::ContextRemaining | StatusLineItem::ContextUsed => YELLOW,
+                StatusLineItem::CurrentDir | StatusLineItem::ProjectRoot => GREEN,
+                StatusLineItem::SessionId => VIOLET,
+                StatusLineItem::FiveHourLimit | StatusLineItem::WeeklyLimit => {
+                    let label = if item == StatusLineItem::FiveHourLimit {
+                        "5h:"
+                    } else {
+                        "7d:"
+                    };
+                    line.line.push_span(Span::styled(label, style(GRAY)));
+                    BLUE
+                }
+                StatusLineItem::PullRequestNumber => {
+                    line.push_span(
+                        Span::styled(text, style(GRAY).underlined()),
+                        pull_request_url,
+                    );
+                    continue;
+                }
+                _ => GRAY,
+            },
+        };
+        line.line.push_span(Span::styled(text, style(color)));
+    }
+    (!line.line.spans.is_empty()).then_some(line)
+}
+
+pub(crate) fn compact_limit_value<Tz: TimeZone>(
+    window: Option<&RateLimitWindowDisplay>,
+    weekly: bool,
+    now: DateTime<Tz>,
+) -> String
+where
+    Tz::Offset: std::fmt::Display,
+{
+    let Some(window) = window.filter(|window| (0.0..=100.0).contains(&window.used_percent)) else {
+        return "?".to_string();
+    };
+    let remaining = 100.0 - window.used_percent;
+    let reset = window
+        .resets_at_unix
+        .and_then(|at| DateTime::<Utc>::from_timestamp(at, 0));
+    if weekly {
+        let duration = reset
+            .map(|at| compact_reset_duration(at.timestamp().saturating_sub(now.timestamp())))
+            .unwrap_or_else(|| "?".to_string());
+        format!("{remaining:.0}% ({duration})")
+    } else if remaining <= 30.0
+        && let Some(reset) = reset
+    {
+        format!(
+            "{remaining:.0}% (reset at {})",
+            reset.with_timezone(&now.timezone()).format("%H:%M")
+        )
+    } else {
+        format!("{remaining:.0}%")
+    }
+}
+
+fn compact_reset_duration(seconds: i64) -> String {
+    let days = seconds / 86_400;
+    let hours = seconds % 86_400 / 3_600;
+    let minutes = seconds % 3_600 / 60;
+    if days > 0 {
+        format!("{days}d{hours}h")
+    } else if hours > 0 {
+        format!("{hours}h{minutes}m")
+    } else if minutes > 0 {
+        format!("{minutes}m")
+    } else if seconds > 0 {
+        "<1m".to_string()
+    } else {
+        "now".to_string()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use chrono::FixedOffset;
+    use insta::assert_snapshot;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    #[allow(clippy::disallowed_methods)]
+    fn status_line_compact_palette_and_layout() {
+        let segments = [
+            (StatusLineItem::LastResponseTime.into(), "20:44:Sat"),
+            (
+                StatusLineItem::ModelWithReasoning.into(),
+                "Example Model/max",
+            ),
+            (StatusLineItem::ContextRemaining.into(), "86.0%"),
+            (StatusLineItem::CurrentDir.into(), "~/projects"),
+            (StatusLineItem::FiveHourLimit.into(), "30% (reset at 22:15)"),
+            (StatusLineItem::WeeklyLimit.into(), "63% (4d13h)"),
+            (StatusLineEntry::File("label".to_string()), "example"),
+            (
+                StatusLineEntry::File("aliases".to_string()),
+                "⚓ example-fixed",
+            ),
+            (
+                StatusLineItem::SessionId.into(),
+                "2f025ba0-1234-4321-8765-001122334455",
+            ),
+        ];
+        let line = compact_status_line_from_segments(
+            segments.map(|(item, text)| (item, text.to_string())),
+            /*use_colors*/ true,
+            /*pull_request_url*/ None,
+        )
+        .expect("a rendered line");
+        assert_snapshot!(line.line.to_string(), @"20:44:Sat │ Example Model/max │ 86.0% │ ~/projects │ 5h:30% (reset at 22:15) │ 7d:63% (4d13h) │ example │ ⚓ example-fixed │ 2f025ba0-1234-4321-8765-001122334455");
+        let colors: Vec<_> = line.line.spans.iter().map(|span| span.style.fg).collect();
+        assert_eq!(
+            colors,
+            [
+                246, 246, 196, 246, 208, 246, 220, 246, 71, 246, 246, 33, 246, 246, 33, 246, 140,
+                246, 140, 246, 140
+            ]
+            .map(|color| Some(Color::Indexed(color)))
+        );
+    }
+
+    #[test]
+    fn status_line_compact_limits_use_unrounded_threshold_and_local_clock() {
+        let timezone = FixedOffset::east_opt(3_600).expect("valid offset");
+        let now = timezone.with_ymd_and_hms(2026, 11, 21, 20, 44, 0).unwrap();
+        let mut window = RateLimitWindowDisplay {
+            used_percent: 69.9,
+            resets_at_unix: Some(now.timestamp() + 91 * 60),
+            resets_at: None,
+            window_minutes: Some(300),
+        };
+        assert_eq!(
+            compact_limit_value(Some(&window), /*weekly*/ false, now),
+            "30%"
+        );
+        window.used_percent = 70.0;
+        assert_eq!(
+            compact_limit_value(Some(&window), /*weekly*/ false, now),
+            "30% (reset at 22:15)"
+        );
+        window.used_percent = 37.0;
+        window.resets_at_unix = Some(now.timestamp() + (4 * 24 + 13) * 3_600);
+        assert_eq!(
+            compact_limit_value(Some(&window), /*weekly*/ true, now),
+            "63% (4d13h)"
+        );
+        window.resets_at_unix = None;
+        assert_eq!(
+            compact_limit_value(Some(&window), /*weekly*/ true, now),
+            "63% (?)"
+        );
+        window.used_percent = f64::NAN;
+        assert_eq!(
+            compact_limit_value(Some(&window), /*weekly*/ true, now),
+            "?"
+        );
+    }
+}
