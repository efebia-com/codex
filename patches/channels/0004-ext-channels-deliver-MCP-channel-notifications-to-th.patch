diff --git a/codex-rs/ext/channels/src/delivery.rs b/codex-rs/ext/channels/src/delivery.rs
new file mode 100644
index 0000000000..84c8b53ee8
--- /dev/null
+++ b/codex-rs/ext/channels/src/delivery.rs
@@ -0,0 +1,191 @@
+//! The per-thread queue between channel notifications and the model.
+
+use std::collections::VecDeque;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::sync::Weak;
+
+use codex_core::StartIfIdleSubmission;
+use codex_core::ThreadManager;
+use codex_core::TurnInput;
+use codex_core::TurnInputRequest;
+use codex_core::TurnStartOptions;
+use codex_extension_api::ExtensionFuture;
+use codex_mcp::ChannelNotification;
+use codex_protocol::ThreadId;
+use codex_protocol::user_input::UserInput;
+use tokio::sync::Notify;
+use tokio::sync::mpsc;
+use tokio::task::JoinHandle;
+use tracing::debug;
+use tracing::warn;
+
+use crate::CHANNEL_TURN_TRIGGER;
+use crate::render::Rejected;
+use crate::render::render;
+
+/// Notifications waiting for the model, per thread; a notification that finds the queue full is
+/// dropped.
+pub const MAX_PENDING: usize = 64;
+
+/// What became of an attempt to hand the waiting notifications to the model.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DeliveryOutcome {
+    /// The model has them all; the queue is emptied.
+    Delivered,
+    /// Nothing was handed over; they are tried again, with any newer ones, at the next wake.
+    Later,
+}
+
+/// How rendered notifications reach a thread, oldest first. This is the one place that decides:
+/// delivery into a running turn is a further branch of an implementation, not a change of the
+/// queue.
+pub trait Delivery: Send + Sync + 'static {
+    fn deliver<'a>(&'a self, notifications: &'a [String]) -> ExtensionFuture<'a, DeliveryOutcome>;
+}
+
+/// Starts a turn with the notifications when the thread is idle.
+pub(crate) struct ThreadDelivery {
+    thread_id: ThreadId,
+    thread_manager: Arc<OnceLock<Weak<ThreadManager>>>,
+}
+
+impl ThreadDelivery {
+    pub(crate) fn new(
+        thread_id: ThreadId,
+        thread_manager: Arc<OnceLock<Weak<ThreadManager>>>,
+    ) -> Self {
+        Self {
+            thread_id,
+            thread_manager,
+        }
+    }
+}
+
+impl Delivery for ThreadDelivery {
+    fn deliver<'a>(&'a self, notifications: &'a [String]) -> ExtensionFuture<'a, DeliveryOutcome> {
+        Box::pin(async move {
+            let Some(manager) = self.thread_manager.get().and_then(Weak::upgrade) else {
+                return DeliveryOutcome::Later;
+            };
+            let Ok(thread) = manager.get_thread(self.thread_id).await else {
+                debug!(thread_id = %self.thread_id, "MCP channel delivery waits for its thread");
+                return DeliveryOutcome::Later;
+            };
+            let input = TurnInput::UserInput {
+                content: notifications
+                    .iter()
+                    .map(|text| UserInput::Text {
+                        text: text.clone(),
+                        text_elements: Vec::new(),
+                    })
+                    .collect(),
+                client_id: None,
+            };
+            let request = TurnInputRequest::new(input).on_start(TurnStartOptions {
+                turn_trigger: Some(CHANNEL_TURN_TRIGGER.to_string()),
+                ..Default::default()
+            });
+            match thread.start_turn_if_idle(request).await {
+                Ok(StartIfIdleSubmission::Started { .. }) => DeliveryOutcome::Delivered,
+                Ok(StartIfIdleSubmission::NotSubmitted { reason }) => {
+                    debug!(thread_id = %self.thread_id, ?reason, "MCP channel delivery waits");
+                    DeliveryOutcome::Later
+                }
+                Err(error) => {
+                    warn!(thread_id = %self.thread_id, %error, "MCP channel delivery failed; it is retried later");
+                    DeliveryOutcome::Later
+                }
+            }
+        })
+    }
+}
+
+/// The task that queues a thread's notifications and delivers them; it ends when dropped.
+pub(crate) struct Worker {
+    wake: Arc<Notify>,
+    task: JoinHandle<()>,
+}
+
+impl Worker {
+    pub(crate) fn spawn(
+        notifications: mpsc::Receiver<ChannelNotification>,
+        delivery: Arc<dyn Delivery>,
+    ) -> Self {
+        let wake = Arc::new(Notify::new());
+        let task = tokio::spawn(run(notifications, Arc::clone(&wake), delivery));
+        Self { wake, task }
+    }
+
+    /// Tries the waiting notifications again.
+    pub(crate) fn wake(&self) {
+        self.wake.notify_one();
+    }
+}
+
+impl Drop for Worker {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+async fn run(
+    mut notifications: mpsc::Receiver<ChannelNotification>,
+    wake: Arc<Notify>,
+    delivery: Arc<dyn Delivery>,
+) {
+    let mut pending = Pending::default();
+    let mut open = true;
+    loop {
+        tokio::select! {
+            notification = notifications.recv(), if open => match notification {
+                Some(notification) => pending.push(&notification),
+                None => open = false,
+            },
+            () = wake.notified() => {}
+        }
+        if pending.0.is_empty() {
+            continue;
+        }
+        if delivery.deliver(pending.0.make_contiguous()).await == DeliveryOutcome::Delivered {
+            pending.0.clear();
+        }
+    }
+}
+
+/// Rendered notifications, oldest first.
+#[derive(Default)]
+struct Pending(VecDeque<String>);
+
+impl Pending {
+    fn push(&mut self, notification: &ChannelNotification) {
+        let server = &notification.server;
+        match render(notification) {
+            Ok(_) if self.0.len() >= MAX_PENDING => {
+                warn!(%server, "dropping MCP channel notification: {MAX_PENDING} are already waiting");
+            }
+            Ok(rendered) => self.0.push_back(rendered),
+            Err(Rejected::NoContent) => {
+                warn!(%server, "dropping MCP channel notification without a string content");
+            }
+            Err(Rejected::ContentTooLong(chars)) => {
+                warn!(%server, chars, "dropping MCP channel notification: its content is too long");
+            }
+        }
+    }
+}
+
+impl Drop for Pending {
+    fn drop(&mut self) {
+        if !self.0.is_empty() {
+            warn!(
+                count = self.0.len(),
+                "MCP channel notifications were not delivered before their thread stopped"
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "delivery_tests.rs"]
+mod tests;
diff --git a/codex-rs/ext/channels/src/delivery_tests.rs b/codex-rs/ext/channels/src/delivery_tests.rs
new file mode 100644
index 0000000000..f2ff8456e2
--- /dev/null
+++ b/codex-rs/ext/channels/src/delivery_tests.rs
@@ -0,0 +1,198 @@
+use std::collections::VecDeque;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+
+use codex_extension_api::ExtensionFuture;
+use codex_mcp::ChannelNotification;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio::sync::mpsc;
+use tokio::time::timeout;
+
+use super::Delivery;
+use super::DeliveryOutcome;
+use super::MAX_PENDING;
+use super::Worker;
+
+const WAIT: Duration = Duration::from_secs(5);
+
+/// Answers with scripted outcomes (then `Delivered`) and reports each attempt.
+struct ScriptedDelivery {
+    outcomes: Mutex<VecDeque<DeliveryOutcome>>,
+    attempts: mpsc::UnboundedSender<Vec<String>>,
+}
+
+impl Delivery for ScriptedDelivery {
+    fn deliver<'a>(&'a self, notifications: &'a [String]) -> ExtensionFuture<'a, DeliveryOutcome> {
+        Box::pin(async move {
+            self.attempts
+                .send(notifications.to_vec())
+                .expect("record attempt");
+            self.outcomes
+                .lock()
+                .expect("outcomes")
+                .pop_front()
+                .unwrap_or(DeliveryOutcome::Delivered)
+        })
+    }
+}
+
+struct Harness {
+    notifications: mpsc::Sender<ChannelNotification>,
+    attempts: mpsc::UnboundedReceiver<Vec<String>>,
+    worker: Worker,
+}
+
+fn harness(outcomes: Vec<DeliveryOutcome>) -> Harness {
+    let (notifications, receiver) = mpsc::channel(256);
+    let (attempts_sender, attempts) = mpsc::unbounded_channel();
+    let worker = Worker::spawn(
+        receiver,
+        Arc::new(ScriptedDelivery {
+            outcomes: Mutex::new(outcomes.into()),
+            attempts: attempts_sender,
+        }),
+    );
+    Harness {
+        notifications,
+        attempts,
+        worker,
+    }
+}
+
+fn event(content: &str) -> ChannelNotification {
+    ChannelNotification {
+        server: "srv".to_string(),
+        params: Some(json!({ "content": content })),
+    }
+}
+
+fn rendered(content: &str) -> String {
+    format!("<channel source=\"srv\">\n{content}\n</channel>")
+}
+
+impl Harness {
+    async fn send(&self, content: &str) {
+        self.notifications
+            .send(event(content))
+            .await
+            .expect("send notification");
+    }
+
+    async fn next_attempt(&mut self) -> Vec<String> {
+        timeout(WAIT, self.attempts.recv())
+            .await
+            .expect("an attempt in time")
+            .expect("attempts open")
+    }
+
+    async fn no_attempt(&mut self) {
+        assert!(
+            timeout(Duration::from_millis(200), self.attempts.recv())
+                .await
+                .is_err()
+        );
+    }
+}
+
+#[tokio::test]
+async fn idle_thread_gets_each_notification_at_once() {
+    let mut harness = harness(Vec::new());
+
+    harness.send("one").await;
+    assert_eq!(harness.next_attempt().await, vec![rendered("one")]);
+    harness.send("two").await;
+    assert_eq!(harness.next_attempt().await, vec![rendered("two")]);
+}
+
+#[tokio::test]
+async fn busy_thread_gets_the_waiting_notifications_together_and_in_order_when_woken() {
+    let mut harness = harness(vec![DeliveryOutcome::Later, DeliveryOutcome::Later]);
+
+    harness.send("one").await;
+    assert_eq!(harness.next_attempt().await, vec![rendered("one")]);
+    harness.send("two").await;
+    assert_eq!(
+        harness.next_attempt().await,
+        vec![rendered("one"), rendered("two")]
+    );
+    harness.no_attempt().await;
+
+    harness.worker.wake();
+    assert_eq!(
+        harness.next_attempt().await,
+        vec![rendered("one"), rendered("two")]
+    );
+    harness.send("three").await;
+    assert_eq!(harness.next_attempt().await, vec![rendered("three")]);
+}
+
+#[tokio::test]
+async fn wake_without_waiting_notifications_does_nothing() {
+    let mut harness = harness(Vec::new());
+
+    harness.worker.wake();
+    harness.no_attempt().await;
+}
+
+#[tokio::test]
+async fn rejected_notifications_never_reach_the_thread() {
+    let mut harness = harness(Vec::new());
+
+    harness
+        .notifications
+        .send(ChannelNotification {
+            server: "srv".to_string(),
+            params: Some(json!({ "meta": { "k": "v" } })),
+        })
+        .await
+        .expect("send notification");
+    harness.no_attempt().await;
+    harness.send("valid").await;
+    assert_eq!(harness.next_attempt().await, vec![rendered("valid")]);
+}
+
+#[tokio::test]
+async fn a_full_queue_drops_the_newest_notifications() {
+    let mut harness = harness(vec![DeliveryOutcome::Later; MAX_PENDING + 10]);
+
+    for n in 0..MAX_PENDING + 5 {
+        harness.send(&format!("event {n}")).await;
+    }
+    let mut last = Vec::new();
+    while let Ok(Some(attempt)) = timeout(Duration::from_millis(500), harness.attempts.recv()).await
+    {
+        last = attempt;
+    }
+    let expected: Vec<String> = (0..MAX_PENDING)
+        .map(|n| rendered(&format!("event {n}")))
+        .collect();
+    assert_eq!(last, expected);
+}
+
+#[tokio::test]
+async fn dropping_the_worker_stops_delivery() {
+    let mut harness = harness(Vec::new());
+    let Harness {
+        notifications,
+        attempts,
+        worker,
+    } = &mut harness;
+
+    drop(std::mem::replace(
+        worker,
+        Worker::spawn(mpsc::channel(1).1, Arc::new(NeverDelivery)),
+    ));
+    let _ = notifications.send(event("late")).await;
+    let next = timeout(Duration::from_millis(200), attempts.recv()).await;
+    assert!(!matches!(next, Ok(Some(_))), "{next:?}");
+}
+
+struct NeverDelivery;
+
+impl Delivery for NeverDelivery {
+    fn deliver<'a>(&'a self, _notifications: &'a [String]) -> ExtensionFuture<'a, DeliveryOutcome> {
+        Box::pin(async { DeliveryOutcome::Later })
+    }
+}
