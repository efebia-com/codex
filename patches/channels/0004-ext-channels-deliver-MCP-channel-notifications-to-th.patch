--- /dev/null
+++ b/codex-rs/ext/channels/src/lib.rs
@@ -0,0 +1,158 @@
+//! MCP channels: servers that push events into the chat.
+//!
+//! A server enabled with `mcp_servers.<name>.channel = true` that declares the `claude/channel`
+//! experimental capability can send `notifications/claude/channel` with
+//! `{content: string, meta?: {key: string}}`. Each one reaches the model of the main thread as
+//! `<channel source="<name>" key="value">content</channel>` (see [`render`]), the format Claude
+//! Code uses, so one server works with both clients.
+//!
+//! Delivery: an idle thread starts a turn for the notification at once. Notifications that
+//! arrive during a turn wait, in order, and start one turn together when the thread is next
+//! idle; after an interrupted turn they wait for the next notification or completed turn.
+//! Sub-agent and other non-root threads do not start channel servers at all, so a server never
+//! runs twice for one chat.
+
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::sync::Weak;
+
+use codex_core::ThreadManager;
+use codex_core::config::Config;
+use codex_extension_api::ExtensionFuture;
+use codex_extension_api::ExtensionRegistryBuilder;
+use codex_extension_api::McpServerContribution;
+use codex_extension_api::McpServerContributionContext;
+use codex_extension_api::McpServerContributor;
+use codex_extension_api::ThreadIdleCause;
+use codex_extension_api::ThreadIdleInput;
+use codex_extension_api::ThreadLifecycleContributor;
+use codex_extension_api::ThreadReadyInput;
+use codex_extension_api::ThreadStartInput;
+use codex_extension_api::ThreadStopInput;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::SessionSource;
+use tracing::warn;
+
+mod delivery;
+pub mod render;
+
+pub use delivery::Delivery;
+pub use delivery::DeliveryOutcome;
+pub use delivery::MAX_PENDING;
+use delivery::ThreadDelivery;
+use delivery::Worker;
+
+/// Recorded as the trigger of the turns that channel notifications start.
+pub const CHANNEL_TURN_TRIGGER: &str = "channel";
+
+/// Registers channel delivery for the threads of `thread_manager`.
+pub fn install(
+    builder: &mut ExtensionRegistryBuilder<Config>,
+    thread_manager: Weak<ThreadManager>,
+) {
+    let extension = Arc::new(ChannelsExtension::default());
+    extension.attach(thread_manager);
+    register(builder, extension);
+}
+
+/// Registers `extension`, for hosts that create the thread manager after the registry.
+pub fn register(builder: &mut ExtensionRegistryBuilder<Config>, extension: Arc<ChannelsExtension>) {
+    builder.mcp_server_contributor(extension.clone());
+    builder.thread_lifecycle_contributor(extension);
+}
+
+/// The extension; see the crate documentation.
+#[derive(Default)]
+pub struct ChannelsExtension {
+    thread_manager: Arc<OnceLock<Weak<ThreadManager>>>,
+}
+
+impl ChannelsExtension {
+    /// Sets the thread manager whose threads receive notifications; only the first call counts.
+    /// Until then, notifications wait.
+    pub fn attach(&self, thread_manager: Weak<ThreadManager>) {
+        let _ = self.thread_manager.set(thread_manager);
+    }
+}
+
+impl McpServerContributor<Config> for ChannelsExtension {
+    fn id(&self) -> &'static str {
+        "channels"
+    }
+
+    fn contribute<'a>(
+        &'a self,
+        context: McpServerContributionContext<'a, Config>,
+    ) -> ExtensionFuture<'a, Vec<McpServerContribution>> {
+        Box::pin(async move {
+            if !context
+                .session_source()
+                .is_some_and(SessionSource::is_non_root_agent)
+            {
+                return Vec::new();
+            }
+            codex_mcp::channel_servers(&context.config().config_layer_stack)
+                .into_iter()
+                .map(|name| McpServerContribution::Remove { name })
+                .collect()
+        })
+    }
+}
+
+impl ThreadLifecycleContributor<Config> for ChannelsExtension {
+    fn on_thread_start<'a>(
+        &'a self,
+        input: ThreadStartInput<'a, Config>,
+    ) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            if input.session_source.is_non_root_agent() {
+                return;
+            }
+            let Some(client) = input.mcp_resource_client.as_ref() else {
+                return;
+            };
+            let Some(notifications) = client.take_channel_notifications() else {
+                return;
+            };
+            let thread_id = match ThreadId::from_string(input.thread_store.level_id()) {
+                Ok(thread_id) => thread_id,
+                Err(error) => {
+                    warn!(%error, "MCP channels disabled: the thread has no valid id");
+                    return;
+                }
+            };
+            let delivery = ThreadDelivery::new(thread_id, Arc::clone(&self.thread_manager));
+            input
+                .thread_store
+                .insert(Worker::spawn(notifications, Arc::new(delivery)));
+        })
+    }
+
+    fn on_thread_ready<'a>(
+        &'a self,
+        input: ThreadReadyInput<'a, Config>,
+    ) -> ExtensionFuture<'a, ()> {
+        // Notifications that arrived before the thread was registered can go now.
+        Box::pin(async move { wake(input.thread_store) })
+    }
+
+    fn on_thread_idle<'a>(&'a self, input: ThreadIdleInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            if input.cause != ThreadIdleCause::Interrupted {
+                wake(input.thread_store);
+            }
+        })
+    }
+
+    fn on_thread_stop<'a>(&'a self, input: ThreadStopInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            input.thread_store.remove::<Worker>();
+        })
+    }
+}
+
+fn wake(thread_store: &codex_extension_api::ExtensionData) {
+    if let Some(worker) = thread_store.get::<Worker>() {
+        worker.wake();
+    }
+}
diff --git a/codex-rs/ext/channels/src/render.rs b/codex-rs/ext/channels/src/render.rs
new file mode 100644
index 0000000000..d64f949fa9
--- /dev/null
+++ b/codex-rs/ext/channels/src/render.rs
@@ -0,0 +1,83 @@
+//! The model-visible form of one channel notification.
+
+use std::collections::BTreeMap;
+
+use codex_mcp::ChannelNotification;
+use serde_json::Value;
+
+/// Longest `content`, in characters; a longer notification is dropped.
+pub const MAX_CONTENT_CHARS: usize = 100_000;
+/// Longest `meta` value, in characters; a longer value is dropped.
+pub const MAX_META_VALUE_CHARS: usize = 1_000;
+
+/// Why a notification cannot be shown to the model.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Rejected {
+    /// `params` is not an object with a string `content`.
+    NoContent,
+    /// `content` is longer than [`MAX_CONTENT_CHARS`].
+    ContentTooLong(usize),
+}
+
+/// `<channel source="<server>" key="value">\n<content>\n</channel>`.
+///
+/// `source` is the server's name; `meta` entries with an identifier key (ASCII letters, digits
+/// and `_`) and a string value become further attributes, sorted by key. `source` is never taken
+/// from `meta`. Content and values are escaped, so no text of the server can close the tag.
+pub fn render(notification: &ChannelNotification) -> Result<String, Rejected> {
+    let params = notification.params.as_ref().and_then(Value::as_object);
+    let content = params
+        .and_then(|params| params.get("content"))
+        .and_then(Value::as_str)
+        .ok_or(Rejected::NoContent)?;
+    let chars = content.chars().count();
+    if chars > MAX_CONTENT_CHARS {
+        return Err(Rejected::ContentTooLong(chars));
+    }
+    let meta: BTreeMap<&str, &str> = params
+        .and_then(|params| params.get("meta"))
+        .and_then(Value::as_object)
+        .into_iter()
+        .flatten()
+        .filter(|(key, _)| is_identifier(key) && key.as_str() != "source")
+        .filter_map(|(key, value)| Some((key.as_str(), value.as_str()?)))
+        .filter(|(_, value)| value.chars().count() <= MAX_META_VALUE_CHARS)
+        .collect();
+
+    let mut rendered = format!(
+        "<channel source=\"{}\"",
+        escape(&notification.server, /*attribute*/ true)
+    );
+    for (key, value) in meta {
+        rendered.push_str(&format!(" {key}=\"{}\"", escape(value, /*attribute*/ true)));
+    }
+    rendered.push_str(">\n");
+    rendered.push_str(&escape(content, /*attribute*/ false));
+    rendered.push_str("\n</channel>");
+    Ok(rendered)
+}
+
+fn is_identifier(key: &str) -> bool {
+    !key.is_empty()
+        && key
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_')
+}
+
+fn escape(text: &str, attribute: bool) -> String {
+    let mut escaped = String::with_capacity(text.len());
+    for character in text.chars() {
+        match character {
+            '&' => escaped.push_str("&amp;"),
+            '<' => escaped.push_str("&lt;"),
+            '>' => escaped.push_str("&gt;"),
+            '"' if attribute => escaped.push_str("&quot;"),
+            other => escaped.push(other),
+        }
+    }
+    escaped
+}
+
+#[cfg(test)]
+#[path = "render_tests.rs"]
+mod tests;
diff --git a/codex-rs/ext/channels/src/render_tests.rs b/codex-rs/ext/channels/src/render_tests.rs
