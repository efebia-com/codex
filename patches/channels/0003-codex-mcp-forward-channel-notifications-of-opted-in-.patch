+    /// The thread's channel hub when the current config enables channels for `server`.
+    pub(crate) fn channel_hub_for(
+        &self,
+        server: &McpServerKey,
+    ) -> Option<crate::channel::ChannelHub> {
+        let enabled = server.scoped_environment_id().is_none()
+            && self
+                .authority
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
