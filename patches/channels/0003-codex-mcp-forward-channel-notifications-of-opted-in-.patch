@@ -0,0 +1,174 @@
+//! Opt-in delivery of a server's `notifications/claude/channel` notifications to its thread.
+//!
+//! A server takes part when the layered config sets `mcp_servers.<name>.channel = true`. Codex
+//! then declares the `claude/channel` experimental capability in its own `initialize` to that
+//! server, and once the server declares it too over a session with an `initialize` handshake,
+//! forwards each notification with the server's name to the thread's [`ChannelHub`]. Whoever
+//! takes the hub's receiver decides how notifications reach the model. Queues are bounded: a
+//! notification that finds one full is dropped.
+
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+
+use codex_config::ConfigLayerStack;
+use codex_config::TomlValue;
+use codex_rmcp_client::RmcpClient;
+use rmcp::model::CustomNotification;
+use rmcp::model::InitializeRequestParams;
+use rmcp::model::ServerCapabilities;
+use rmcp::model::ServerPeerInfo;
+use serde_json::Value;
+use tokio::sync::mpsc;
+use tokio::sync::mpsc::error::TrySendError;
+use tracing::info;
+use tracing::warn;
+
+/// Experimental capability declared by both sides of a channel.
+pub const CHANNEL_CAPABILITY: &str = "claude/channel";
+/// Notification a channel server sends for each event.
+pub const CHANNEL_NOTIFICATION_METHOD: &str = "notifications/claude/channel";
+/// Notifications held per server, and per thread, before new ones are dropped.
+pub const CHANNEL_QUEUE_CAPACITY: usize = 64;
+
+/// One channel notification, as the server sent it.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChannelNotification {
+    /// Name of the server in the MCP configuration.
+    pub server: String,
+    /// The notification's `params`, unvalidated.
+    pub params: Option<Value>,
+}
+
+/// Whether the layered config enables channel delivery for `server`.
+pub fn channel_enabled(config_layer_stack: &ConfigLayerStack, server: &str) -> bool {
+    config_layer_stack
+        .effective_config()
+        .get("mcp_servers")
+        .and_then(|servers| servers.get(server))
+        .and_then(|server| server.get("channel"))
+        .and_then(TomlValue::as_bool)
+        .unwrap_or(false)
+}
+
+/// Names of the servers for which the layered config enables channel delivery, sorted.
+pub fn channel_servers(config_layer_stack: &ConfigLayerStack) -> Vec<String> {
+    let config = config_layer_stack.effective_config();
+    let Some(servers) = config.get("mcp_servers").and_then(TomlValue::as_table) else {
+        return Vec::new();
+    };
+    let mut names: Vec<String> = servers
+        .iter()
+        .filter(|(_, server)| {
+            server
+                .get("channel")
+                .and_then(TomlValue::as_bool)
+                .unwrap_or(false)
+        })
+        .map(|(name, _)| name.clone())
+        .collect();
+    names.sort();
+    names
+}
+
+/// The channel notifications of one thread, from all of its servers, in arrival order.
+#[derive(Clone)]
+pub(crate) struct ChannelHub {
+    sender: mpsc::Sender<ChannelNotification>,
+    receiver: Arc<Mutex<Option<mpsc::Receiver<ChannelNotification>>>>,
+}
+
+impl Default for ChannelHub {
+    fn default() -> Self {
+        let (sender, receiver) = mpsc::channel(CHANNEL_QUEUE_CAPACITY);
+        Self {
+            sender,
+            receiver: Arc::new(Mutex::new(Some(receiver))),
+        }
+    }
+}
+
+impl ChannelHub {
+    /// The receiver, to the first caller only.
+    pub(crate) fn take_receiver(&self) -> Option<mpsc::Receiver<ChannelNotification>> {
+        self.receiver
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .take()
+    }
+}
+
+/// A server's notifications, subscribed before `initialize`, waiting for its capabilities.
+pub(crate) struct ChannelSubscription {
+    hub: ChannelHub,
+    notifications: mpsc::Receiver<CustomNotification>,
+}
+
+impl ChannelSubscription {
+    /// Declares the capability in `params` and subscribes, when `hub` is given.
+    pub(crate) fn prepare(
+        hub: Option<ChannelHub>,
+        client: &RmcpClient,
+        params: &mut InitializeRequestParams,
+    ) -> Option<Self> {
+        let hub = hub?;
+        params
+            .capabilities
+            .experimental
+            .get_or_insert_default()
+            .insert(CHANNEL_CAPABILITY.to_string(), Default::default());
+        let notifications = client
+            .subscribe_custom_notifications(CHANNEL_NOTIFICATION_METHOD, CHANNEL_QUEUE_CAPACITY);
+        Some(Self { hub, notifications })
+    }
+
+    /// Forwards the server's notifications to the hub until its connection ends, if the
+    /// server declared the capability over a session with an `initialize` handshake.
+    pub(crate) fn connect(self, server: String, initialize_result: &ServerPeerInfo) {
+        if !initialize_result.protocol_version.has_initialize() {
+            info!(
+                server = %server,
+                "MCP channel disabled: the server uses a protocol version without sessions"
+            );
+            return;
+        }
+        if !declares_channel(&initialize_result.capabilities) {
+            info!(
+                server = %server,
+                "MCP channel disabled: the server does not declare {CHANNEL_CAPABILITY}"
+            );
+            return;
+        }
+        let Self {
+            hub,
+            mut notifications,
+        } = self;
+        tokio::spawn(async move {
+            while let Some(notification) = notifications.recv().await {
+                let notification = ChannelNotification {
+                    server: server.clone(),
+                    params: notification.params,
+                };
+                match hub.sender.try_send(notification) {
+                    Ok(()) => {}
+                    Err(TrySendError::Full(_)) => warn!(
+                        server = %server,
+                        "dropping MCP channel notification: the thread's queue is full"
+                    ),
+                    Err(TrySendError::Closed(_)) => return,
+                }
+            }
+        });
+    }
+}
+
+fn declares_channel(capabilities: &ServerCapabilities) -> bool {
+    capabilities
+        .experimental
+        .as_ref()
+        .is_some_and(|experimental| experimental.contains_key(CHANNEL_CAPABILITY))
+}
+
+#[cfg(test)]
+#[path = "channel_tests.rs"]
+mod tests;
