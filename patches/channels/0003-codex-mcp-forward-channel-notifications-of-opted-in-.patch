@@ -0,0 +1,212 @@
+use std::sync::Arc;
+use std::time::Duration;
+
+use codex_config::ConfigLayerEntry;
+use codex_config::ConfigLayerSource;
+use codex_config::ConfigLayerStack;
+use codex_config::TomlValue;
+use codex_rmcp_client::InProcessTransportFactory;
+use futures::FutureExt;
+use futures::future::BoxFuture;
+use pretty_assertions::assert_eq;
+use rmcp::ServiceExt;
+use rmcp::model::ClientCapabilities;
+use rmcp::model::Implementation;
+use rmcp::model::ServerNotification;
+use serde_json::json;
+use tokio::sync::mpsc;
+use tokio::time::timeout;
+
+use super::*;
+
+const WAIT: Duration = Duration::from_secs(5);
+
+fn stack(layers: Vec<serde_json::Value>) -> ConfigLayerStack {
+    let layers = layers
+        .into_iter()
+        .map(|layer| {
+            let config: TomlValue = serde_json::from_value(layer).expect("TOML layer");
+            ConfigLayerEntry::new(ConfigLayerSource::SessionFlags, config)
+        })
+        .collect();
+    ConfigLayerStack::new(layers, Default::default(), Default::default()).expect("layer stack")
+}
+
+#[test]
+fn channel_is_enabled_only_by_an_explicit_true() {
+    let stack = stack(vec![json!({
+        "mcp_servers": {
+            "on": { "command": "server", "channel": true },
+            "off": { "command": "server", "channel": false },
+            "unset": { "command": "server" },
+            "wrong.type": { "command": "server", "channel": "true" },
+        }
+    })]);
+
+    assert!(channel_enabled(&stack, "on"));
+    assert!(!channel_enabled(&stack, "off"));
+    assert!(!channel_enabled(&stack, "unset"));
+    assert!(!channel_enabled(&stack, "wrong.type"));
+    assert!(!channel_enabled(&stack, "missing"));
+    assert_eq!(channel_servers(&stack), vec!["on".to_string()]);
+}
+
+#[test]
+fn a_later_layer_overrides_the_channel_setting() {
+    let stack = stack(vec![
+        json!({ "mcp_servers": { "srv": { "command": "server" } } }),
+        json!({ "mcp_servers": { "srv": { "channel": true } } }),
+    ]);
+
+    assert!(channel_enabled(&stack, "srv"));
+}
+
+#[derive(Clone)]
+struct ChannelServer {
+    declares_channel: bool,
+    client_capabilities: mpsc::Sender<serde_json::Value>,
+}
+
+impl rmcp::ServerHandler for ChannelServer {
+    fn get_info(&self) -> rmcp::model::ServerConfig {
+        let mut capabilities = rmcp::model::ServerCapabilities::default();
+        if self.declares_channel {
+            capabilities.experimental =
+                Some([(CHANNEL_CAPABILITY.to_string(), Default::default())].into());
+        }
+        rmcp::model::ServerConfig::new(capabilities)
+    }
+
+    async fn on_initialized(&self, context: rmcp::service::NotificationContext<rmcp::RoleServer>) {
+        let capabilities = context
+            .peer
+            .peer_info()
+            .map(|info| json!(info.capabilities))
+            .unwrap_or_default();
+        self.client_capabilities
+            .send(capabilities)
+            .await
+            .expect("record client capabilities");
+        for n in [1, 2] {
+            context
+                .peer
+                .send_notification(ServerNotification::CustomNotification(
+                    CustomNotification::new(
+                        CHANNEL_NOTIFICATION_METHOD,
+                        Some(json!({ "content": format!("event {n}") })),
+                    ),
+                ))
+                .await
+                .expect("send channel notification");
+        }
+    }
+}
+
+impl InProcessTransportFactory for ChannelServer {
+    fn open(&self) -> BoxFuture<'static, std::io::Result<tokio::io::DuplexStream>> {
+        let server = self.clone();
+        async move {
+            let (client, transport) = tokio::io::duplex(/*max_buf_size*/ 4096);
+            tokio::spawn(async move {
+                let service = server.serve(transport).await.expect("serve");
+                let _ = service.waiting().await;
+            });
+            Ok(client)
+        }
+        .boxed()
+    }
+}
+
+/// Starts a client to a server that sends two channel notifications once initialized, and
+/// returns the client capabilities the server saw and the hub's receiver.
+async fn run(
+    declares_channel: bool,
+    hub: Option<ChannelHub>,
+) -> anyhow::Result<(
+    serde_json::Value,
+    Option<mpsc::Receiver<ChannelNotification>>,
+    Arc<RmcpClient>,
+)> {
+    let (sender, mut client_capabilities) = mpsc::channel(1);
+    let client = Arc::new(
+        RmcpClient::new_in_process_client(Arc::new(ChannelServer {
+            declares_channel,
+            client_capabilities: sender,
+        }))
+        .await?,
+    );
+    let receiver = hub.as_ref().and_then(ChannelHub::take_receiver);
+    let mut params = InitializeRequestParams::new(
+        ClientCapabilities::default(),
+        Implementation::new("test", "1"),
+    );
+    let channel = ChannelSubscription::prepare(hub, &client, &mut params);
+    let initialize_result = client
+        .initialize(
+            params,
+            Some(WAIT),
+            Box::new(|_, _| async { anyhow::bail!("unexpected elicitation") }.boxed()),
+        )
+        .await?;
+    if let Some(channel) = channel {
+        channel.connect("srv".to_string(), &initialize_result);
+    }
+    let seen = timeout(WAIT, client_capabilities.recv())
+        .await?
+        .expect("client capabilities");
+    Ok((seen, receiver, client))
+}
+
+#[tokio::test]
+async fn enabled_channel_declares_the_capability_and_forwards_in_order() -> anyhow::Result<()> {
+    let (seen, receiver, client) =
+        run(/*declares_channel*/ true, Some(ChannelHub::default())).await?;
+    let mut receiver = receiver.expect("hub receiver");
+
+    assert_eq!(seen["experimental"][CHANNEL_CAPABILITY], json!({}));
+    for n in [1, 2] {
+        let notification = timeout(WAIT, receiver.recv()).await?.expect("notification");
+        assert_eq!(
+            notification,
+            ChannelNotification {
+                server: "srv".to_string(),
+                params: Some(json!({ "content": format!("event {n}") })),
+            }
+        );
+    }
+    client.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn server_without_the_capability_is_not_forwarded() -> anyhow::Result<()> {
+    let (seen, receiver, client) =
+        run(/*declares_channel*/ false, Some(ChannelHub::default())).await?;
+    let mut receiver = receiver.expect("hub receiver");
+
+    assert_eq!(seen["experimental"][CHANNEL_CAPABILITY], json!({}));
+    let next = timeout(Duration::from_millis(300), receiver.recv()).await;
+    assert!(!matches!(next, Ok(Some(_))), "{next:?}");
+    client.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn disabled_channel_leaves_initialize_unchanged() -> anyhow::Result<()> {
+    let (seen, receiver, client) = run(/*declares_channel*/ true, /*hub*/ None).await?;
+
+    assert!(receiver.is_none());
+    assert_eq!(seen.get("experimental"), None);
+    client.shutdown().await;
+    Ok(())
+}
+
+#[test]
+fn hub_receiver_is_taken_once() {
+    let hub = ChannelHub::default();
+    let [first, second] = [hub.clone(), hub];
+
+    assert!(first.take_receiver().is_some());
+    assert!(second.take_receiver().is_none());
+    assert!(first.take_receiver().is_none());
+}
