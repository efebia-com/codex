+//! Delivers selected custom server notifications, which the client handler ignores, to
+//! subscribers.
+//!
+//! The SDK handles each server notification in a task of its own, so notifications sent back to
+//! back can reach the handler in any order. Subscribed notifications are therefore taken from the
+//! transport, in the order the server sent them, before the SDK dispatches anything.
+
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+
+use rmcp::model::CustomNotification;
+use rmcp::model::JsonRpcMessage;
+use rmcp::model::ServerNotification;
+use rmcp::service::RoleClient;
+use rmcp::service::RxJsonRpcMessage;
+use rmcp::service::TxJsonRpcMessage;
+use rmcp::transport::IntoTransport;
+use rmcp::transport::Transport;
+use tokio::sync::mpsc;
+use tokio::sync::mpsc::error::TrySendError;
+use tracing::debug;
+use tracing::warn;
+
+/// One subscriber: the notification method it takes and where those notifications go.
+type Tap = (String, mpsc::Sender<CustomNotification>);
+
+/// Subscribers by notification method. Clones share one set, so a subscription made before
+/// `initialize` also covers every later connection of the same client.
+#[derive(Clone, Default)]
+pub(crate) struct CustomNotificationTaps {
+    taps: Arc<Mutex<Vec<Tap>>>,
+}
+
+impl CustomNotificationTaps {
+    /// Replaces any earlier subscriber for `method`.
+    pub(crate) fn subscribe(
+        &self,
+        method: String,
+        capacity: usize,
+    ) -> mpsc::Receiver<CustomNotification> {
+        let (sender, receiver) = mpsc::channel(capacity.max(1));
+        let mut taps = self.taps.lock().unwrap_or_else(PoisonError::into_inner);
+        taps.retain(|(subscribed, _)| *subscribed != method);
+        taps.push((method, sender));
+        receiver
+    }
+
+    /// Wraps `transport` so that subscribed notifications go to their subscribers as they are
+    /// received, and never reach the SDK. Every other message passes through unchanged.
+    pub(crate) fn capture<T, E, A>(
+        &self,
+        transport: T,
+    ) -> impl Transport<RoleClient, Error = E> + 'static
+    where
+        T: IntoTransport<RoleClient, E, A>,
+        E: std::error::Error + Send + Sync + 'static,
+    {
+        CustomNotificationTransport {
+            inner: transport.into_transport(),
+            taps: self.clone(),
+        }
+    }
+
+    /// Whether `notification` has a subscriber. Such a notification is consumed; when the
+    /// subscriber's queue is full it is dropped.
+    pub(crate) fn offer(&self, notification: &CustomNotification) -> bool {
+        let taps = self.taps.lock().unwrap_or_else(PoisonError::into_inner);
+        let Some((_, sender)) = taps
+            .iter()
+            .find(|(method, _)| *method == notification.method)
+        else {
+            return false;
+        };
+        match sender.try_send(notification.clone()) {
+            Ok(()) => {}
+            Err(TrySendError::Full(_)) => warn!(
+                method = %notification.method,
+                "dropping MCP server notification: its subscriber is not keeping up"
+            ),
+            Err(TrySendError::Closed(_)) => debug!(
+                method = %notification.method,
+                "dropping MCP server notification: its subscriber is gone"
+            ),
+        }
+        true
+    }
+}
+
+struct CustomNotificationTransport<T> {
+    inner: T,
+    taps: CustomNotificationTaps,
+}
+
+impl<T: Transport<RoleClient> + 'static> Transport<RoleClient> for CustomNotificationTransport<T> {
+    type Error = T::Error;
+
+    fn send(
+        &mut self,
+        message: TxJsonRpcMessage<RoleClient>,
+    ) -> impl Future<Output = Result<(), Self::Error>> + Send + 'static {
+        self.inner.send(message)
+    }
+
+    async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+        loop {
+            let message = self.inner.receive().await?;
+            if let JsonRpcMessage::Notification(envelope) = &message
+                && let ServerNotification::CustomNotification(notification) = &envelope.notification
+                && self.taps.offer(notification)
+            {
+                continue;
+            }
+            return Some(message);
+        }
+    }
+
+    fn close(&mut self) -> impl Future<Output = Result<(), Self::Error>> + Send {
+        self.inner.close()
+    }
+}
+
+#[cfg(test)]
+#[path = "custom_notifications_tests.rs"]
+mod tests;
diff --git a/codex-rs/rmcp-client/src/custom_notifications_tests.rs b/codex-rs/rmcp-client/src/custom_notifications_tests.rs
new file mode 100644
