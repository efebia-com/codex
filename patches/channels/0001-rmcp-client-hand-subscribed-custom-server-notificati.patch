@@ -0,0 +1,65 @@
+//! Delivers selected custom server notifications, which the client handler ignores, to
+//! subscribers.
+
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+
+use rmcp::model::CustomNotification;
+use tokio::sync::mpsc;
+use tokio::sync::mpsc::error::TrySendError;
+use tracing::debug;
+use tracing::warn;
+
+/// One subscriber: the notification method it takes and where those notifications go.
+type Tap = (String, mpsc::Sender<CustomNotification>);
+
+/// Subscribers by notification method. Clones share one set, so a subscription made before
+/// `initialize` also covers every later connection of the same client.
+#[derive(Clone, Default)]
+pub(crate) struct CustomNotificationTaps {
+    taps: Arc<Mutex<Vec<Tap>>>,
+}
+
+impl CustomNotificationTaps {
+    /// Replaces any earlier subscriber for `method`.
+    pub(crate) fn subscribe(
+        &self,
+        method: String,
+        capacity: usize,
+    ) -> mpsc::Receiver<CustomNotification> {
+        let (sender, receiver) = mpsc::channel(capacity.max(1));
+        let mut taps = self.taps.lock().unwrap_or_else(PoisonError::into_inner);
+        taps.retain(|(subscribed, _)| *subscribed != method);
+        taps.push((method, sender));
+        receiver
+    }
+
+    /// Whether `notification` has a subscriber. Such a notification never reaches the
+    /// handler; when the subscriber's queue is full it is dropped.
+    pub(crate) fn offer(&self, notification: &CustomNotification) -> bool {
+        let taps = self.taps.lock().unwrap_or_else(PoisonError::into_inner);
+        let Some((_, sender)) = taps
+            .iter()
+            .find(|(method, _)| *method == notification.method)
+        else {
+            return false;
+        };
+        match sender.try_send(notification.clone()) {
+            Ok(()) => {}
+            Err(TrySendError::Full(_)) => warn!(
+                method = %notification.method,
+                "dropping MCP server notification: its subscriber is not keeping up"
+            ),
+            Err(TrySendError::Closed(_)) => debug!(
+                method = %notification.method,
+                "dropping MCP server notification: its subscriber is gone"
+            ),
+        }
+        true
+    }
+}
+
+#[cfg(test)]
+#[path = "custom_notifications_tests.rs"]
+mod tests;
diff --git a/codex-rs/rmcp-client/src/custom_notifications_tests.rs b/codex-rs/rmcp-client/src/custom_notifications_tests.rs
new file mode 100644
index 0000000000..856370ffe5
--- /dev/null
+++ b/codex-rs/rmcp-client/src/custom_notifications_tests.rs
@@ -0,0 +1,140 @@
+use pretty_assertions::assert_eq;
+use rmcp::model::CustomNotification;
+use serde_json::json;
+
+use super::CustomNotificationTaps;
+
+fn notification(method: &str, n: u64) -> CustomNotification {
+    CustomNotification::new(method, Some(json!({ "n": n })))
+}
+
+#[tokio::test]
+async fn subscribed_method_is_delivered_in_order_and_others_pass_through() {
+    let taps = CustomNotificationTaps::default();
+    let mut receiver = taps.subscribe("notifications/example/event".to_string(), 4);
+
+    assert!(taps.offer(&notification("notifications/example/event", 1)));
+    assert!(taps.offer(&notification("notifications/example/event", 2)));
+    assert!(!taps.offer(&notification("notifications/other", 3)));
+
+    let first = receiver.recv().await.expect("first notification");
+    let second = receiver.recv().await.expect("second notification");
+    assert_eq!(first.params, Some(json!({ "n": 1 })));
+    assert_eq!(second.params, Some(json!({ "n": 2 })));
+    assert!(receiver.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn full_queue_drops_new_notifications_but_still_claims_them() {
+    let taps = CustomNotificationTaps::default();
+    let mut receiver = taps.subscribe("notifications/example/event".to_string(), 1);
+
+    assert!(taps.offer(&notification("notifications/example/event", 1)));
+    assert!(taps.offer(&notification("notifications/example/event", 2)));
+
+    let kept = receiver.recv().await.expect("kept notification");
+    assert_eq!(kept.params, Some(json!({ "n": 1 })));
+    assert!(receiver.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn closed_subscriber_still_claims_its_method() {
+    let taps = CustomNotificationTaps::default();
+    drop(taps.subscribe("notifications/example/event".to_string(), 1));
+
+    assert!(taps.offer(&notification("notifications/example/event", 1)));
+}
+
+#[tokio::test]
+async fn later_subscription_replaces_the_earlier_one() {
+    let taps = CustomNotificationTaps::default();
+    let mut first = taps.subscribe("notifications/example/event".to_string(), 1);
+    let mut second = taps
+        .clone()
+        .subscribe("notifications/example/event".to_string(), 1);
+
+    assert!(taps.offer(&notification("notifications/example/event", 1)));
+
+    assert!(first.recv().await.is_none());
+    let delivered = second.recv().await.expect("replacement subscriber");
+    assert_eq!(delivered.params, Some(json!({ "n": 1 })));
+}
+
+#[derive(Clone)]
+struct NotifyingServer;
+
+impl rmcp::ServerHandler for NotifyingServer {
+    async fn on_initialized(&self, context: rmcp::service::NotificationContext<rmcp::RoleServer>) {
+        for (method, n) in [
+            ("notifications/example/event", 1),
+            ("notifications/other", 2),
+            ("notifications/example/event", 3),
+        ] {
+            context
+                .peer
+                .send_notification(rmcp::model::ServerNotification::CustomNotification(
+                    notification(method, n),
+                ))
+                .await
+                .expect("send notification");
+        }
+    }
+}
+
+impl crate::InProcessTransportFactory for NotifyingServer {
+    fn open(
+        &self,
+    ) -> futures::future::BoxFuture<'static, std::io::Result<tokio::io::DuplexStream>> {
+        use futures::FutureExt;
+        use rmcp::ServiceExt;
+
+        let server = self.clone();
+        async move {
+            let (client, transport) = tokio::io::duplex(/*max_buf_size*/ 4096);
+            tokio::spawn(async move {
+                let service = server.serve(transport).await.expect("serve");
+                let _ = service.waiting().await;
+            });
+            Ok(client)
+        }
+        .boxed()
+    }
+}
+
+#[tokio::test]
+async fn client_hands_subscribed_server_notifications_to_the_subscriber() -> anyhow::Result<()> {
+    use futures::FutureExt;
+    use rmcp::model::ClientCapabilities;
+    use rmcp::model::Implementation;
+    use rmcp::model::InitializeRequestParams;
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    let client = crate::RmcpClient::new_in_process_client(Arc::new(NotifyingServer)).await?;
+    let mut receiver = client.subscribe_custom_notifications("notifications/example/event", 8);
+    client
+        .initialize(
+            InitializeRequestParams::new(
+                ClientCapabilities::default(),
+                Implementation::new("test", "1"),
+            ),
+            Some(Duration::from_secs(5)),
+            Box::new(|_, _| async { anyhow::bail!("unexpected elicitation") }.boxed()),
+        )
+        .await?;
+
+    let mut delivered = Vec::new();
+    for _ in 0..2 {
+        let notification = tokio::time::timeout(Duration::from_secs(5), receiver.recv())
+            .await?
+            .expect("subscribed notification");
+        delivered.push(notification.params);
+    }
+    assert_eq!(
+        delivered,
+        vec![Some(json!({ "n": 1 })), Some(json!({ "n": 3 }))]
+    );
+    assert!(receiver.try_recv().is_err());
+    client.shutdown().await;
+    Ok(())
+}
