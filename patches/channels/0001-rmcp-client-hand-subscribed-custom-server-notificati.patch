@@ -0,0 +1,240 @@
+use std::collections::VecDeque;
+use std::future::Future;
+
+use pretty_assertions::assert_eq;
+use rmcp::model::CustomNotification;
+use rmcp::model::JsonRpcMessage;
+use rmcp::model::ServerNotification;
+use rmcp::service::RoleClient;
+use rmcp::service::RxJsonRpcMessage;
+use rmcp::service::TxJsonRpcMessage;
+use rmcp::transport::Transport;
+use serde_json::Value;
+use serde_json::json;
+
+use super::CustomNotificationTaps;
+
+const EVENT: &str = "notifications/example/event";
+const OTHER: &str = "notifications/other";
+
+fn notification(method: &str, n: u64) -> CustomNotification {
+    CustomNotification::new(method, Some(json!({ "n": n })))
+}
+
+/// A transport that receives the given custom notifications, then ends.
+struct Scripted(VecDeque<CustomNotification>);
+
+impl Transport<RoleClient> for Scripted {
+    type Error = std::io::Error;
+
+    fn send(
+        &mut self,
+        _message: TxJsonRpcMessage<RoleClient>,
+    ) -> impl Future<Output = Result<(), Self::Error>> + Send + 'static {
+        std::future::ready(Ok(()))
+    }
+
+    async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+        self.0.pop_front().map(|notification| {
+            JsonRpcMessage::notification(ServerNotification::CustomNotification(notification))
+        })
+    }
+
+    async fn close(&mut self) -> Result<(), Self::Error> {
+        Ok(())
+    }
+}
+
+/// The params of a custom notification message.
+fn custom_params(message: RxJsonRpcMessage<RoleClient>) -> Option<Value> {
+    let JsonRpcMessage::Notification(envelope) = message else {
+        return None;
+    };
+    let ServerNotification::CustomNotification(notification) = envelope.notification else {
+        return None;
+    };
+    notification.params
+}
+
+#[tokio::test]
+async fn capture_takes_subscribed_notifications_in_transport_order() {
+    let taps = CustomNotificationTaps::default();
+    let mut receiver = taps.subscribe(EVENT.to_string(), 8);
+    let mut transport = taps.capture(Scripted(VecDeque::from([
+        notification(EVENT, 1),
+        notification(OTHER, 2),
+        notification(EVENT, 3),
+        notification(EVENT, 4),
+    ])));
+
+    let passed = transport.receive().await.and_then(custom_params);
+    assert_eq!(passed, Some(json!({ "n": 2 })));
+    assert!(transport.receive().await.is_none());
+
+    let mut delivered = Vec::new();
+    while let Ok(notification) = receiver.try_recv() {
+        delivered.push(notification.params);
+    }
+    assert_eq!(
+        delivered,
+        vec![
+            Some(json!({ "n": 1 })),
+            Some(json!({ "n": 3 })),
+            Some(json!({ "n": 4 })),
+        ]
+    );
+}
+
+#[tokio::test]
+async fn subscribed_method_is_delivered_in_order_and_others_pass_through() {
+    let taps = CustomNotificationTaps::default();
+    let mut receiver = taps.subscribe(EVENT.to_string(), 4);
+
+    assert!(taps.offer(&notification(EVENT, 1)));
+    assert!(taps.offer(&notification(EVENT, 2)));
+    assert!(!taps.offer(&notification(OTHER, 3)));
+
+    let first = receiver.recv().await.expect("first notification");
+    let second = receiver.recv().await.expect("second notification");
+    assert_eq!(first.params, Some(json!({ "n": 1 })));
+    assert_eq!(second.params, Some(json!({ "n": 2 })));
+    assert!(receiver.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn full_queue_drops_new_notifications_but_still_claims_them() {
+    let taps = CustomNotificationTaps::default();
+    let mut receiver = taps.subscribe(EVENT.to_string(), 1);
+
+    assert!(taps.offer(&notification(EVENT, 1)));
+    assert!(taps.offer(&notification(EVENT, 2)));
+
+    let kept = receiver.recv().await.expect("kept notification");
+    assert_eq!(kept.params, Some(json!({ "n": 1 })));
+    assert!(receiver.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn closed_subscriber_still_claims_its_method() {
+    let taps = CustomNotificationTaps::default();
+    drop(taps.subscribe(EVENT.to_string(), 1));
+
+    assert!(taps.offer(&notification(EVENT, 1)));
+}
+
+#[tokio::test]
+async fn later_subscription_replaces_the_earlier_one() {
+    let taps = CustomNotificationTaps::default();
+    let mut first = taps.subscribe(EVENT.to_string(), 1);
+    let mut second = taps.clone().subscribe(EVENT.to_string(), 1);
+
+    assert!(taps.offer(&notification(EVENT, 1)));
+
+    assert!(first.recv().await.is_none());
+    let delivered = second.recv().await.expect("replacement subscriber");
+    assert_eq!(delivered.params, Some(json!({ "n": 1 })));
+}
+
+/// Sends `notifications` back to back once the client is initialized.
+#[derive(Clone)]
+struct NotifyingServer {
+    notifications: Vec<(&'static str, u64)>,
+}
+
+impl rmcp::ServerHandler for NotifyingServer {
+    async fn on_initialized(&self, context: rmcp::service::NotificationContext<rmcp::RoleServer>) {
+        for &(method, n) in &self.notifications {
+            context
+                .peer
+                .send_notification(rmcp::model::ServerNotification::CustomNotification(
+                    notification(method, n),
+                ))
+                .await
+                .expect("send notification");
+        }
+    }
+}
+
+impl crate::InProcessTransportFactory for NotifyingServer {
+    fn open(
+        &self,
+    ) -> futures::future::BoxFuture<'static, std::io::Result<tokio::io::DuplexStream>> {
+        use futures::FutureExt;
+        use rmcp::ServiceExt;
+
+        let server = self.clone();
+        async move {
+            let (client, transport) = tokio::io::duplex(/*max_buf_size*/ 4096);
+            tokio::spawn(async move {
+                let service = server.serve(transport).await.expect("serve");
+                let _ = service.waiting().await;
+            });
+            Ok(client)
+        }
+        .boxed()
+    }
+}
+
+/// Connects an in-process client to a server that sends `notifications` right after
+/// `initialize`, and returns the params of the first `count` that reach the subscriber of
+/// [`EVENT`], checking that no more arrive.
+async fn deliver_through_client(
+    notifications: Vec<(&'static str, u64)>,
+    count: usize,
+) -> anyhow::Result<Vec<Option<Value>>> {
+    use futures::FutureExt;
+    use rmcp::model::ClientCapabilities;
+    use rmcp::model::Implementation;
+    use rmcp::model::InitializeRequestParams;
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    let server = NotifyingServer { notifications };
+    let client = crate::RmcpClient::new_in_process_client(Arc::new(server)).await?;
+    let mut receiver = client.subscribe_custom_notifications(EVENT, count + 1);
+    client
+        .initialize(
+            InitializeRequestParams::new(
+                ClientCapabilities::default(),
+                Implementation::new("test", "1"),
+            ),
+            Some(Duration::from_secs(5)),
+            Box::new(|_, _| async { anyhow::bail!("unexpected elicitation") }.boxed()),
+        )
+        .await?;
+
+    let mut delivered = Vec::new();
+    for _ in 0..count {
+        let notification = tokio::time::timeout(Duration::from_secs(5), receiver.recv())
+            .await?
+            .ok_or_else(|| anyhow::anyhow!("subscriber closed after {delivered:?}"))?;
+        delivered.push(notification.params);
+    }
+    assert!(receiver.try_recv().is_err());
+    client.shutdown().await;
+    Ok(delivered)
+}
+
+#[tokio::test]
+async fn client_hands_subscribed_server_notifications_to_the_subscriber() -> anyhow::Result<()> {
+    let delivered =
+        deliver_through_client(vec![(EVENT, 1), (OTHER, 2), (EVENT, 3)], /*count*/ 2).await?;
+    assert_eq!(
+        delivered,
+        vec![Some(json!({ "n": 1 })), Some(json!({ "n": 3 }))]
+    );
+    Ok(())
+}
+
+/// The SDK handles each notification in a task of its own; on a multi-threaded runtime, a burst
+/// would reach a handler out of order.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn client_keeps_the_server_order_of_a_burst() -> anyhow::Result<()> {
+    const BURST: u64 = 64;
+    let sent: Vec<(&'static str, u64)> = (1..=BURST).map(|n| (EVENT, n)).collect();
+    let count = sent.len();
+    let delivered = deliver_through_client(sent, count).await?;
+    let expected: Vec<Option<Value>> = (1..=BURST).map(|n| Some(json!({ "n": n }))).collect();
+    assert_eq!(delivered, expected);
+    Ok(())
+}
