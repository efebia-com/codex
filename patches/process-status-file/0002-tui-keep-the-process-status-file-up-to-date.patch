From be1f2b9fcff16d020b07d30c379974471f5bc2d6 Mon Sep 17 00:00:00 2001
From: Calogero Mandracchia <calogero@efebia.com>
Date: Wed, 18 Nov 2026 12:18:32 +0100
Subject: [PATCH 2/2] tui: keep the process status file up to date

Start the process status file as soon as the terminal is set up, so the
startup composer, onboarding and the session pickers of codex resume
and codex fork already have one, with no conversation, and remove it
when the TUI exits, also on its fatal startup exits. Each frame of the
main screen reports the conversation shown, the root thread that /new,
/clear, /resume and /fork replace, which side chats, sub-agents and
summary threads leave alone, and its working directory; thread status
notifications report when its turns start and end. The file is only
written when one of these changes.
---
 codex-rs/tui/Cargo.toml                   |  1 +
 codex-rs/tui/src/app.rs                   |  4 ++++
 codex-rs/tui/src/app/app_server_events.rs |  4 ++++
 codex-rs/tui/src/startup_orchestration.rs | 15 +++++++++++++++
 4 files changed, 24 insertions(+)

diff --git a/codex-rs/tui/Cargo.toml b/codex-rs/tui/Cargo.toml
index 79ae4afa11..06a166112d 100644
--- a/codex-rs/tui/Cargo.toml
+++ b/codex-rs/tui/Cargo.toml
@@ -57,6 +57,7 @@ codex-model-provider-info = { workspace = true }
 codex-models-manager = { workspace = true }
 codex-otel = { workspace = true }
 codex-plugin = { workspace = true }
+codex-process-status-file = { workspace = true }
 codex-protocol = { workspace = true }
 codex-realtime-webrtc = { workspace = true }
 futures = { workspace = true }
diff --git a/codex-rs/tui/src/app.rs b/codex-rs/tui/src/app.rs
index 4f175ec6d3..b153ff70d3 100644
--- a/codex-rs/tui/src/app.rs
+++ b/codex-rs/tui/src/app.rs
@@ -1428,6 +1428,10 @@ impl App {
                     );
                     self.chat_widget.pre_draw_tick();
                     self.refresh_agents_overview_usage(app_server, tui.frame_requester());
+                    codex_process_status_file::show(
+                        self.primary_thread_id.as_ref().map(ToString::to_string),
+                        self.chat_widget.config_ref().cwd.as_path(),
+                    );
                     let rendered_area = self.render_chat_widget_frame(tui, screen_size)?;
                     if tui.is_owned_screen()
                         && self.transcript_view.history
diff --git a/codex-rs/tui/src/app/app_server_events.rs b/codex-rs/tui/src/app/app_server_events.rs
index a23c09a1c0..b84bf5a10b 100644
--- a/codex-rs/tui/src/app/app_server_events.rs
+++ b/codex-rs/tui/src/app/app_server_events.rs
@@ -265,6 +265,10 @@ impl App {
         self.observe_sidebar_agent_event(&notification);
         if let ServerNotification::ThreadStatusChanged(status) = &notification {
             let _ = self.dynamic_tool_status_updates.send(status.clone());
+            codex_process_status_file::thread_status(
+                &status.thread_id,
+                matches!(status.status, ThreadStatus::Active { .. }),
+            );
         }
 
         if let ServerNotification::ThreadStarted(started) = &notification
diff --git a/codex-rs/tui/src/startup_orchestration.rs b/codex-rs/tui/src/startup_orchestration.rs
index ce51253098..ecdd3acd4d 100644
--- a/codex-rs/tui/src/startup_orchestration.rs
+++ b/codex-rs/tui/src/startup_orchestration.rs
@@ -352,6 +352,18 @@ pub(super) async fn run_main_inner(
         screen.transcript_mode.is_owned(),
         screen.use_alt_screen,
     );
+    // Tells other programs which conversation this process shows, from the first screen on:
+    // the startup composer, onboarding and session pickers show none yet. Removed on exit.
+    let process_status_file = codex_process_status_file::start(
+        codex_home.as_path(),
+        config_cwd
+            .as_ref()
+            .map(AbsolutePathBuf::to_path_buf)
+            .or_else(|| std::env::current_dir().ok())
+            .unwrap_or_default()
+            .as_path(),
+        crate::version::CODEX_CLI_VERSION,
+    );
     let mut startup_draft = startup_draft::StartupDraft::new(
         initialized_terminal,
         terminal_restore_guard,
@@ -886,6 +898,7 @@ pub(super) async fn run_main_inner(
                     .shutdown_with_timeout(INTERACTIVE_OTEL_SHUTDOWN_TIMEOUT)
                     .await;
             }
+            drop(process_status_file);
             std::process::exit(1);
         }
     }
@@ -907,6 +920,7 @@ pub(super) async fn run_main_inner(
                     .shutdown_with_timeout(INTERACTIVE_OTEL_SHUTDOWN_TIMEOUT)
                     .await;
             }
+            drop(process_status_file);
             std::process::exit(1);
         }
     }
@@ -1037,6 +1051,7 @@ pub(super) async fn run_main_inner(
         err.downcast::<std::io::Error>()
             .unwrap_or_else(|err| std::io::Error::other(err.to_string()))
     });
+    drop(process_status_file);
 
     if let Some(worktree) = managed_worktree.as_ref() {
         worktree.report_startup_failure();
-- 
2.53.0

