+/// The only test that uses the process-wide card, so tests running in parallel never share it.
+#[test]
+fn the_tui_hooks_write_the_file_from_start_and_remove_it_on_exit() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let pid = std::process::id();
+    let path = home.path().join(DIRECTORY).join(format!("{pid}.json"));
+    if !enabled(std::env::var(DISABLE_ENV).ok().as_deref()) {
+        return;
+    }
+
+    let guard = start(home.path(), Path::new("/work/project"), "0.169.1");
+    // The startup screens, such as onboarding and the session pickers, come before any
+    // conversation: the file is already complete there, with a null session id.
+    let written = read(&path);
+    assert_eq!(
+        (
+            written["pid"].clone(),
+            written["procStart"].clone(),
+            written["sessionId"].clone(),
+            written["cwd"].clone(),
+            written["status"].clone(),
+            written["kind"].clone(),
+            written["version"].clone(),
+        ),
+        (
+            json!(pid),
+            json!(proc_start_of(pid)),
+            Value::Null,
+            json!("/work/project"),
+            json!("idle"),
+            json!("interactive"),
+            json!("0.169.1"),
+        )
+    );
+    // No status change yet. `tmux` and `updatedAt` may already carry the background lookup.
+    assert_eq!(written["startedAt"], written["statusUpdatedAt"]);
+    // The main screen's frames before its first conversation starts keep the session id null.
+    show(/*session_id*/ None, Path::new("/work/project"));
+    assert_eq!(read(&path)["sessionId"], Value::Null);
+
+    show(Some("main".to_string()), Path::new("/work/project"));
+    thread_status("main", /*busy*/ true);
+    let written = read(&path);
+    assert_eq!(
+        (
+            written["sessionId"].clone(),
+            written["status"].clone(),
+            written["pid"].clone(),
+        ),
+        (json!("main"), json!("busy"), json!(std::process::id()))
+    );
+
+    drop(guard);
+    assert!(!path.exists());
+    // After exit the hooks do nothing, and write no file again.
+    show(Some("other".to_string()), Path::new("/work/project"));
+    assert!(!path.exists());
+}
