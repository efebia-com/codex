+//! A status file for each running interactive Codex process.
+//!
+//! From the TUI's first screen until it exits, `$CODEX_HOME/processes/<pid>.json` tells which
+//! conversation the process shows, in which directory and terminal pane, and whether a turn is
+//! running in it. The startup screens, such as onboarding and the session pickers, show no
+//! conversation yet: there the session id is null. Other programs can map a process or a pane to
+//! its conversation without asking Codex. The file is replaced atomically on every change and
+//! removed when the TUI exits; files left by processes that were killed are removed by the next
+//! Codex that starts. Setting `CODEX_PROCESS_STATUS_FILE=0` turns it off.
+
+use std::collections::HashSet;
+use std::fs;
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Command;
+use std::process::Stdio;
+use std::sync::Mutex;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use serde_json::Value;
+use serde_json::json;
+
+/// Directory under `CODEX_HOME` with one file per running process.
+pub const DIRECTORY: &str = "processes";
+
+/// Environment variable that turns the file off when set to `0`, `false`, `off` or `no`.
+pub const DISABLE_ENV: &str = "CODEX_PROCESS_STATUS_FILE";
+
+const KIND: &str = "interactive";
+
+static CARD: Mutex<Option<Card>> = Mutex::new(None);
+
+/// Removes this process's file when dropped. Keep it alive while the TUI runs.
+#[must_use = "the status file is removed when the guard is dropped"]
+pub struct Guard {
+    _private: (),
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        let card = match CARD.lock() {
+            Ok(mut slot) => slot.take(),
+            Err(_) => None,
+        };
+        if let Some(card) = card {
+            card.remove();
+        }
+    }
+}
+
+/// Writes this process's file, unless [`DISABLE_ENV`] turns it off. Call it before the first
+/// screen: the file shows no conversation until [`show`] records one.
+///
+/// The terminal pane is looked up, and the files of ended processes are removed, on a background
+/// thread, so this never waits for other programs.
+pub fn start(codex_home: &Path, cwd: &Path, version: &str) -> Guard {
+    let guard = Guard { _private: () };
+    if !enabled(std::env::var(DISABLE_ENV).ok().as_deref()) {
+        return guard;
+    }
+    let dir = codex_home.join(DIRECTORY);
+    let pid = std::process::id();
+    let card = Card::new(dir.clone(), pid, proc_start_of(pid), version, cwd, now_ms());
+    card.write();
+    if let Ok(mut slot) = CARD.lock() {
+        *slot = Some(card);
+    }
+    let _ = std::thread::Builder::new()
+        .name("process-status-file".to_string())
+        .spawn(move || {
+            let tmux = tmux_location();
+            update(|card| card.set_tmux(tmux, now_ms()));
+            sweep(&dir, pid, proc_start_of);
+        });
+    guard
+}
+
+/// Records the conversation shown by the TUI and its working directory. Cheap when nothing
+/// changed, so it can run on every frame.
+pub fn show(session_id: Option<String>, cwd: &Path) {
+    update(|card| card.show(session_id, cwd, now_ms()));
+}
+
+/// Records whether a turn is running in a thread. Only the shown conversation's thread sets the
+/// file's status.
+pub fn thread_status(thread_id: &str, busy: bool) {
+    update(|card| card.thread_status(thread_id, busy, now_ms()));
+}
+
+fn update(change: impl FnOnce(&mut Card) -> bool) {
+    if let Ok(mut slot) = CARD.lock()
+        && let Some(card) = slot.as_mut()
+        && change(card)
+    {
+        card.write();
+    }
+}
+
+fn enabled(value: Option<&str>) -> bool {
+    !matches!(
+        value
+            .map(|value| value.trim().to_ascii_lowercase())
+            .as_deref(),
+        Some("0" | "false" | "off" | "no")
+    )
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|elapsed| u64::try_from(elapsed.as_millis()).unwrap_or(u64::MAX))
+        .unwrap_or(0)
+}
+
+struct Card {
+    dir: PathBuf,
+    pid: u32,
+    proc_start: Option<String>,
+    version: String,
+    session_id: Option<String>,
+    cwd: PathBuf,
+    tmux: Option<String>,
+    busy_threads: HashSet<String>,
+    busy: bool,
+    started_at: u64,
+    updated_at: u64,
+    status_updated_at: u64,
+}
+
+impl Card {
+    fn new(
+        dir: PathBuf,
+        pid: u32,
+        proc_start: Option<String>,
+        version: &str,
+        cwd: &Path,
+        now: u64,
+    ) -> Self {
+        Self {
+            dir,
+            pid,
+            proc_start,
+            version: version.to_string(),
+            session_id: None,
+            cwd: cwd.to_path_buf(),
+            tmux: None,
+            busy_threads: HashSet::new(),
+            busy: false,
+            started_at: now,
+            updated_at: now,
+            status_updated_at: now,
+        }
+    }
+
+    /// Returns whether the file must be written again.
+    fn show(&mut self, session_id: Option<String>, cwd: &Path, now: u64) -> bool {
+        if self.session_id == session_id && self.cwd.as_path() == cwd {
+            return false;
+        }
+        self.session_id = session_id;
+        self.cwd = cwd.to_path_buf();
+        self.refresh_status(now);
+        self.updated_at = now;
+        true
+    }
+
+    /// Returns whether the file must be written again.
+    fn thread_status(&mut self, thread_id: &str, busy: bool, now: u64) -> bool {
+        if busy {
+            self.busy_threads.insert(thread_id.to_string());
+        } else {
+            self.busy_threads.remove(thread_id);
+        }
+        if !self.refresh_status(now) {
+            return false;
+        }
+        self.updated_at = now;
+        true
+    }
+
+    /// Returns whether the file must be written again.
+    fn set_tmux(&mut self, tmux: Option<String>, now: u64) -> bool {
+        if self.tmux == tmux {
+            return false;
+        }
+        self.tmux = tmux;
+        self.updated_at = now;
+        true
+    }
+
+    fn refresh_status(&mut self, now: u64) -> bool {
+        let busy = self
+            .session_id
+            .as_ref()
+            .is_some_and(|session_id| self.busy_threads.contains(session_id));
+        if busy == self.busy {
+            return false;
+        }
+        self.busy = busy;
+        self.status_updated_at = now;
+        true
+    }
+
+    fn to_json(&self) -> Value {
+        let status = if self.busy { "busy" } else { "idle" };
+        json!({
+            "pid": self.pid,
+            "procStart": self.proc_start,
+            "sessionId": self.session_id,
+            "cwd": self.cwd.to_string_lossy(),
+            "tmux": self.tmux,
+            "status": status,
+            "kind": KIND,
+            "version": self.version,
+            "startedAt": self.started_at,
+            "updatedAt": self.updated_at,
+            "statusUpdatedAt": self.status_updated_at,
+        })
+    }
+
+    fn path(&self) -> PathBuf {
+        let pid = self.pid;
+        self.dir.join(format!("{pid}.json"))
+    }
+
+    /// Errors are ignored: the file is a hint for other programs, never a reason to stop Codex.
+    fn write(&self) {
+        let _ = self.try_write();
+    }
+
+    fn try_write(&self) -> io::Result<()> {
+        create_private_dir(&self.dir)?;
+        let mut bytes = serde_json::to_vec(&self.to_json()).map_err(io::Error::other)?;
+        bytes.push(b'\n');
+        let pid = self.pid;
+        let temp = self.dir.join(format!(".{pid}.json.tmp"));
+        let mut file = private_file(&temp)?;
+        file.write_all(&bytes)?;
+        drop(file);
+        fs::rename(temp, self.path())
+    }
+
+    fn remove(&self) {
+        let _ = fs::remove_file(self.path());
+    }
+}
+
+fn create_private_dir(dir: &Path) -> io::Result<()> {
+    let mut builder = fs::DirBuilder::new();
+    builder.recursive(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        builder.mode(0o700);
+    }
+    builder.create(dir)
+}
+
+fn private_file(path: &Path) -> io::Result<fs::File> {
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create(true).truncate(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    options.open(path)
+}
+
+/// The start time of a process, in clock ticks after boot: field 22 of `/proc/<pid>/stat`. With
+/// the pid it names one process, even after the pid is reused. `None` where `/proc` is missing.
+fn proc_start_of(pid: u32) -> Option<String> {
+    let stat = fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+    parse_proc_start(&stat)
+}
+
+fn parse_proc_start(stat: &str) -> Option<String> {
+    // Field 2, the command name, is in parentheses and may itself contain spaces and `)`.
+    let (_, rest) = stat.rsplit_once(')')?;
+    rest.split_whitespace().nth(19).map(str::to_string)
+}
+
+/// `session:@window.%pane`, as `tmux display-message` prints it for this process's pane; only the
+/// pane id when tmux does not answer; `None` outside tmux.
+fn tmux_location() -> Option<String> {
+    std::env::var_os("TMUX")?;
+    let pane = std::env::var("TMUX_PANE")
+        .ok()
+        .filter(|pane| !pane.is_empty())?;
+    let output = Command::new("tmux")
+        .args([
+            "display-message",
+            "-p",
+            "-t",
+            pane.as_str(),
+            "#{session_name}:#{window_id}.#{pane_id}",
+        ])
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output();
+    let location = match output {
+        Ok(output) if output.status.success() => {
+            String::from_utf8_lossy(&output.stdout).trim().to_string()
+        }
+        _ => String::new(),
+    };
+    if location.is_empty() {
+        Some(pane)
+    } else {
+        Some(location)
+    }
+}
+
+/// Removes the files of processes that ended without removing theirs (killed, or closed with
+/// their terminal): their pid no longer runs, or now belongs to a process started later. Does
+/// nothing where the start time of this process cannot be read.
+fn sweep(dir: &Path, own_pid: u32, proc_start: impl Fn(u32) -> Option<String>) {
+    if proc_start(own_pid).is_none() {
+        return;
+    }
+    let Ok(entries) = fs::read_dir(dir) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let Some(pid) = card_pid(&path) else {
+            continue;
+        };
+        if pid == own_pid {
+            continue;
+        }
+        let ended = match proc_start(pid) {
+            None => true,
+            Some(current) => recorded_proc_start(&path).is_some_and(|recorded| recorded != current),
+        };
+        if ended {
+            let _ = fs::remove_file(path);
+        }
+    }
+}
+
+/// The pid in the name of a status file, `<pid>.json`, or of its temporary `.<pid>.json.tmp`.
+fn card_pid(path: &Path) -> Option<u32> {
+    let name = path.file_name()?.to_str()?;
+    let digits = name
+        .strip_suffix(".json")
+        .or_else(|| name.strip_prefix('.')?.strip_suffix(".json.tmp"))?;
+    if digits.is_empty() || !digits.bytes().all(|byte| byte.is_ascii_digit()) {
+        return None;
+    }
+    digits.parse().ok()
+}
+
+fn recorded_proc_start(path: &Path) -> Option<String> {
+    let text = fs::read_to_string(path).ok()?;
+    let card: Value = serde_json::from_str(&text).ok()?;
+    card.get("procStart")?.as_str().map(str::to_string)
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/codex-rs/process-status-file/src/tests.rs b/codex-rs/process-status-file/src/tests.rs
