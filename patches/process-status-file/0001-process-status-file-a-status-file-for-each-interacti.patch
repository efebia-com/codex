+#[test]
+fn the_sweep_removes_only_files_of_ended_processes() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let dir = home.path().join(DIRECTORY);
+    let own = card_in(home.path(), 100);
+    own.write();
+    // A live process with the start time it recorded.
+    card_in(home.path(), 200).write();
+    // A pid that is gone.
+    card_in(home.path(), 300).write();
+    // A pid reused by a process started later.
+    card_in(home.path(), 400).write();
+    // The temporary file of a process killed while writing.
+    fs::write(dir.join(".300.json.tmp"), "{").expect("write a temporary file");
+    // Other files are not ours to remove.
+    fs::write(dir.join("README"), "keep").expect("write another file");
+
+    let asked = RefCell::new(Vec::new());
+    sweep(&dir, 100, |pid| {
+        asked.borrow_mut().push(pid);
+        match pid {
+            100 | 200 => Some("4242".to_string()),
+            400 => Some("9999".to_string()),
+            _ => None,
+        }
+    });
+
+    assert_eq!(
+        file_names(&dir),
+        vec![
+            "100.json".to_string(),
+            "200.json".to_string(),
+            "README".to_string(),
+        ]
+    );
+    assert!(!asked.borrow().is_empty());
+}
+
+#[test]
+fn the_sweep_does_nothing_without_start_times() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let dir = home.path().join(DIRECTORY);
+    card_in(home.path(), 100).write();
+    card_in(home.path(), 300).write();
+
+    sweep(&dir, 100, |_| None);
+
+    assert_eq!(
+        file_names(&dir),
+        vec!["100.json".to_string(), "300.json".to_string()]
+    );
+}
