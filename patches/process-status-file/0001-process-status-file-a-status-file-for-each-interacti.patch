+use super::*;
+use pretty_assertions::assert_eq;
+use std::cell::RefCell;
+
+fn read(path: &Path) -> Value {
+    let text = fs::read_to_string(path).expect("read the status file");
+    serde_json::from_str(&text).expect("parse the status file")
+}
+
+fn card_in(dir: &Path, pid: u32) -> Card {
+    Card::new(
+        dir.join(DIRECTORY),
+        pid,
+        Some("4242".to_string()),
+        "0.169.1",
+        Path::new("/work/project"),
+        1_000,
+    )
+}
+
+fn file_names(dir: &Path) -> Vec<String> {
+    let mut names: Vec<String> = fs::read_dir(dir)
+        .expect("list the directory")
+        .map(|entry| {
+            entry
+                .expect("directory entry")
+                .file_name()
+                .to_string_lossy()
+                .into_owned()
+        })
+        .collect();
+    names.sort();
+    names
+}
+
+#[test]
+fn a_new_card_has_the_fields_of_the_claude_card() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let card = card_in(home.path(), 31_337);
+
+    card.write();
+
+    assert_eq!(
+        read(&home.path().join(DIRECTORY).join("31337.json")),
+        json!({
+            "pid": 31_337,
+            "procStart": "4242",
+            "sessionId": null,
+            "cwd": "/work/project",
+            "tmux": null,
+            "status": "idle",
+            "kind": "interactive",
+            "version": "0.169.1",
+            "startedAt": 1_000,
+            "updatedAt": 1_000,
+            "statusUpdatedAt": 1_000,
+        })
+    );
+    // The temporary file is renamed, never left behind.
+    assert_eq!(
+        file_names(&home.path().join(DIRECTORY)),
+        vec!["31337.json".to_string()]
+    );
+}
+
+#[cfg(unix)]
+#[test]
+fn the_file_and_its_directory_are_private() {
+    use std::os::unix::fs::PermissionsExt;
+
+    let home = tempfile::tempdir().expect("tempdir");
+    let card = card_in(home.path(), 7);
+    card.write();
+
+    let dir_mode = fs::metadata(home.path().join(DIRECTORY))
+        .expect("directory metadata")
+        .permissions()
+        .mode();
+    let file_mode = fs::metadata(card.path())
+        .expect("file metadata")
+        .permissions()
+        .mode();
+    assert_eq!((dir_mode & 0o777, file_mode & 0o777), (0o700, 0o600));
+}
+
+#[test]
+fn showing_a_conversation_changes_the_file_only_when_it_changes() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let mut card = card_in(home.path(), 8);
+    let cwd = Path::new("/work/project");
+
+    assert!(card.show(Some("thread-a".to_string()), cwd, 2_000));
+    assert!(!card.show(Some("thread-a".to_string()), cwd, 3_000));
+    assert!(card.show(
+        Some("thread-a".to_string()),
+        Path::new("/work/other"),
+        4_000
+    ));
+    assert!(card.show(
+        Some("thread-b".to_string()),
+        Path::new("/work/other"),
+        5_000
+    ));
+    assert!(card.show(None, Path::new("/work/other"), 6_000));
+    card.write();
+
+    let written = read(&card.path());
+    assert_eq!(
+        (
+            written["sessionId"].clone(),
+            written["cwd"].clone(),
+            written["updatedAt"].clone(),
+            written["statusUpdatedAt"].clone(),
+        ),
+        (
+            Value::Null,
+            json!("/work/other"),
+            json!(6_000),
+            json!(1_000)
+        )
+    );
+}
+
+#[test]
+fn the_status_follows_only_the_shown_conversation() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let mut card = card_in(home.path(), 9);
+    let cwd = Path::new("/work/project");
+    card.show(Some("main".to_string()), cwd, 2_000);
+
+    // A turn in another thread (a side chat, a sub-agent, a summary) leaves the status alone.
+    assert!(!card.thread_status("side", /*busy*/ true, 3_000));
+    assert!(card.thread_status("main", /*busy*/ true, 4_000));
+    assert!(!card.thread_status("main", /*busy*/ true, 5_000));
+    card.write();
+    let busy = read(&card.path());
+    assert_eq!(
+        (busy["status"].clone(), busy["statusUpdatedAt"].clone()),
+        (json!("busy"), json!(4_000))
+    );
+
+    // Showing another conversation shows its own status; coming back restores the running one.
+    assert!(card.show(Some("other".to_string()), cwd, 6_000));
+    assert!(!card.busy);
+    assert!(card.show(Some("main".to_string()), cwd, 7_000));
+    assert!(card.busy);
+
+    assert!(card.thread_status("main", /*busy*/ false, 8_000));
+    card.write();
+    let idle = read(&card.path());
+    assert_eq!(
+        (
+            idle["status"].clone(),
+            idle["statusUpdatedAt"].clone(),
+            idle["updatedAt"].clone(),
+        ),
+        (json!("idle"), json!(8_000), json!(8_000))
+    );
+}
+
+#[test]
+fn the_tmux_location_is_written_once_known() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let mut card = card_in(home.path(), 10);
+
+    assert!(card.set_tmux(Some("work:@3.%7".to_string()), 2_000));
+    assert!(!card.set_tmux(Some("work:@3.%7".to_string()), 3_000));
+    card.write();
+
+    assert_eq!(read(&card.path())["tmux"], json!("work:@3.%7"));
+}
+
+#[test]
+fn removing_deletes_the_file_and_tolerates_a_missing_one() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let card = card_in(home.path(), 11);
+    card.write();
+
+    card.remove();
+    card.remove();
+
+    assert!(!card.path().exists());
+}
+
+#[test]
+fn the_start_time_is_field_22_of_proc_stat() {
+    let fields: Vec<String> = (3..=52).map(|field| format!("f{field}")).collect();
+    let stat = format!("1234 (odd ) name (x)) {}\n", fields.join(" "));
+
+    assert_eq!(parse_proc_start(&stat), Some("f22".to_string()));
+    assert_eq!(parse_proc_start("1234 (truncated) S 1 2"), None);
+    assert_eq!(parse_proc_start("no parentheses"), None);
+}
+
+#[cfg(target_os = "linux")]
+#[test]
+fn this_process_has_a_start_time() {
+    let start = proc_start_of(std::process::id()).expect("start time of this process");
+
+    assert!(start.bytes().all(|byte| byte.is_ascii_digit()), "{start}");
+}
+
+#[test]
+fn only_status_file_names_carry_a_pid() {
+    let pid = |name: &str| card_pid(Path::new("/x").join(name).as_path());
+
+    assert_eq!(pid("123.json"), Some(123));
+    assert_eq!(pid(".123.json.tmp"), Some(123));
+    assert_eq!(pid("abc.json"), None);
+    assert_eq!(pid(".json"), None);
+    assert_eq!(pid("+12.json"), None);
+    assert_eq!(pid(".123.json"), None);
+    assert_eq!(pid("123.json.bak"), None);
+    assert_eq!(pid("notes.txt"), None);
+}
