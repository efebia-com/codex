+    channels: Arc<ChannelsExtension>,
+}
+
+impl ThreadChannelsRequestProcessor {
+    pub(crate) fn new(
+        thread_manager: Arc<ThreadManager>,
+        channels: Arc<ChannelsExtension>,
+    ) -> Self {
+        Self {
+            thread_manager,
+            channels,
+        }
+    }
+
+    pub(crate) async fn fence(
+        &self,
+        params: ThreadChannelsFenceParams,
+    ) -> Result<ThreadChannelsFenceResponse, JSONRPCErrorError> {
+        if params.closed && params.discard_seqs.is_some() {
+            return Err(invalid_params("discardSeqs is only allowed when opening"));
+        }
+        let discard_seqs = params
+            .discard_seqs
+            .unwrap_or_default()
+            .into_iter()
+            .map(|seq| {
+                u64::try_from(seq).map_err(|_| invalid_params("discardSeqs must not be negative"))
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        let thread_id = self.loaded_thread(&params.thread_id).await?;
+        let barrier = self
+            .channels
+            .fence(
+                thread_id,
+                params.closed,
+                params.expected_fence_id,
+                discard_seqs,
+            )
+            .await
+            .map_err(barrier_error)?;
+        Ok(ThreadChannelsFenceResponse {
+            barrier: api_barrier(barrier),
+        })
+    }
+
+    pub(crate) async fn read(
+        &self,
+        params: ThreadChannelsReadParams,
+    ) -> Result<ThreadChannelsReadResponse, JSONRPCErrorError> {
+        let thread_id = self.loaded_thread(&params.thread_id).await?;
+        let wait = params
+            .wait_drained_ms
+            .and_then(|ms| u64::try_from(ms).ok())
+            .map(Duration::from_millis);
+        let barrier = self
+            .channels
+            .read(thread_id, wait)
+            .await
+            .map_err(barrier_error)?;
+        Ok(ThreadChannelsReadResponse {
+            barrier: api_barrier(barrier),
+        })
+    }
+
+    pub(crate) async fn release(
+        &self,
+        params: ThreadChannelsReleaseParams,
+    ) -> Result<ThreadChannelsReleaseResponse, JSONRPCErrorError> {
+        let thread_id = self.loaded_thread(&params.thread_id).await?;
+        let through_seq = u64::try_from(params.through_seq)
+            .map_err(|_| invalid_params("throughSeq must not be negative"))?;
+        let barrier = self
+            .channels
+            .release(thread_id, params.fence_id, through_seq)
+            .await
+            .map_err(barrier_error)?;
+        Ok(ThreadChannelsReleaseResponse {
+            barrier: api_barrier(barrier),
+        })
+    }
+
+    async fn loaded_thread(&self, thread_id: &str) -> Result<ThreadId, JSONRPCErrorError> {
+        let parsed = ThreadId::from_string(thread_id).map_err(|_| {
+            reason_error("threadNotFound", format!("invalid thread id {thread_id}"))
+        })?;
+        self.thread_manager.get_thread(parsed).await.map_err(|_| {
+            reason_error(
+                "threadNotFound",
+                format!("thread {thread_id} is not loaded"),
+            )
+        })?;
+        Ok(parsed)
+    }
+}
+
+fn reason_error(reason: &str, message: impl Into<String>) -> JSONRPCErrorError {
+    let mut error = invalid_request(message);
+    error.data = Some(serde_json::json!({ "reason": reason }));
+    error
+}
+
+fn barrier_error(error: BarrierError) -> JSONRPCErrorError {
+    let message = error.to_string();
+    match error {
+        BarrierError::NoChannels => reason_error("noChannels", message),
+        BarrierError::FenceOpen => reason_error("fenceOpen", message),
+        // `current` is the fence id the barrier is closed under, or null when it is open.
+        BarrierError::FenceMismatch { current } => {
+            let mut error = invalid_request(message);
+            error.data = Some(serde_json::json!({ "reason": "fenceMismatch", "current": current }));
+            error
+        }
+    }
+}
+
+fn number(value: u64) -> i64 {
+    i64::try_from(value).unwrap_or(i64::MAX)
+}
+
+fn api_barrier(barrier: barrier::ChannelBarrier) -> ChannelBarrier {
+    ChannelBarrier {
+        closed: barrier.closed,
+        fence_id: barrier.fence_id,
+        since: barrier.since_ms,
+        drained: barrier.drained,
+        blocked_by: barrier
+            .blocked_by
+            .into_iter()
+            .map(|block| ChannelBarrierBlock {
+                reason: match block.reason {
+                    barrier::BlockReason::MarkerPending => ChannelBlockReason::MarkerPending,
+                    barrier::BlockReason::Launching => ChannelBlockReason::Launching,
+                    barrier::BlockReason::Recovering => ChannelBlockReason::Recovering,
+                    barrier::BlockReason::GaveUp => ChannelBlockReason::GaveUp,
+                    barrier::BlockReason::Unsupported => ChannelBlockReason::Unsupported,
+                    barrier::BlockReason::Failed => ChannelBlockReason::Failed,
+                    barrier::BlockReason::InFlight => ChannelBlockReason::InFlight,
+                },
+                server: block.server,
+            })
+            .collect(),
+        uncertain: barrier
+            .uncertain
+            .into_iter()
+            .map(|uncertainty| ChannelBarrierUncertainty {
+                reason: match uncertainty.reason {
+                    barrier::UncertainReason::ExitedBeforeMarker => {
+                        ChannelUncertainReason::ExitedBeforeMarker
+                    }
+                    barrier::UncertainReason::LateAfterMarker => {
+                        ChannelUncertainReason::LateAfterMarker
+                    }
+                    barrier::UncertainReason::DroppedSinceClose => {
+                        ChannelUncertainReason::DroppedSinceClose
+                    }
+                },
+                server: uncertainty.server,
+                generation: uncertainty.generation.map(number),
+            })
+            .collect(),
+        servers: barrier
+            .servers
+            .into_iter()
+            .map(|server| {
+                let (fence, fence_error) = match server.fence {
+                    ServerFence::Open => (ChannelServerFence::Open, None),
+                    ServerFence::Requested => (ChannelServerFence::Requested, None),
+                    ServerFence::Acknowledged => (ChannelServerFence::Acknowledged, None),
+                    ServerFence::Unsupported => (ChannelServerFence::Unsupported, None),
+                    ServerFence::Failed(error) => (ChannelServerFence::Failed, Some(error)),
+                };
+                ChannelBarrierServer {
+                    name: server.name,
+                    generation: number(server.generation),
+                    pid: server.pid,
+                    connection: match server.connection {
+                        ChannelConnection::Launching => ChannelServerConnection::Launching,
+                        ChannelConnection::Ready => ChannelServerConnection::Ready,
+                        ChannelConnection::Recovering => ChannelServerConnection::Recovering,
+                        ChannelConnection::FencedWaiting => ChannelServerConnection::FencedWaiting,
+                        ChannelConnection::GaveUp => ChannelServerConnection::GaveUp,
+                        ChannelConnection::Closed => ChannelServerConnection::Closed,
+                    },
+                    fence,
+                    fence_error,
+                    marker_seen: server.marker_seen,
+                }
+            })
+            .collect(),
+        held: barrier
+            .held
+            .into_iter()
+            .map(|input| ChannelHeldInput {
+                seq: number(input.seq),
+                server: input.server,
+                generation: number(input.generation),
+                content: input.content,
+                meta: input.meta,
+                requeued: input.requeued,
+            })
+            .collect(),
+        in_flight: barrier
+            .in_flight
+            .into_iter()
+            .map(|input| ChannelInFlightInput {
+                seq: number(input.seq),
+                server: input.server,
+                turn_id: input.turn_id,
+                path: match input.path {
+                    barrier::InFlightPath::Steered => ChannelInFlightPath::Steered,
+                    barrier::InFlightPath::Started => ChannelInFlightPath::Started,
+                },
+            })
+            .collect(),
+        dropped: ChannelDropped {
+            queue_full: number(barrier.dropped.queue_full),
+            invalid: number(barrier.dropped.invalid),
+        },
+    }
+}
