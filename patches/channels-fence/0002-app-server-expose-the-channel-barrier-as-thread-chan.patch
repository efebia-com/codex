new file mode 100644
index 0000000000..1ca872c7d7
--- /dev/null
+++ b/codex-rs/app-server-protocol/src/protocol/v2/thread_channels.rs
@@ -0,0 +1,228 @@
+//! The channel input barrier of a loaded thread.
+//!
+//! While the barrier is closed, input from MCP channel servers does not reach the model: each
+//! server stops accepting input, emits what it already accepted and then a marker. Input that
+//! reaches the thread meanwhile is held until it is released or the barrier opens again.
+
+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value as JsonValue;
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadChannelsFenceParams {
+    pub thread_id: String,
+    /// Close (`true`) or open (`false`) the barrier. Closing an open barrier picks a new fence
+    /// id; closing a closed one changes nothing. Opening delivers the held input.
+    pub closed: bool,
+    /// The current fence id. Required to open a closed barrier; when given while closing, a
+    /// barrier closed under another id is an error. Opening an open barrier succeeds, with no
+    /// effect, only as a retry of its last opening, with that fence id.
+    #[ts(optional = nullable)]
+    pub expected_fence_id: Option<String>,
+    /// Only when opening: held input with these sequence numbers is dropped instead of
+    /// delivered. Unknown or already dropped numbers are ignored; a retried opening ignores
+    /// the list.
+    #[ts(type = "Array<number> | null")]
+    #[ts(optional = nullable)]
+    pub discard_seqs: Option<Vec<i64>>,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadChannelsFenceResponse {
+    pub barrier: ChannelBarrier,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadChannelsReadParams {
+    pub thread_id: String,
+    /// While the barrier is closed and not drained, wait for it to drain or open, up to this
+    /// many milliseconds (at most 60000). The current state is returned either way.
+    #[ts(type = "number | null")]
+    #[ts(optional = nullable)]
+    pub wait_drained_ms: Option<i64>,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadChannelsReadResponse {
+    pub barrier: ChannelBarrier,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadChannelsReleaseParams {
+    pub thread_id: String,
+    /// The current fence id.
+    pub fence_id: String,
+    /// Held input with this sequence number or lower, kept by the caller, is dropped.
+    #[ts(type = "number")]
+    pub through_seq: i64,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadChannelsReleaseResponse {
+    pub barrier: ChannelBarrier,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ChannelBarrier {
+    pub closed: bool,
+    pub fence_id: Option<String>,
+    /// Unix time in milliseconds when the barrier closed.
+    #[ts(type = "number | null")]
+    pub since: Option<i64>,
+    /// Closed, and nothing in `blockedBy`. The outcome is certain only if `uncertain` is empty.
+    pub drained: bool,
+    pub blocked_by: Vec<ChannelBarrierBlock>,
+    pub uncertain: Vec<ChannelBarrierUncertainty>,
+    pub servers: Vec<ChannelBarrierServer>,
+    /// Input that reached the thread and was not handed to the model, oldest first.
+    pub held: Vec<ChannelHeldInput>,
+    /// Input handed to a turn and not yet recorded.
+    pub in_flight: Vec<ChannelInFlightInput>,
+    pub dropped: ChannelDropped,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum ChannelBlockReason {
+    MarkerPending,
+    Launching,
+    Recovering,
+    GaveUp,
+    Unsupported,
+    Failed,
+    InFlight,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ChannelBarrierBlock {
+    pub reason: ChannelBlockReason,
+    pub server: Option<String>,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum ChannelUncertainReason {
+    /// A connection that could accept input ended before emitting its marker.
+    ExitedBeforeMarker,
+    /// A server sent input after its marker.
+    LateAfterMarker,
+    /// Input was dropped by a full queue or for invalid content after the barrier closed.
+    DroppedSinceClose,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ChannelBarrierUncertainty {
+    pub reason: ChannelUncertainReason,
+    pub server: Option<String>,
+    #[ts(type = "number | null")]
+    pub generation: Option<i64>,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum ChannelServerConnection {
+    Launching,
+    Ready,
+    Recovering,
+    FencedWaiting,
+    GaveUp,
+    Closed,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum ChannelServerFence {
+    Open,
+    Requested,
+    Acknowledged,
+    Unsupported,
+    Failed,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ChannelBarrierServer {
+    pub name: String,
+    /// The server's current connection; 0 before its first one.
+    #[ts(type = "number")]
+    pub generation: i64,
+    pub pid: Option<u32>,
+    pub connection: ChannelServerConnection,
+    pub fence: ChannelServerFence,
+    pub fence_error: Option<String>,
+    /// The current connection's marker for this fence arrived.
+    pub marker_seen: bool,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ChannelHeldInput {
+    #[ts(type = "number")]
+    pub seq: i64,
+    pub server: String,
+    #[ts(type = "number")]
+    pub generation: i64,
+    /// The notification's content and meta, as the server sent them.
+    pub content: String,
+    pub meta: Option<JsonValue>,
+    /// Returned to the queue after a turn that did not record it.
+    pub requeued: bool,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum ChannelInFlightPath {
+    /// Steered into an active turn.
+    Steered,
+    /// Started its own turn.
+    Started,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ChannelInFlightInput {
+    #[ts(type = "number")]
+    pub seq: i64,
+    pub server: String,
+    pub turn_id: String,
+    pub path: ChannelInFlightPath,
+}
+
+/// Notifications dropped since the thread started.
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ChannelDropped {
+    #[ts(type = "number")]
+    pub queue_full: i64,
+    #[ts(type = "number")]
+    pub invalid: i64,
+}
