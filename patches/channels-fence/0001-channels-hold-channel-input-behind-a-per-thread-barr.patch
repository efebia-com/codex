+#[tokio::test]
+async fn opening_drops_the_discarded_input_and_delivers_the_rest_once() {
+    let delivery = steering(true);
+    let mut queue = super::Queue::default();
+    let id = close(&mut queue).await;
+    for text in ["a", "b", "c", "d"] {
+        queue.push(&event(text), false);
+    }
+    // Unknown numbers are ignored.
+    let (opened, attempt) = ask(&mut queue, |reply| super::BarrierRequest::Fence {
+        closed: false,
+        expected_fence_id: Some(id.clone()),
+        discard_seqs: vec![1, 3, 9],
+        reply,
+    })
+    .await;
+    let opened = opened.expect("opened");
+    assert!(!opened.closed);
+    assert!(attempt);
+    queue.deliver(&delivery).await;
+
+    // A retried opening finds the barrier open and changes nothing, whatever it discards.
+    let (retried, attempt) = ask(&mut queue, |reply| super::BarrierRequest::Fence {
+        closed: false,
+        expected_fence_id: Some(id),
+        discard_seqs: vec![0, 2],
+        reply,
+    })
+    .await;
+    assert!(!retried.expect("retried").closed);
+    assert!(!attempt);
+    queue.deliver(&delivery).await;
