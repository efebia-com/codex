+    );
+    assert!(!attempt);
+
+    let (opened, attempt) = ask(&mut queue, |reply| super::BarrierRequest::Fence {
+        closed: false,
+        expected_fence_id: Some(id.clone()),
+        discard_seqs: Vec::new(),
+        reply,
+    })
+    .await;
+    assert!(!opened.expect("opened").closed);
+    assert!(attempt);
+    queue.deliver(&delivery).await;
+    assert_eq!(
+        *delivery.attempts.lock().expect("attempts"),
+        vec![Attempt::Idle(vec![rendered("one"), rendered("two")])]
+    );
+
+    // Retrying that opening succeeds; any other id finds no fence to open.
+    let (retried, attempt) = ask(&mut queue, |reply| super::BarrierRequest::Fence {
+        closed: false,
+        expected_fence_id: Some(id),
+        discard_seqs: Vec::new(),
+        reply,
+    })
+    .await;
+    assert!(!retried.expect("retried").closed);
+    assert!(!attempt);
+    for expected_fence_id in [Some("fence-stale".to_string()), None] {
+        let (refused, _) = ask(&mut queue, |reply| super::BarrierRequest::Fence {
+            closed: false,
+            expected_fence_id,
+            discard_seqs: Vec::new(),
+            reply,
+        })
+        .await;
+        assert_eq!(refused, Err(BarrierError::FenceMismatch { current: None }));
+    }
+}
