+    let mut queue = super::Queue::default();
+    let marker = ChannelNotification {
+        server: "srv".to_string(),
+        generation: 1,
+        params: Some(json!({ "content": "", "meta": { "fence": "fence-any" } })),
+    };
+    queue.push(&marker, false);
+    queue.deliver(&delivery).await;
+    close(&mut queue).await;
+    queue.push(&marker, false);
+    assert_eq!(queue.len(), 0);
+    assert!(delivery.attempts.lock().expect("attempts").is_empty());
+}
+
+#[tokio::test]
+async fn a_closed_barrier_holds_input_a_completed_turn_did_not_record() {
+    use super::WorkerEvent;
+
+    let delivery = steering(true);
+    let mut queue = super::Queue::default();
+    queue.event(WorkerEvent::TurnStarted("turn".to_string()));
+    queue.push(&event("steered"), true);
+    queue.deliver(&delivery).await;
+    let (barrier, _) = ask(&mut queue, |reply| super::BarrierRequest::Read { reply }).await;
+    assert_eq!(barrier.in_flight.len(), 1);
+    close(&mut queue).await;
+    queue.event(WorkerEvent::TurnEnded {
+        turn_id: "turn".to_string(),
+        aborted: false,
+    });
+    assert_eq!(
+        held(&mut queue).await,
+        vec![(0, "steered".to_string(), true)]
