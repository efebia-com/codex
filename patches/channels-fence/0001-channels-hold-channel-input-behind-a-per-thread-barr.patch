+
+#[tokio::test]
+async fn release_drops_held_input_through_a_sequence_number_once() {
+    use crate::barrier::BarrierError;
+
+    let mut queue = super::Queue::default();
+    let id = close(&mut queue).await;
+    for text in ["a", "b", "c"] {
+        queue.push(&event(text), false);
+    }
+    for _ in 0..2 {
+        let (released, _) = ask(&mut queue, |reply| super::BarrierRequest::Release {
+            fence_id: id.clone(),
+            through_seq: 1,
+            reply,
+        })
+        .await;
+        let held: Vec<u64> = released
+            .expect("released")
+            .held
+            .iter()
+            .map(|input| input.seq)
+            .collect();
+        assert_eq!(held, vec![2]);
+    }
+    let (refused, _) = ask(&mut queue, |reply| super::BarrierRequest::Release {
+        fence_id: "fence-other".to_string(),
+        through_seq: 2,
+        reply,
+    })
+    .await;
+    assert_eq!(
+        refused,
+        Err(BarrierError::FenceMismatch {
+            current: Some(id.clone()),
+        })
+    );
+    ask(&mut queue, |reply| super::BarrierRequest::Fence {
+        closed: false,
+        expected_fence_id: Some(id.clone()),
+        discard_seqs: Vec::new(),
+        reply,
+    })
+    .await;
+    let (refused, _) = ask(&mut queue, |reply| super::BarrierRequest::Release {
+        fence_id: id,
+        through_seq: 2,
+        reply,
+    })
+    .await;
+    assert_eq!(refused, Err(BarrierError::FenceOpen));
+}
