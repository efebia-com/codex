+//! The channel input barrier of a thread.
+//!
+//! A host closes the barrier before it captures a thread's state. From then on no channel input
+//! reaches the model: each server is asked to stop accepting input, to emit what it already
+//! accepted and then a marker notification carrying the fence id. Input that reaches the thread
+//! meanwhile is held, in order, until the host releases it (after keeping it elsewhere) or opens
+//! the barrier again, which delivers it. A snapshot says what still blocks the drain and what may
+//! have been lost on the way, so the host can tell a certain outcome from an indeterminate one.
+
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::collections::HashMap;
+use std::fmt;
+
+use codex_mcp::ChannelConnection;
+use codex_mcp::ChannelServerState;
+use codex_mcp::ServerFence;
+use serde_json::Value;
+
+/// `meta` key of the marker notification that ends a server's input before a fence.
+pub const FENCE_META_KEY: &str = "fence";
+
+/// A snapshot of a thread's channel barrier.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChannelBarrier {
+    pub closed: bool,
+    pub fence_id: Option<String>,
+    /// Unix time in milliseconds when the barrier closed.
+    pub since_ms: Option<i64>,
+    /// Closed, and nothing in `blocked_by`.
+    pub drained: bool,
+    pub blocked_by: Vec<Block>,
+    pub uncertain: Vec<Uncertainty>,
+    pub servers: Vec<ServerBarrier>,
+    /// Input that reached the thread and was not handed to the model, oldest first.
+    pub held: Vec<HeldInput>,
+    /// Input handed to a turn and not yet recorded.
+    pub in_flight: Vec<InFlightInput>,
+    pub dropped: Dropped,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BlockReason {
+    MarkerPending,
+    Launching,
+    Recovering,
+    GaveUp,
+    Unsupported,
+    Failed,
+    InFlight,
+}
+
+/// Why the barrier is not drained yet.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Block {
+    pub reason: BlockReason,
+    pub server: Option<String>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum UncertainReason {
+    /// A connection that could accept input ended before emitting its marker.
+    ExitedBeforeMarker,
+    /// A server sent input after its marker.
+    LateAfterMarker,
+    /// Input was dropped by a full queue or for invalid content after the barrier closed.
+    DroppedSinceClose,
+}
+
+/// Why the outcome may be incomplete even when the barrier is drained.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Uncertainty {
+    pub reason: UncertainReason,
+    pub server: Option<String>,
+    pub generation: Option<u64>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ServerBarrier {
+    pub name: String,
+    pub generation: u64,
+    pub pid: Option<u32>,
+    pub connection: ChannelConnection,
+    pub fence: ServerFence,
+    pub marker_seen: bool,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct HeldInput {
+    pub seq: u64,
+    pub server: String,
+    pub generation: u64,
+    /// The notification's content and meta, as the server sent them.
+    pub content: String,
+    pub meta: Option<Value>,
+    /// Returned to the queue after a turn that did not record it.
+    pub requeued: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum InFlightPath {
+    /// Steered into an active turn.
+    Steered,
+    /// Started its own turn.
+    Started,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct InFlightInput {
+    pub seq: u64,
+    pub server: String,
+    pub turn_id: String,
+    pub path: InFlightPath,
+}
+
+/// Notifications dropped since the thread started.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Dropped {
+    pub queue_full: u64,
+    pub invalid: u64,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum BarrierError {
+    /// The thread has no channel servers, or is gone.
+    NoChannels,
+    /// The barrier is closed under another fence id.
+    FenceMismatch { current: Option<String> },
+    /// The request needs a closed barrier.
+    FenceOpen,
+}
+
+impl fmt::Display for BarrierError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NoChannels => write!(f, "the thread has no channel servers"),
+            Self::FenceMismatch {
+                current: Some(current),
+            } => write!(f, "the channel barrier is closed under fence {current}"),
+            Self::FenceMismatch { current: None } => write!(f, "the channel barrier is open"),
+            Self::FenceOpen => write!(f, "the channel barrier is open"),
+        }
+    }
+}
+
+impl std::error::Error for BarrierError {}
+
+/// The state of a closed barrier, kept by the thread's channel worker.
+pub(crate) struct Fence {
+    pub(crate) id: String,
+    since_ms: i64,
+    /// Drops counted when the barrier closed.
+    dropped_at_close: u64,
+    /// The generation of each server when the barrier closed.
+    generation_at_close: HashMap<String, u64>,
+    /// For each server and generation seen while closed: whether its initialize carried this
+    /// fence closed, so that connection never accepted input.
+    started_closed: HashMap<String, BTreeMap<u64, bool>>,
+    /// Generations whose marker for this fence arrived.
+    markers: BTreeSet<(String, u64)>,
+    /// Generations that sent input after their marker.
+    late: BTreeSet<(String, u64)>,
+}
+
+impl Fence {
+    pub(crate) fn new(
+        id: String,
+        since_ms: i64,
+        servers: &[ChannelServerState],
+        dropped_at_close: u64,
+    ) -> Self {
+        let mut fence = Self {
+            id,
+            since_ms,
+            dropped_at_close,
+            generation_at_close: servers
+                .iter()
+                .map(|server| (server.server.clone(), server.generation))
+                .collect(),
+            started_closed: HashMap::new(),
+            markers: BTreeSet::new(),
+            late: BTreeSet::new(),
+        };
+        fence.observe(servers);
+        fence
+    }
+
+    /// Records the connections in `servers`. A connection is recorded once, when first seen.
+    pub(crate) fn observe(&mut self, servers: &[ChannelServerState]) {
+        for server in servers.iter().filter(|server| server.generation > 0) {
+            let started_closed = server
+                .init_fence
+                .as_ref()
+                .is_some_and(|init| init.closed && init.token.as_deref() == Some(self.id.as_str()));
+            self.started_closed
+                .entry(server.server.clone())
+                .or_default()
+                .entry(server.generation)
+                .or_insert(started_closed);
+        }
+    }
+
+    /// A marker for `token` from `server` over connection `generation`.
+    pub(crate) fn marker(&mut self, server: &str, generation: u64, token: &str) {
+        if token == self.id {
+            self.markers.insert((server.to_string(), generation));
+        }
+    }
+
+    /// Input from `server` over connection `generation`; notes it when it follows the marker.
+    pub(crate) fn input(&mut self, server: &str, generation: u64) {
+        let key = (server.to_string(), generation);
+        if self.markers.contains(&key) {
+            self.late.insert(key);
+        }
+    }
+
+    fn marker_seen(&self, server: &ChannelServerState) -> bool {
+        self.markers
+            .contains(&(server.server.clone(), server.generation))
+    }
+
+    fn blocks(&self, server: &ChannelServerState) -> Option<BlockReason> {
+        if server.generation == 0 {
+            return None;
+        }
+        match server.connection {
+            ChannelConnection::Launching => Some(BlockReason::Launching),
+            ChannelConnection::Recovering => Some(BlockReason::Recovering),
+            ChannelConnection::GaveUp => Some(BlockReason::GaveUp),
+            ChannelConnection::FencedWaiting | ChannelConnection::Closed => None,
+            ChannelConnection::Ready => match server.fence {
+                ServerFence::Failed(_) => Some(BlockReason::Failed),
+                ServerFence::Unsupported => Some(BlockReason::Unsupported),
+                _ if !self.marker_seen(server) => Some(BlockReason::MarkerPending),
+                _ => None,
+            },
+        }
+    }
+
+    /// Connections of `server`, since the barrier closed, that ended without their marker and
+    /// may have accepted input.
+    fn ended_without_marker(&self, server: &ChannelServerState) -> Vec<u64> {
+        let first = self
+            .generation_at_close
+            .get(&server.server)
+            .copied()
+            .unwrap_or(0)
+            .max(1);
+        let started_closed = self.started_closed.get(&server.server);
+        (first..=server.generation)
+            .filter(|generation| {
+                *generation < server.generation || server.connection != ChannelConnection::Ready
+            })
+            .filter(|generation| {
+                !self.markers.contains(&(server.server.clone(), *generation))
+                    && !started_closed
+                        .and_then(|generations| generations.get(generation))
+                        .copied()
+                        .unwrap_or(false)
+            })
+            .collect()
+    }
+}
+
+/// What the worker knows besides the servers: its queues and drop counters.
+pub(crate) struct QueueView {
+    pub(crate) held: Vec<HeldInput>,
+    pub(crate) in_flight: Vec<InFlightInput>,
+    pub(crate) dropped: Dropped,
+}
+
+/// Builds the snapshot. `dropped_upstream` counts drops before the worker's queue.
+pub(crate) fn snapshot(
+    fence: Option<&Fence>,
+    servers: &[ChannelServerState],
+    queue: QueueView,
+    dropped_upstream: u64,
+) -> ChannelBarrier {
+    let dropped = Dropped {
+        queue_full: queue.dropped.queue_full + dropped_upstream,
+        invalid: queue.dropped.invalid,
+    };
+    let server_barriers = servers
+        .iter()
+        .map(|server| ServerBarrier {
+            name: server.server.clone(),
+            generation: server.generation,
+            pid: server.pid,
+            connection: server.connection,
+            fence: server.fence.clone(),
+            marker_seen: fence.is_some_and(|fence| fence.marker_seen(server)),
+        })
+        .collect();
+    let mut blocked_by = Vec::new();
+    let mut uncertain = Vec::new();
+    if let Some(fence) = fence {
+        for server in servers {
+            if let Some(reason) = fence.blocks(server) {
+                blocked_by.push(Block {
+                    reason,
+                    server: Some(server.server.clone()),
+                });
+            }
+            uncertain.extend(
+                fence
+                    .ended_without_marker(server)
+                    .into_iter()
+                    .map(|generation| Uncertainty {
+                        reason: UncertainReason::ExitedBeforeMarker,
+                        server: Some(server.server.clone()),
+                        generation: Some(generation),
+                    }),
+            );
+        }
+        uncertain.extend(fence.late.iter().map(|(server, generation)| Uncertainty {
+            reason: UncertainReason::LateAfterMarker,
+            server: Some(server.clone()),
+            generation: Some(*generation),
+        }));
+        if dropped.queue_full + dropped.invalid > fence.dropped_at_close {
+            uncertain.push(Uncertainty {
+                reason: UncertainReason::DroppedSinceClose,
+                server: None,
+                generation: None,
+            });
+        }
+        if !queue.in_flight.is_empty() {
+            blocked_by.push(Block {
+                reason: BlockReason::InFlight,
+                server: None,
+            });
+        }
+    }
+    ChannelBarrier {
+        closed: fence.is_some(),
+        fence_id: fence.map(|fence| fence.id.clone()),
+        since_ms: fence.map(|fence| fence.since_ms),
+        drained: fence.is_some() && blocked_by.is_empty(),
+        blocked_by,
+        uncertain,
+        servers: server_barriers,
+        held: queue.held,
+        in_flight: queue.in_flight,
+        dropped,
+    }
+}
+
