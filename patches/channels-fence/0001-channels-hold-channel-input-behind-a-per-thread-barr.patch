+use codex_mcp::ChannelConnection;
+use codex_mcp::ChannelServerState;
+use codex_mcp::InitFence;
+use codex_mcp::ServerFence;
+use pretty_assertions::assert_eq;
+
+use super::Block;
+use super::BlockReason;
+use super::Dropped;
+use super::Fence;
+use super::InFlightInput;
+use super::InFlightPath;
+use super::QueueView;
+use super::UncertainReason;
+use super::Uncertainty;
+use super::snapshot;
+
+const ID: &str = "fence-1";
+
+fn server(
+    generation: u64,
+    connection: ChannelConnection,
+    fence: ServerFence,
+    started_closed: bool,
+) -> ChannelServerState {
+    ChannelServerState {
+        server: "srv".to_string(),
+        generation,
+        pid: Some(42),
+        connection,
+        init_fence: Some(InitFence {
+            closed: started_closed,
+            token: started_closed.then(|| ID.to_string()),
+        }),
+        fence,
+    }
+}
+
+fn ready(generation: u64) -> ChannelServerState {
+    server(
+        generation,
+        ChannelConnection::Ready,
+        ServerFence::Acknowledged,
+        false,
+    )
+}
+
+fn empty() -> QueueView {
+    QueueView {
+        held: Vec::new(),
+        in_flight: Vec::new(),
+        dropped: Dropped::default(),
+    }
+}
+
+fn blocked(reason: BlockReason) -> Vec<Block> {
+    vec![Block {
+        reason,
+        server: Some("srv".to_string()),
+    }]
+}
+
+fn exited(generation: u64) -> Uncertainty {
+    Uncertainty {
+        reason: UncertainReason::ExitedBeforeMarker,
+        server: Some("srv".to_string()),
+        generation: Some(generation),
+    }
+}
+
+#[test]
+fn an_open_barrier_blocks_nothing_and_is_not_drained() {
+    let barrier = snapshot(None, &[ready(1)], empty(), 0);
+    assert!(!barrier.closed);
+    assert!(!barrier.drained);
+    assert_eq!(barrier.fence_id, None);
+    assert!(barrier.blocked_by.is_empty());
+    assert!(barrier.uncertain.is_empty());
+    assert!(!barrier.servers[0].marker_seen);
+}
+
+#[test]
+fn the_current_connection_drains_with_its_own_marker_for_this_fence() {
+    let servers = [ready(1)];
+    let mut fence = Fence::new(ID.to_string(), 7, &servers, 0);
+    let barrier = snapshot(Some(&fence), &servers, empty(), 0);
+    assert_eq!(barrier.blocked_by, blocked(BlockReason::MarkerPending));
+    assert!(!barrier.drained);
+
+    fence.marker("srv", 1, "fence-other");
+    fence.marker("srv", 0, ID);
+    let barrier = snapshot(Some(&fence), &servers, empty(), 0);
+    assert_eq!(barrier.blocked_by, blocked(BlockReason::MarkerPending));
+
+    fence.marker("srv", 1, ID);
+    let barrier = snapshot(Some(&fence), &servers, empty(), 0);
+    assert!(barrier.closed);
+    assert!(barrier.drained);
+    assert_eq!(barrier.fence_id.as_deref(), Some(ID));
+    assert_eq!(barrier.since_ms, Some(7));
+    assert!(barrier.servers[0].marker_seen);
+    assert!(barrier.uncertain.is_empty());
+}
+
+#[test]
+fn a_connection_that_ended_without_its_marker_makes_the_outcome_uncertain() {
+    let mut fence = Fence::new(ID.to_string(), 0, &[ready(1)], 0);
+    let restarted = server(2, ChannelConnection::Ready, ServerFence::Acknowledged, true);
+    fence.observe(&[restarted.clone()]);
+    fence.marker("srv", 2, ID);
+
+    let barrier = snapshot(Some(&fence), &[restarted], empty(), 0);
+    assert!(barrier.drained);
+    assert_eq!(barrier.uncertain, vec![exited(1)]);
+}
+
+#[test]
+fn connections_started_closed_need_no_marker_and_unseen_ones_are_uncertain() {
+    let mut fence = Fence::new(ID.to_string(), 0, &[ready(1)], 0);
+    fence.marker("srv", 1, ID);
+    fence.observe(&[server(
+        2,
+        ChannelConnection::Ready,
+        ServerFence::Requested,
+        true,
+    )]);
+    fence.marker("srv", 4, ID);
+
+    let barrier = snapshot(Some(&fence), &[ready(4)], empty(), 0);
+    assert!(barrier.drained);
+    assert_eq!(barrier.uncertain, vec![exited(3)]);
+}
+
+#[test]
+fn a_live_unsupported_server_blocks_and_a_gone_one_is_uncertain() {
+    let live = server(1, ChannelConnection::Ready, ServerFence::Unsupported, false);
+    let fence = Fence::new(ID.to_string(), 0, &[live.clone()], 0);
+    let barrier = snapshot(Some(&fence), &[live], empty(), 0);
+    assert_eq!(barrier.blocked_by, blocked(BlockReason::Unsupported));
+    assert!(barrier.uncertain.is_empty());
+
+    let gone = server(
+        1,
+        ChannelConnection::FencedWaiting,
+        ServerFence::Unsupported,
+        false,
+    );
+    let barrier = snapshot(Some(&fence), &[gone], empty(), 0);
+    assert!(barrier.drained);
+    assert_eq!(barrier.uncertain, vec![exited(1)]);
+}
+
+#[test]
+fn connection_states_that_may_still_admit_input_block_the_drain() {
+    for (connection, fence_state, reason) in [
+        (
+            ChannelConnection::Launching,
+            ServerFence::Requested,
+            Some(BlockReason::Launching),
+        ),
+        (
+            ChannelConnection::Recovering,
+            ServerFence::Requested,
+            Some(BlockReason::Recovering),
+        ),
+        (
+            ChannelConnection::GaveUp,
+            ServerFence::Requested,
+            Some(BlockReason::GaveUp),
+        ),
+        (
+            ChannelConnection::Ready,
+            ServerFence::Failed("closed".to_string()),
+            Some(BlockReason::Failed),
+        ),
+        (ChannelConnection::Closed, ServerFence::Acknowledged, None),
+        (
+            ChannelConnection::FencedWaiting,
+            ServerFence::Acknowledged,
+            None,
+        ),
+    ] {
+        let state = server(1, connection, fence_state, false);
+        let mut fence = Fence::new(ID.to_string(), 0, &[state.clone()], 0);
+        fence.marker("srv", 1, ID);
+        let barrier = snapshot(Some(&fence), &[state], empty(), 0);
+        assert_eq!(
+            barrier.blocked_by,
+            reason.map(blocked).unwrap_or_default(),
+            "{connection:?}"
+        );
+    }
+}
+
+#[test]
+fn a_server_that_never_connected_is_ignored() {
+    let never = server(
+        0,
+        ChannelConnection::FencedWaiting,
+        ServerFence::Open,
+        false,
+    );
+    let fence = Fence::new(ID.to_string(), 0, &[never.clone()], 0);
+    let barrier = snapshot(Some(&fence), &[never], empty(), 0);
+    assert!(barrier.drained);
+    assert!(barrier.uncertain.is_empty());
+}
+
+#[test]
+fn input_after_the_marker_and_new_drops_are_uncertain() {
+    let servers = [ready(1)];
+    let mut fence = Fence::new(ID.to_string(), 0, &servers, 3);
+    fence.input("srv", 1);
+    fence.marker("srv", 1, ID);
+    fence.input("srv", 1);
+
+    let view = QueueView {
+        dropped: Dropped {
+            queue_full: 1,
