 # notification. The `emit` tool sends notifications from inside a tool call. Startup, the
 # received `initialize` params, sent notifications and tool calls are appended to the record
 # file as JSON lines. Standard library only; runs on Python 3.10 or later.
+#
+# The server supports the `channel/fence` request. While fenced it emits nothing from the inbox
+# and records those lines as rejected. Lines in the backlog file (the inbox path with a
+# `.backlog` suffix) stand for input accepted before the fence: a fence request emits them, then
+# the marker, then answers. A client whose `initialize` carries a closed fence starts it fenced.
 
 import argparse
 import json
@@ -16,6 +21,7 @@ from pathlib import Path
 
 CHANNEL_METHOD = "notifications/claude/channel"
 CHANNEL_CAPABILITY = "claude/channel"
+FENCE_METHOD = "channel/fence"
 POLL_SECONDS = 0.05
 METHOD_NOT_FOUND = -32601
 EMPTY_RESULTS = {
@@ -43,6 +49,10 @@ class FakeChannelServer:
         self.capability = capability
         self.lock = threading.Lock()
         self.initialized = threading.Event()
+        self.backlog = inbox.with_suffix(".backlog")
+        # Held while deciding whether input is emitted, so a fence cannot pass a line being sent.
+        self.gate = threading.Lock()
+        self.fenced = False
 
     def send(self, message: dict) -> None:
         line = json.dumps({"jsonrpc": "2.0", **message}) + "\n"
@@ -60,9 +70,13 @@ class FakeChannelServer:
         self.log("notification", params=params)
 
     def initialize_result(self, params: dict) -> dict:
+        experimental = (params.get("capabilities") or {}).get("experimental") or {}
+        client_fence = experimental.get(FENCE_METHOD) or {}
+        with self.gate:
+            self.fenced = bool(client_fence.get("closed"))
         capabilities: dict = {"tools": {}}
         if self.capability:
-            capabilities["experimental"] = {CHANNEL_CAPABILITY: {}}
+            capabilities["experimental"] = {CHANNEL_CAPABILITY: {}, FENCE_METHOD: {}}
         return {
             "protocolVersion": params.get("protocolVersion", "2025-06-18"),
             "capabilities": capabilities,
@@ -77,10 +91,26 @@ class FakeChannelServer:
             self.notify(message)
         return {"content": [{"type": "text", "text": f"sent {len(messages)}"}]}
 
+    def fence(self, params: dict) -> dict:
+        self.log("fence", params=params)
+        with self.gate:
+            self.fenced = bool(params.get("closed"))
+            if not self.fenced:
+                return {}
+            lines = self.backlog.read_text(encoding="utf-8").splitlines() if self.backlog.exists() else []
+            self.backlog.unlink(missing_ok=True)
+            for line in lines:
+                if line.strip():
+                    self.notify(json.loads(line))
+            self.notify({"content": "", "meta": {"fence": params.get("token")}})
+        return {}
+
     def result_for(self, method: str, params: dict) -> dict | None:
         if method == "initialize":
             self.log("initialize", params=params)
             return self.initialize_result(params)
+        if method == FENCE_METHOD:
+            return self.fence(params)
         if method == "tools/list":
             return {"tools": [EMIT_TOOL]}
         if method == "tools/call":
@@ -102,6 +132,13 @@ class FakeChannelServer:
             return
         self.send({"id": message["id"], "result": result})
 
+    def offer(self, params: object) -> None:
+        with self.gate:
+            if self.fenced:
+                self.log("rejected", params=params)
+                return
+            self.notify(params)
+
     def watch_inbox(self) -> None:
         self.initialized.wait()
         offset = 0
@@ -110,7 +147,7 @@ class FakeChannelServer:
             end = data.rfind(b"\n", offset) + 1
             for line in data[offset:end].splitlines():
                 if line.strip():
