@@ -0,0 +1,416 @@
+//! The channel barrier over a server that supports `channel/fence`: input the server accepted
+//! before the fence is held, never reaches the model while the barrier is closed, and is either
+//! released by the caller or delivered when the barrier opens.
+
+use anyhow::Result;
+use codex_app_server_protocol::ChannelBarrier;
+use codex_app_server_protocol::ChannelServerConnection;
+use codex_app_server_protocol::ChannelServerFence;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::JSONRPCError;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ThreadChannelsFenceParams;
+use codex_app_server_protocol::ThreadChannelsFenceResponse;
+use codex_app_server_protocol::ThreadChannelsReadParams;
+use codex_app_server_protocol::ThreadChannelsReadResponse;
+use codex_app_server_protocol::ThreadChannelsReleaseParams;
+use codex_app_server_protocol::ThreadChannelsReleaseResponse;
+use core_test_support::skip_if_no_network;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use tokio::time::Instant;
+use tokio::time::sleep;
+use tokio::time::timeout;
+
+use super::CHANNEL;
+use super::Harness;
+use super::POLL_INTERVAL;
+use super::QUIET_PERIOD;
+use super::READ_TIMEOUT;
+
+const WAIT_DRAINED_MS: i64 = 20_000;
+
+impl Harness {
+    /// Input the server accepted and has not emitted yet; a fence request emits it first.
+    fn accept_before_fence(&self, name: &str, params: &[Value]) -> Result<()> {
+        let backlog = self.server(name).inbox.with_extension("backlog");
+        let mut lines = String::new();
+        for line in params {
+            lines.push_str(&serde_json::to_string(line)?);
+            lines.push('\n');
+        }
+        std::fs::write(backlog, lines)?;
+        Ok(())
+    }
+
+    async fn fence(
+        &mut self,
+        closed: bool,
+        expected_fence_id: Option<String>,
+        discard_seqs: Option<Vec<i64>>,
+    ) -> Result<ChannelBarrier> {
+        let thread_id = self.thread_id.clone();
+        let response: ThreadChannelsFenceResponse = self
+            .app
+            .request(|request_id| ClientRequest::ThreadChannelsFence {
+                request_id,
+                params: ThreadChannelsFenceParams {
+                    thread_id,
+                    closed,
+                    expected_fence_id,
+                    discard_seqs,
+                },
+            })
+            .await?;
+        Ok(response.barrier)
+    }
+
+    async fn read_barrier(&mut self, wait_drained_ms: Option<i64>) -> Result<ChannelBarrier> {
+        let thread_id = self.thread_id.clone();
+        let response: ThreadChannelsReadResponse = self
+            .app
+            .request(|request_id| ClientRequest::ThreadChannelsRead {
+                request_id,
+                params: ThreadChannelsReadParams {
+                    thread_id,
+                    wait_drained_ms,
+                },
+            })
+            .await?;
+        Ok(response.barrier)
+    }
+
+    async fn release(&mut self, fence_id: String, through_seq: i64) -> Result<ChannelBarrier> {
+        let thread_id = self.thread_id.clone();
+        let response: ThreadChannelsReleaseResponse = self
+            .app
+            .request(|request_id| ClientRequest::ThreadChannelsRelease {
+                request_id,
+                params: ThreadChannelsReleaseParams {
+                    thread_id,
+                    fence_id,
+                    through_seq,
+                },
+            })
+            .await?;
+        Ok(response.barrier)
+    }
+
+    /// The `data.reason` of the error answering `method` with `params`.
+    async fn error_reason(&mut self, method: &str, params: Value) -> Result<Value> {
+        Ok(self.error_data(method, params).await?["reason"].clone())
+    }
+
+    /// The `data` of the error answering `method` with `params`.
+    async fn error_data(&mut self, method: &str, params: Value) -> Result<Value> {
+        Ok(self
+            .error(method, params)
+            .await?
+            .data
+            .unwrap_or(Value::Null))
+    }
+
+    /// The error answering `method` with `params`.
+    async fn error(&mut self, method: &str, params: Value) -> Result<JSONRPCErrorError> {
+        let request_id = self.app.send_request(method, Some(params)).await?;
+        let error: JSONRPCError = timeout(
+            READ_TIMEOUT,
+            self.app
+                .read_stream_until_error_message(RequestId::Integer(request_id)),
+        )
+        .await??;
+        Ok(error.error)
+    }
+
+    async fn wait_for_requests(&self, count: usize) -> Result<()> {
+        let deadline = Instant::now() + READ_TIMEOUT;
+        while self.requests().await.len() < count {
+            anyhow::ensure!(
+                Instant::now() < deadline,
+                "fewer than {count} model requests within {READ_TIMEOUT:?}"
+            );
+            sleep(POLL_INTERVAL).await;
+        }
+        Ok(())
+    }
+
+    /// Kills the server's process and returns the `initialize` params of the process Codex
+    /// launches in its place.
+    #[cfg(unix)]
+    async fn restart_server(&self, name: &str) -> Result<Value> {
+        let server = self.server(name);
+        let start = server.records("start")?;
+        let pid = start
+            .last()
+            .and_then(|start| start["pid"].as_i64())
+            .ok_or_else(|| anyhow::anyhow!("server `{name}` has not started"))?;
+        let pid = i32::try_from(pid)?;
+        let initialized = server.records("initialize")?.len();
+        // SAFETY: the signal only targets the fixture process the test started.
+        let killed = unsafe { libc::kill(pid, libc::SIGKILL) };
+        anyhow::ensure!(killed == 0, "could not kill the server process {pid}");
+        let deadline = Instant::now() + READ_TIMEOUT;
+        loop {
+            if let Some(initialize) = server.records("initialize")?.get(initialized) {
+                return Ok(initialize["params"].clone());
+            }
+            anyhow::ensure!(
+                Instant::now() < deadline,
+                "server `{name}` was not relaunched within {READ_TIMEOUT:?}"
+            );
+            sleep(POLL_INTERVAL).await;
+        }
+    }
+
+    /// Waits until the server has been asked to accept input again, so new input is not refused.
+    async fn wait_for_server_reopened(&self, name: &str) -> Result<()> {
+        let deadline = Instant::now() + READ_TIMEOUT;
+        while !self
+            .server(name)
+            .records("fence")?
+            .iter()
+            .any(|record| record["params"]["closed"] == json!(false))
+        {
+            anyhow::ensure!(
+                Instant::now() < deadline,
+                "server `{name}` was not reopened within {READ_TIMEOUT:?}"
+            );
+            sleep(POLL_INTERVAL).await;
+        }
+        Ok(())
+    }
+
+    /// Closes the barrier and waits until it is drained.
+    async fn close_and_drain(&mut self) -> Result<(String, ChannelBarrier)> {
+        let closed = self.fence(true, None, None).await?;
+        let fence_id = closed
+            .fence_id
+            .clone()
+            .ok_or_else(|| anyhow::anyhow!("a closed barrier has a fence id"))?;
+        let barrier = self.read_barrier(Some(WAIT_DRAINED_MS)).await?;
+        anyhow::ensure!(barrier.drained, "the barrier did not drain: {barrier:?}");
+        Ok((fence_id, barrier))
+    }
+
+    /// Reads the barrier until every server has acknowledged the fence. The marker that drains
+    /// the barrier and the answer to `channel/fence` reach Codex on different paths, so a
+    /// drained barrier can still show a fence as requested for a moment.
+    async fn wait_for_fence_acknowledged(&mut self) -> Result<ChannelBarrier> {
+        let deadline = Instant::now() + READ_TIMEOUT;
+        loop {
+            let barrier = self.read_barrier(None).await?;
+            if barrier
+                .servers
+                .iter()
+                .all(|server| server.fence == ChannelServerFence::Acknowledged)
+            {
+                return Ok(barrier);
+            }
+            anyhow::ensure!(
+                Instant::now() < deadline,
+                "the fence was not acknowledged within {READ_TIMEOUT:?}: {barrier:?}"
+            );
+            sleep(POLL_INTERVAL).await;
+        }
+    }
+}
+
+fn held_contents(barrier: &ChannelBarrier) -> Vec<&str> {
+    barrier
+        .held
+        .iter()
+        .map(|input| input.content.as_str())
+        .collect()
+}
+
+#[tokio::test]
+async fn input_accepted_before_the_fence_is_held_and_released_without_reaching_the_model()
+-> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = Harness::start(&[CHANNEL]).await?;
+    harness.accept_before_fence("chan", &[json!({ "content": "accepted before" })])?;
+
+    let (fence_id, _) = harness.close_and_drain().await?;
+    let barrier = harness.wait_for_fence_acknowledged().await?;
+    assert!(barrier.closed);
+    assert!(barrier.uncertain.is_empty(), "{barrier:?}");
+    assert_eq!(held_contents(&barrier), vec!["accepted before"]);
+    assert_eq!(barrier.servers.len(), 1);
+    assert_eq!(
+        barrier.servers[0].connection,
+        ChannelServerConnection::Ready
+    );
+    assert_eq!(barrier.servers[0].fence, ChannelServerFence::Acknowledged);
+    assert!(barrier.servers[0].marker_seen);
+
+    // Input arriving at the fenced server is refused there, and control keeps working.
+    harness
+        .server("chan")
+        .push(&[json!({ "content": "after the fence" })])?;
+    harness.start_user_turn("write the notes").await?;
+    harness.wait_for_requests(1).await?;
+    sleep(QUIET_PERIOD).await;
+    harness.assert_never_delivered("accepted before").await;
+    harness.assert_never_delivered("after the fence").await;
+    assert_eq!(harness.server("chan").records("rejected")?.len(), 1);
+
+    let seq = barrier.held[0].seq;
+    for _ in 0..2 {
+        let released = harness.release(fence_id.clone(), seq).await?;
+        assert!(released.held.is_empty());
+        assert!(released.drained);
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn opening_the_barrier_delivers_the_held_input_it_does_not_discard() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = Harness::start(&[CHANNEL]).await?;
+    harness.accept_before_fence(
+        "chan",
+        &[
+            json!({ "content": "held for later" }),
+            json!({ "content": "kept by the caller" }),
+        ],
+    )?;
+    let (fence_id, barrier) = harness.close_and_drain().await?;
+    assert_eq!(
+        held_contents(&barrier),
+        vec!["held for later", "kept by the caller"]
+    );
+    sleep(QUIET_PERIOD).await;
+    harness.assert_never_delivered("held for later").await;
+
+    let kept = barrier.held[1].seq;
+    let opened = harness
+        .fence(false, Some(fence_id.clone()), Some(vec![kept]))
+        .await?;
+    assert!(!opened.closed);
+    // A retried opening with other discardSeqs has no effect: what it lists is still delivered.
+    let retried = harness
+        .fence(false, Some(fence_id), Some(vec![barrier.held[0].seq]))
+        .await?;
+    assert!(!retried.closed);
+    harness.wait_for_delivery("chan", "held for later").await?;
+
+    harness.wait_for_server_reopened("chan").await?;
+    harness
+        .server("chan")
+        .push(&[json!({ "content": "open again" })])?;
+    harness.wait_for_delivery("chan", "open again").await?;
+    harness.assert_never_delivered("kept by the caller").await;
+    Ok(())
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn discarded_input_is_never_delivered_even_if_the_server_restarts() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = Harness::start_with(super::HarnessOptions {
+        specs: &[CHANNEL],
+        features: &[],
+        preloaded: &[],
+        restart_on_exit: &["chan"],
+    })
+    .await?;
+    harness.accept_before_fence(
+        "chan",
+        &[
+            json!({ "content": "delivered on reopening" }),
+            json!({ "content": "discarded by the caller" }),
+        ],
+    )?;
+    let (fence_id, barrier) = harness.close_and_drain().await?;
+    let discarded = barrier.held[1].seq;
+    let generation = barrier.servers[0].generation;
+
+    // The relaunched server starts fenced, and the held input keeps its sequence numbers.
+    let initialize = harness.restart_server("chan").await?;
+    assert_eq!(
+        initialize["capabilities"]["experimental"]["channel/fence"],
+        json!({ "closed": true, "token": fence_id })
+    );
+    let restarted = harness.read_barrier(Some(WAIT_DRAINED_MS)).await?;
+    assert!(restarted.drained, "{restarted:?}");
+    assert!(restarted.uncertain.is_empty(), "{restarted:?}");
+    assert_eq!(restarted.servers[0].generation, generation + 1);
+    assert_eq!(restarted.held, barrier.held);
+
+    let opened = harness
+        .fence(false, Some(fence_id), Some(vec![discarded]))
+        .await?;
+    assert!(!opened.closed);
+    harness
+        .wait_for_delivery("chan", "delivered on reopening")
+        .await?;
+    harness.wait_for_server_reopened("chan").await?;
+    harness
+        .server("chan")
+        .push(&[json!({ "content": "after reopening" })])?;
+    harness.wait_for_delivery("chan", "after reopening").await?;
+    sleep(QUIET_PERIOD).await;
+    harness
+        .assert_never_delivered("discarded by the caller")
+        .await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn barrier_requests_report_why_they_are_refused() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = Harness::start(&[CHANNEL]).await?;
+    let thread_id = harness.thread_id.clone();
+
+    let reason = harness
+        .error_reason(
+            "thread/channels/release",
+            json!({ "threadId": thread_id, "fenceId": "fence-none", "throughSeq": 0 }),
+        )
+        .await?;
+    assert_eq!(reason, json!("fenceOpen"));
+    // Nothing was opened under this id, for example before a restart: the fence is gone.
+    let data = harness
+        .error_data(
+            "thread/channels/fence",
+            json!({ "threadId": thread_id, "closed": false, "expectedFenceId": "fence-none" }),
+        )
+        .await?;
+    assert_eq!(data, json!({ "reason": "fenceMismatch", "current": null }));
+    let error = harness
+        .error(
+            "thread/channels/fence",
+            json!({ "threadId": thread_id, "closed": true, "discardSeqs": [0] }),
+        )
+        .await?;
+    assert_eq!(error.code, -32602);
+
+    let (fence_id, _) = harness.close_and_drain().await?;
+    let reason = harness
+        .error_reason(
+            "thread/channels/fence",
+            json!({ "threadId": thread_id, "closed": false, "expectedFenceId": "fence-stale" }),
+        )
+        .await?;
+    assert_eq!(reason, json!("fenceMismatch"));
+    let reason = harness
+        .error_reason(
+            "thread/channels/fence",
+            json!({ "threadId": thread_id, "closed": false }),
+        )
+        .await?;
+    assert_eq!(reason, json!("fenceMismatch"));
+    let still = harness.read_barrier(None).await?;
+    assert_eq!(still.fence_id, Some(fence_id));
+
+    let reason = harness
+        .error_reason(
+            "thread/channels/read",
+            json!({ "threadId": "00000000-0000-0000-0000-000000000000" }),
+        )
+        .await?;
+    assert_eq!(reason, json!("threadNotFound"));
+    Ok(())
+}
