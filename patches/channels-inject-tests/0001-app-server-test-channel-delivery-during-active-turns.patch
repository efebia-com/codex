+    .await;
+    let turn = start_turn(&mut harness, "emit three notifications").await?;
+    assert_same_turn(&mut harness, &turn, &["first", "second", "third"]).await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn notifications_from_successive_tool_calls_keep_fifo_order() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = start(&[CHANNEL]).await?;
+    emit(&harness.model, "emit-a", &[json!({"content": "A"})]).await;
+    emit(&harness.model, "emit-b", &[json!({"content": "B"})]).await;
+    let turn = start_turn(&mut harness, "emit twice").await?;
+    assert_same_turn(&mut harness, &turn, &["A", "B"]).await?;
+    assert_eq!(harness.server("chan").records("tool_call")?.len(), 2);
+    Ok(())
+}
+
+#[tokio::test]
+async fn interrupted_unconfirmed_input_is_delivered_once_on_continue() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = start(&[CHANNEL]).await?;
+    delay_first_response(&harness, Duration::from_secs(20)).await;
+    let turn = start_turn(&mut harness, "start sampling").await?;
+    wait_for_requests(&harness, 1).await?;
+    harness
+        .server("chan")
+        .push(&[json!({"content": "survives interrupt"})])?;
+    // Interrupt only after the active turn accepted the batch. A sent notification alone
+    // could still be waiting locally, which would not exercise recovery of steered input.
+    let steered = harness
+        .app
+        .wait_for_matching_json_log_event(
+            "channel input accepted by the interrupted turn",
+            |event| {
+                event["fields"]["event.name"] == "channels.input_steered"
+                    && event["fields"]["thread_id"] == harness.thread_id
+                    && event["fields"]["turn_id"] == turn
+            },
+            READ_TIMEOUT,
+        )
+        .await?;
+    assert_eq!(steered["fields"]["count"], 1);
+    assert!(steered["fields"]["batch_id"].as_u64().is_some());
+    harness
+        .app
+        .interrupt_turn_and_wait_for_aborted(harness.thread_id.clone(), turn, READ_TIMEOUT)
+        .await?;
+    assert!(
+        harness
+            .requests()
+            .await
+            .iter()
+            .all(|request| channel_elements(request).is_empty()),
+        "the input must still be unconfirmed at interrupt"
+    );
+    let next_turn = start_turn(&mut harness, "continue").await?;
+    harness
+        .wait_for_delivery("chan", "survives interrupt")
+        .await?;
+    completed(&mut harness, &next_turn).await?;
+    sleep(QUIET_PERIOD).await;
+    let requests = harness.requests().await;
+    let last = requests.last().context("continued request")?;
+    assert_bodies(last, &["survives interrupt"]);
+    assert!(
+        last.message_input_texts("user")
+            .contains(&"continue".to_string())
+    );
+    assert_eq!(last.body_json()["client_metadata"]["turn_id"], next_turn);
+    Ok(())
+}
+
+#[tokio::test]
+async fn during_turn_input_survives_app_server_restart_and_thread_resume() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = start(&[CHANNEL]).await?;
+    emit(
+        &harness.model,
+        "emit-persist",
+        &[json!({"content": "persisted input"})],
+    )
+    .await;
+    let turn = start_turn(&mut harness, "emit persistent input").await?;
+    assert_same_turn(&mut harness, &turn, &["persisted input"]).await?;
+    let status = timeout(READ_TIMEOUT, harness.app.shutdown_gracefully()).await??;
+    assert!(status.success(), "app-server shutdown: {status}");
+    harness.app = TestAppServer::builder()
+        .with_codex_home(harness._home.path())
+        .build_initialized()
+        .await?;
+    let resume_id = harness
+        .app
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: harness.thread_id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let response: ThreadResumeResponse =
+        timeout(READ_TIMEOUT, harness.app.read_response(resume_id)).await??;
+    assert_eq!(response.thread.id, harness.thread_id);
+    harness.wait_for_server_ready("chan").await?;
+    let turn = start_turn(&mut harness, "after resume").await?;
+    completed(&mut harness, &turn).await?;
+    let requests = harness.requests().await;
+    let last = requests.last().context("request after resume")?;
+    assert_bodies(last, &["persisted input"]);
+    assert_after_output(last, "emit-persist", "persisted input");
+    assert!(
+        last.message_input_texts("user")
+            .contains(&"after resume".to_string())
+    );
+    assert_eq!(
+        harness.server("chan").sent_notifications()?.len(),
+        1,
+        "resume must not replay server notifications"
+    );
+    Ok(())
+}
