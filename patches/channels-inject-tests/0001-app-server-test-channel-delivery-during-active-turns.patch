+//! The additional per-server opt-in delivers channel input into the active root turn.
+
+use super::*;
+use codex_app_server_protocol::ThreadResumeParams;
+use codex_app_server_protocol::ThreadResumeResponse;
+use pretty_assertions::assert_eq;
+
+async fn start(specs: &[ServerSpec]) -> Result<Harness> {
+    let names: Vec<&str> = specs.iter().map(|spec| spec.name).collect();
+    start_with_opt_in(specs, &names).await
+}
+
+async fn start_with_opt_in(specs: &[ServerSpec], during_turn: &[&str]) -> Result<Harness> {
+    let model = responses::start_mock_server().await;
+    Mock::given(method("POST"))
+        .and(path_regex(".*/responses$"))
+        .respond_with(
+            responses::sse_response(responses::sse(vec![
+                responses::ev_response_created("resp-default"),
+                responses::ev_assistant_message("msg-default", "ok"),
+                responses::ev_completed("resp-default"),
+            ]))
+            .set_delay(Duration::from_millis(300)),
+        )
+        .with_priority(u8::MAX)
+        .mount(&model)
+        .await;
+    let home = TempDir::new()?;
+    let script = home.path().join("mcp_channels_server.py");
+    std::fs::write(&script, SERVER_SCRIPT)?;
+    let mut servers = BTreeMap::new();
+    let mut config = String::new();
+    for spec in specs {
+        let server = FakeServer {
+            name: spec.name,
+            inbox: home.path().join(format!("{}.inbox", spec.name)),
+            record: home.path().join(format!("{}.record", spec.name)),
+        };
+        config.push_str(&server_toml(spec, &script, &server)?);
+        if during_turn.contains(&spec.name) {
+            config.push_str("channel_during_turn = true\n");
+        }
+        servers.insert(spec.name, server);
+    }
+    MockResponsesConfig::new(&model.uri())
+        .with_extra_config(&config)
+        .write(home.path())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .with_json_logging("codex_channels_extension=debug")
+        .build_initialized()
+        .await?;
+    let ThreadStartResponse { thread, .. } = app
+        .start_thread(ThreadStartParams {
+            model: Some("mock-model".to_string()),
+            ..Default::default()
+        })
+        .await?;
+    let mut harness = Harness {
+        model,
+        app,
+        thread_id: thread.id,
+        servers,
+        _home: home,
+    };
+    for spec in specs {
+        harness.wait_for_server_ready(spec.name).await?;
+    }
+    Ok(harness)
+}
+
+async fn start_turn(harness: &mut Harness, text: &str) -> Result<String> {
+    let thread_id = harness.thread_id.clone();
+    let TurnStartResponse { turn } = harness
+        .app
+        .request(|request_id| ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
+                thread_id,
+                input: vec![V2UserInput::Text {
+                    text: text.to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            },
+        })
+        .await?;
+    Ok(turn.id)
+}
+
+async fn completed(harness: &mut Harness, turn_id: &str) -> Result<()> {
+    let thread_id = harness.thread_id.clone();
+    timeout(
+        READ_TIMEOUT,
+        harness.app.read_stream_until_matching_notification(
+            "the requested turn completed",
+            |notification| {
+                notification.method == "turn/completed"
+                    && notification.params.as_ref().is_some_and(|params| {
+                        params["threadId"] == thread_id && params["turn"]["id"] == turn_id
+                    })
+            },
+        ),
+    )
+    .await??;
+    Ok(())
+}
+
+async fn wait_for_requests(harness: &Harness, count: usize) -> Result<()> {
+    timeout(READ_TIMEOUT, async {
+        while harness.requests().await.len() < count {
+            sleep(POLL_INTERVAL).await;
+        }
+    })
+    .await
+    .context("model did not receive the expected request")?;
+    Ok(())
+}
+
+async fn emit(model: &MockServer, call_id: &str, messages: &[Value]) {
+    responses::mount_sse_once(
+        model,
+        responses::sse(vec![
+            responses::ev_response_created(call_id),
+            responses::ev_function_call_with_namespace(
+                call_id,
+                "mcp__chan",
+                "emit",
+                &json!({"messages": messages}).to_string(),
+            ),
+            responses::ev_completed(call_id),
+        ]),
+    )
+    .await;
+}
+
+async fn delay_first_response(harness: &Harness, delay: Duration) {
+    Mock::given(method("POST"))
+        .and(path_regex(".*/responses$"))
+        .respond_with(
+            responses::sse_response(responses::sse(vec![
+                responses::ev_response_created("resp-sampling"),
+                responses::ev_assistant_message("msg-sampling", "sampling complete"),
+                responses::ev_completed("resp-sampling"),
+            ]))
+            .set_delay(delay),
+        )
+        .up_to_n_times(1)
+        .mount(&harness.model)
+        .await;
+}
+
+fn assert_bodies(request: &ResponsesRequest, expected: &[&str]) {
+    assert_eq!(
+        channel_elements(request)
+            .iter()
+            .map(ChannelElement::body)
+            .collect::<Vec<_>>(),
+        expected,
+        "the full history must contain every channel input exactly once and in order"
+    );
+}
+
+async fn assert_same_turn(harness: &mut Harness, turn_id: &str, expected: &[&str]) -> Result<()> {
+    harness.wait_for_deliveries("chan", expected).await?;
+    completed(harness, turn_id).await?;
+    // Include an accidental queued turn in the observations, rather than deduplicating it.
+    sleep(QUIET_PERIOD).await;
+    let requests = harness.requests().await;
+    assert!(
+        requests.len() >= 2,
+        "delivery must cause a follow-up request"
+    );
+    assert!(channel_elements(&requests[0]).is_empty());
+    for request in &requests {
+        assert_eq!(
+            request.body_json()["client_metadata"]["turn_id"].as_str(),
+            Some(turn_id),
+            "a during-turn notification must not start a new turn"
+        );
+    }
+    assert_bodies(requests.last().context("last model request")?, expected);
+    // Every started event is retained by the typed request/notification helpers.
+    let started = timeout(
+        READ_TIMEOUT,
+        harness
+            .app
+            .read_stream_until_notification_message("turn/started"),
+    )
+    .await??;
+    assert_eq!(
+        started.params.context("turn/started params")?["turn"]["id"],
+        turn_id
+    );
+    assert!(
+        !harness
+            .app
+            .pending_notification_methods()
+            .iter()
+            .any(|method| method == "turn/started"),
+        "only the user turn may have started"
+    );
+    Ok(())
+}
+
+fn assert_after_output(request: &ResponsesRequest, call_id: &str, body: &str) {
+    let json = request.body_json();
+    let input = json["input"].as_array().expect("model input array");
+    let output = input
+        .iter()
+        .position(|item| item["type"] == "function_call_output" && item["call_id"] == call_id)
+        .expect("tool output in history");
+    let channel = input
+        .iter()
+        .position(|item| {
+            item["role"] == "user"
+                && item["content"].as_array().is_some_and(|parts| {
+                    parts.iter().any(|part| {
+                        part["text"].as_str().is_some_and(|text| {
+                            ChannelElement::parse(text)
+                                .is_some_and(|element| element.body() == body)
+                        })
+                    })
+                })
+        })
+        .expect("separate user message containing the channel input");
+    assert!(
+        output < channel,
+        "channel input must follow the tool output"
+    );
+}
+
+#[test_case::test_case(None; "channel_absent")]
+#[test_case::test_case(Some(false); "channel_false")]
+#[tokio::test]
+async fn during_turn_option_requires_channel_opt_in(channel: Option<bool>) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let specs = [
+        ServerSpec {
+            name: "plain",
+            channel,
+            capability: true,
+        },
+        CHANNEL,
+    ];
+    let harness = start(&specs).await?;
+    harness
+        .server("plain")
+        .push(&[json!({"content": "ignored during-turn-only"})])?;
+    harness
+        .server("chan")
+        .push(&[json!({"content": "control"})])?;
+    harness.wait_for_delivery("chan", "control").await?;
+    sleep(QUIET_PERIOD).await;
+    assert_eq!(harness.server("plain").sent_notifications()?.len(), 1);
+    harness
+        .assert_never_delivered("ignored during-turn-only")
+        .await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn during_turn_opt_in_is_per_server_and_idle_delivery_still_works() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let queued = ServerSpec {
+        name: "queued",
+        ..CHANNEL
+    };
+    let mut harness = start_with_opt_in(&[CHANNEL, queued], &["chan"]).await?;
+    delay_first_response(&harness, Duration::from_secs(3)).await;
+    let turn = start_turn(&mut harness, "mixed channel configuration").await?;
+    wait_for_requests(&harness, 1).await?;
+    harness
+        .server("chan")
+        .push(&[json!({"content": "active input"})])?;
+    harness
+        .server("queued")
+        .push(&[json!({"content": "queued input"})])?;
+    harness
+        .wait_for_deliveries("chan", &["active input", "queued input"])
+        .await?;
+    completed(&mut harness, &turn).await?;
+    let requests = harness.requests().await;
+    let active = requests
+        .iter()
+        .find(|request| {
+            channel_elements(request)
+                .iter()
+                .any(|element| element.body() == "active input")
+        })
+        .context("active delivery")?;
+    assert_eq!(active.body_json()["client_metadata"]["turn_id"], turn);
+    assert!(
+        !channel_elements(active)
+            .iter()
+            .any(|element| element.body() == "queued input")
+    );
+    let queued_request = requests
+        .iter()
+        .find(|request| {
+            channel_elements(request)
+                .iter()
+                .any(|element| element.body() == "queued input")
+        })
+        .context("queued delivery")?;
+    let queued_turn = queued_request.body_json()["client_metadata"]["turn_id"]
+        .as_str()
+        .context("queued turn id")?
+        .to_string();
+    assert_ne!(
+        queued_turn, turn,
+        "the server without the extra opt-in must wait for a new turn"
+    );
+    completed(&mut harness, &queued_turn).await?;
+    assert_bodies(
+        harness.requests().await.last().context("latest request")?,
+        &["active input", "queued input"],
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn tool_notification_reaches_the_same_turn_after_its_output() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = start(&[CHANNEL]).await?;
+    emit(
+        &harness.model,
+        "emit-one",
+        &[json!({"content": "during tool", "meta": {"chat_id": "x"}})],
+    )
+    .await;
+    let turn = start_turn(&mut harness, "emit a notification").await?;
+    assert_same_turn(&mut harness, &turn, &["during tool"]).await?;
+    let requests = harness.requests().await;
+    let first = requests
+        .iter()
+        .find(|request| !channel_elements(request).is_empty())
+        .context("channel request")?;
+    assert_after_output(first, "emit-one", "during tool");
+    assert!(
+        first.message_input_texts("user").contains(
+            &"<channel source=\"chan\" chat_id=\"x\">\nduring tool\n</channel>".to_string()
+        )
+    );
+    assert_eq!(harness.server("chan").records("tool_call")?.len(), 1);
+    Ok(())
+}
+
+#[tokio::test]
+async fn notification_during_sampling_continues_the_active_turn() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = start(&[CHANNEL]).await?;
+    delay_first_response(&harness, Duration::from_secs(3)).await;
+    let turn = start_turn(&mut harness, "wait for a notification").await?;
+    wait_for_requests(&harness, 1).await?;
+    harness
+        .server("chan")
+        .push(&[json!({"content": "during sampling"})])?;
+    assert_same_turn(&mut harness, &turn, &["during sampling"]).await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn notifications_from_one_tool_call_keep_fifo_order() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = start(&[CHANNEL]).await?;
+    emit(
+        &harness.model,
+        "emit-three",
+        &[
+            json!({"content": "first"}),
+            json!({"content": "second"}),
+            json!({"content": "third"}),
