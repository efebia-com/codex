+/// Confirmation can be emitted by the core before the steer submission returns to the worker.
+struct ConfirmingDelivery {
+    events: Arc<std::sync::OnceLock<mpsc::UnboundedSender<super::WorkerEvent>>>,
+    attempts: mpsc::UnboundedSender<&'static str>,
+}
+
+impl Delivery for ConfirmingDelivery {
+    fn deliver<'a>(&'a self, _texts: &'a [String]) -> ExtensionFuture<'a, DeliveryOutcome> {
+        Box::pin(async move {
+            self.attempts.send("idle").expect("attempts");
+            DeliveryOutcome::Delivered
+        })
+    }
+
+    fn steer<'a>(
+        &'a self,
+        _texts: &'a [String],
+        _turn: &'a str,
+        batch: u64,
+    ) -> ExtensionFuture<'a, DeliveryOutcome> {
+        Box::pin(async move {
+            self.events
+                .get()
+                .expect("events")
+                .send(super::WorkerEvent::Confirmed(batch))
+                .expect("worker alive");
+            self.attempts.send("steer").expect("attempts");
+            DeliveryOutcome::Delivered
+        })
+    }
+}
+
+#[tokio::test]
+async fn confirmation_during_submission_is_processed_before_abort_and_new_delivery() {
+    use super::WorkerEvent;
+
+    let events = Arc::new(std::sync::OnceLock::new());
+    let (sender, notifications) = mpsc::channel(4);
+    let (attempts, mut receiver) = mpsc::unbounded_channel();
+    let worker = Worker::spawn(
+        notifications,
+        Arc::new(ConfirmingDelivery {
+            events: Arc::clone(&events),
+            attempts,
+        }),
+        HashSet::from(["srv".to_string()]),
+    );
+    assert!(events.set(worker.events.clone()).is_ok());
+    worker.event(WorkerEvent::TurnStarted("turn".to_string()));
+    sender
+        .send(event("already recorded"))
+        .await
+        .expect("notification");
+    assert_eq!(
+        timeout(WAIT, receiver.recv()).await.expect("attempt"),
+        Some("steer")
+    );
+    worker.event(WorkerEvent::TurnEnded {
+        turn_id: "turn".to_string(),
+        aborted: true,
+    });
+    worker.wake();
+    assert!(
+        timeout(Duration::from_millis(200), receiver.recv())
+            .await
+            .is_err()
+    );
+}
