+#[derive(Debug, PartialEq, Eq)]
+enum Attempt {
+    Idle(Vec<String>),
+    Steer {
+        texts: Vec<String>,
+        turn: String,
+        batch: u64,
+    },
+}
+
+struct SteeringDelivery {
+    accepted: bool,
+    idle: DeliveryOutcome,
+    attempts: Mutex<Vec<Attempt>>,
+}
+
+impl Delivery for SteeringDelivery {
+    fn deliver<'a>(&'a self, texts: &'a [String]) -> ExtensionFuture<'a, DeliveryOutcome> {
+        Box::pin(async move {
+            self.attempts
+                .lock()
+                .expect("attempts")
+                .push(Attempt::Idle(texts.to_vec()));
+            self.idle
+        })
+    }
+
+    fn steer<'a>(
+        &'a self,
+        texts: &'a [String],
+        turn: &'a str,
+        batch: u64,
+    ) -> ExtensionFuture<'a, DeliveryOutcome> {
+        Box::pin(async move {
+            self.attempts
+                .lock()
+                .expect("attempts")
+                .push(Attempt::Steer {
+                    texts: texts.to_vec(),
+                    turn: turn.to_string(),
+                    batch,
+                });
+            if self.accepted {
+                DeliveryOutcome::Delivered
+            } else {
+                DeliveryOutcome::Later
+            }
+        })
+    }
+}
+
+fn steering(accepted: bool) -> SteeringDelivery {
+    SteeringDelivery {
+        accepted,
+        idle: DeliveryOutcome::Later,
+        attempts: Mutex::new(Vec::new()),
+    }
+}
