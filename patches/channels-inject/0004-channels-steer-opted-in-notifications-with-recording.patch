+    /// Returns whether this event should attempt delivery. Interrupts never restart work.
+    fn event(&mut self, event: WorkerEvent) -> bool {
+        match event {
+            WorkerEvent::Wake => true,
+            WorkerEvent::TurnStarted(id) => {
+                self.active_turn = Some(id);
+                true
+            }
+            WorkerEvent::Confirmed(id) => {
+                self.in_flight.retain(|batch| batch.id != id);
+                false
+            }
+            WorkerEvent::TurnEnded { turn_id, aborted } => {
+                if self.active_turn.as_ref() != Some(&turn_id) {
+                    return false;
+                }
+                self.active_turn = None;
+                if aborted {
+                    let mut recovered: VecDeque<Item> = self
+                        .in_flight
+                        .drain(..)
+                        .flat_map(|batch| batch.items)
+                        .collect();
+                    recovered.append(&mut self.pending);
+                    self.pending = recovered;
+                } else {
+                    let count: usize = self.in_flight.iter().map(|batch| batch.items.len()).sum();
+                    if count > 0 {
+                        warn!(
+                            count,
+                            "discarding unconfirmed MCP channel input after turn completion"
+                        );
+                    }
+                    self.in_flight.clear();
+                }
+                false
+            }
+        }
+    }
+
+    async fn deliver(&mut self, delivery: &dyn Delivery) {
+        if self.pending.is_empty() {
+            return;
+        }
+        if let Some(turn_id) = &self.active_turn {
+            let items: Vec<Item> = self
+                .pending
+                .iter()
+                .filter(|item| item.during_turn)
+                .cloned()
+                .collect();
+            if !items.is_empty() {
+                let rendered: Vec<String> =
+                    items.iter().map(|item| item.rendered.clone()).collect();
+                let id = self.next_id;
+                self.next_id += 1;
+                if delivery.steer(&rendered, turn_id, id).await == DeliveryOutcome::Delivered {
+                    self.pending.retain(|item| !item.during_turn);
+                    self.in_flight.push(Batch { id, items });
+                    return;
+                }
+            }
+        }
+        // Preserve the original idle path: acceptance empties pending without confirmation.
+        let rendered: Vec<String> = self
+            .pending
+            .iter()
+            .map(|item| item.rendered.clone())
+            .collect();
+        if delivery.deliver(&rendered).await == DeliveryOutcome::Delivered {
+            self.pending.clear();
+        }
+    }
 }
 
