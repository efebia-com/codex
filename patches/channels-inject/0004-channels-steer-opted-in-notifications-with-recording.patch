+#[tokio::test]
+async fn active_turn_only_takes_opted_in_notifications_and_confirmation_releases_capacity() {
+    use super::Queue;
+    use super::WorkerEvent;
+
+    let delivery = steering(true);
+    let mut queue = Queue::default();
+    queue.event(WorkerEvent::TurnStarted("turn".to_string()));
+    queue.push(&event("queued"), false);
+    queue.push(&event("first"), true);
+    queue.push(&event("second"), true);
+    queue.deliver(&delivery).await;
+
+    assert_eq!(
+        *delivery.attempts.lock().expect("attempts"),
+        vec![Attempt::Steer {
+            texts: vec![rendered("first"), rendered("second")],
+            turn: "turn".to_string(),
+            batch: 0,
+        }]
+    );
+    assert_eq!(queue.pending.len(), 1);
+    assert_eq!(queue.len(), 3);
+    queue.event(WorkerEvent::Confirmed(99));
+    assert_eq!(queue.len(), 3);
+    queue.event(WorkerEvent::Confirmed(0));
+    assert_eq!(queue.len(), 1);
+    assert!(!queue.event(WorkerEvent::TurnEnded {
+        turn_id: "turn".to_string(),
+        aborted: true
+    }));
+    assert_eq!(queue.pending[0].rendered, rendered("queued"));
+}
