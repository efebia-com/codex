+#[tokio::test]
+async fn abort_recovers_unconfirmed_batches_before_newer_input_in_fifo_order() {
+    use super::Queue;
+    use super::WorkerEvent;
+
+    let delivery = steering(true);
+    let mut queue = Queue::default();
+    queue.event(WorkerEvent::TurnStarted("old".to_string()));
+    queue.push(&event("confirmed"), true);
+    queue.deliver(&delivery).await;
+    queue.event(WorkerEvent::Confirmed(0));
+    for text in ["first", "second"] {
+        queue.push(&event(text), true);
+        queue.deliver(&delivery).await;
+    }
+    queue.push(&event("newest"), true);
+    assert!(!queue.event(WorkerEvent::TurnEnded {
+        turn_id: "old".to_string(),
+        aborted: true
+    }));
+    assert!(queue.in_flight.is_empty());
+    assert!(queue.active_turn.is_none());
+    assert_eq!(queue.len(), 3);
+    queue.event(WorkerEvent::TurnStarted("next".to_string()));
+    queue.deliver(&delivery).await;
+    assert_eq!(
+        delivery.attempts.lock().expect("attempts").last(),
+        Some(&Attempt::Steer {
+            texts: vec![rendered("first"), rendered("second"), rendered("newest")],
+            turn: "next".to_string(),
+            batch: 3,
