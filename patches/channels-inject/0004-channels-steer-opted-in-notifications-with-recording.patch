+
+    fn steer<'a>(
+        &'a self,
+        notifications: &'a [String],
+        turn_id: &'a str,
+        batch_id: u64,
+    ) -> ExtensionFuture<'a, DeliveryOutcome> {
+        Box::pin(async move {
+            let Some(manager) = self.thread_manager.get().and_then(Weak::upgrade) else {
+                return DeliveryOutcome::Later;
+            };
+            let Ok(thread) = manager.get_thread(self.thread_id).await else {
+                return DeliveryOutcome::Later;
+            };
+            let mut request = request(notifications);
+            request
+                .user_input_extension_data
+                .insert("channels".to_string(), batch_id.into());
+            match thread.steer_turn(request, turn_id.to_string()).await {
+                Ok(SteerSubmission::Steered { .. }) => {
+                    debug!(
+                        event.name = "channels.input_steered",
+                        thread_id = %self.thread_id,
+                        turn_id,
+                        batch_id,
+                        count = notifications.len(),
+                        "MCP channel input accepted by the active turn"
+                    );
+                    DeliveryOutcome::Delivered
+                }
+                Ok(SteerSubmission::NotSubmitted { reason }) => {
+                    debug!(thread_id = %self.thread_id, ?reason, "MCP channel steer declined; trying idle delivery");
+                    DeliveryOutcome::Later
+                }
+                Err(error) => {
+                    warn!(thread_id = %self.thread_id, %error, "MCP channel steer failed; trying idle delivery");
+                    DeliveryOutcome::Later
+                }
+            }
+        })
+    }
