+/// A completed turn that did not record its input (for example, an input hook blocked it)
+/// does not get it again, so a blocking hook cannot cause a retry loop.
+fn discard(batches: Vec<Batch>) {
+    let count: usize = batches.iter().map(|batch| batch.items.len()).sum();
+    if count > 0 {
+        warn!(
+            count,
+            "discarding unconfirmed MCP channel input after turn completion"
+        );
+    }
