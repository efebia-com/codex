+    /// Only one regular turn runs at a time. Unconfirmed batches of another turn are settled:
+    /// a turn that never started recorded nothing, so its batches return to the queue; a turn
+    /// that started and ended unreported is treated like a completed turn.
+    fn turn_started(&mut self, turn_id: &str) {
+        let (mut current, earlier) = self.take_in_flight(|batch| batch.turn == turn_id);
+        for batch in &mut current {
+            batch.started = true;
+        }
+        self.in_flight = current;
+        let (never_started, ended): (Vec<Batch>, Vec<Batch>) =
+            earlier.into_iter().partition(|batch| !batch.started);
+        self.requeue(never_started);
+        discard(ended);
+    }
+
+    /// Splits the unconfirmed batches, in order, into those matching `select` and the rest.
+    fn take_in_flight(&mut self, select: impl Fn(&Batch) -> bool) -> (Vec<Batch>, Vec<Batch>) {
+        std::mem::take(&mut self.in_flight)
+            .into_iter()
+            .partition(|batch| select(batch))
+    }
+
+    /// Unconfirmed batches go back to the head of the queue, oldest first.
+    fn requeue(&mut self, batches: Vec<Batch>) {
+        if batches.is_empty() {
+            return;
+        }
+        let mut recovered: VecDeque<Item> =
+            batches.into_iter().flat_map(|batch| batch.items).collect();
+        recovered.append(&mut self.pending);
+        self.pending = recovered;
+    }
+
+    fn next_batch_id(&mut self) -> u64 {
+        let id = self.next_id;
+        self.next_id += 1;
+        id
+    }
