+
+    let delivery = idle("blocked by a hook");
+    let mut queue = Queue::default();
+    queue.push(&event("blocked"), false);
+    queue.deliver(&delivery).await;
+    queue.event(WorkerEvent::TurnStarted("blocked by a hook".to_string()));
+    queue.event(WorkerEvent::TurnEnded {
+        turn_id: "blocked by a hook".to_string(),
+        aborted: false,
+    });
+    assert_eq!(queue.len(), 0);
+    queue.deliver(&delivery).await;
+    assert_eq!(delivery.attempts.lock().expect("attempts").len(), 1);
+}
