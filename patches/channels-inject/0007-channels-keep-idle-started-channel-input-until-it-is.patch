+#[tokio::test]
+async fn idle_batches_wait_for_their_recording_confirmation() {
+    use super::Queue;
+    use super::WorkerEvent;
+
+    let delivery = idle("channel turn");
+    let mut queue = Queue::default();
+    queue.push(&event("one"), false);
+    queue.deliver(&delivery).await;
+    assert!(queue.pending.is_empty());
+    assert_eq!(queue.len(), 1);
+    assert!(queue.event(WorkerEvent::TurnStarted("channel turn".to_string())));
+    queue.event(WorkerEvent::Confirmed(0));
+    assert_eq!(queue.len(), 0);
+}
+
+#[tokio::test]
+async fn an_aborted_channel_turn_returns_its_unrecorded_batch_to_the_head_of_the_queue() {
+    use super::Queue;
+    use super::WorkerEvent;
+
+    let delivery = idle("channel turn");
+    let mut queue = Queue::default();
+    queue.push(&event("one"), false);
+    queue.deliver(&delivery).await;
+    queue.push(&event("two"), false);
+    queue.event(WorkerEvent::TurnStarted("channel turn".to_string()));
+    assert!(!queue.event(WorkerEvent::TurnEnded {
+        turn_id: "channel turn".to_string(),
+        aborted: true,
+    }));
+    assert!(queue.in_flight.is_empty());
+    let pending: Vec<&str> = queue
+        .pending
+        .iter()
+        .map(|item| item.rendered.as_str())
+        .collect();
+    assert_eq!(pending, vec![rendered("one"), rendered("two")]);
+}
+
+#[tokio::test]
+async fn a_batch_whose_turn_never_started_returns_when_another_turn_starts() {
+    use super::Queue;
+    use super::WorkerEvent;
+
+    let delivery = idle("cancelled before start");
+    let mut queue = Queue::default();
+    queue.push(&event("kept"), false);
+    queue.deliver(&delivery).await;
+    queue.event(WorkerEvent::TurnStarted("next".to_string()));
+    assert!(queue.in_flight.is_empty());
+    assert_eq!(queue.pending.len(), 1);
+    assert_eq!(queue.pending[0].rendered, rendered("kept"));
+    assert_eq!(queue.active_turn.as_deref(), Some("next"));
+}
+
+#[tokio::test]
+async fn a_completed_channel_turn_without_recording_does_not_replay_its_batch() {
+    use super::Queue;
