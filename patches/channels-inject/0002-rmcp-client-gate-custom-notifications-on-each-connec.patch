+/// Includes the handshake response so capability checks run at the transport boundary.
+fn scripted(declares: bool, notifications: Vec<CustomNotification>) -> anyhow::Result<Scripted> {
+    let experimental = if declares {
+        json!({ CAPABILITY: {} })
+    } else {
+        json!({})
+    };
+    let response = serde_json::from_value(json!({
+        "jsonrpc": "2.0", "id": 1, "result": {
+            "protocolVersion": "2025-06-18",
+            "capabilities": { "experimental": experimental },
+            "serverInfo": { "name": "test", "version": "1" }
+        }
+    }))?;
+    let mut messages = VecDeque::from([response]);
+    messages.extend(notifications.into_iter().map(|notification| {
+        JsonRpcMessage::notification(ServerNotification::CustomNotification(notification))
+    }));
+    Ok(Scripted(messages))
+}
+
+async fn initialize_transport(
+    transport: &mut impl Transport<RoleClient, Error = std::io::Error>,
+) -> anyhow::Result<()> {
+    transport
+        .send(serde_json::from_value(json!({
+            "jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {
+                "protocolVersion": "2025-06-18", "capabilities": {},
+                "clientInfo": { "name": "test", "version": "1" }
+            }
+        }))?)
+        .await?;
+    assert!(matches!(
+        transport.receive().await,
+        Some(JsonRpcMessage::Response(_))
+    ));
+    Ok(())
+}
+
+#[tokio::test]
+async fn each_connection_requires_its_own_declared_capability() -> anyhow::Result<()> {
+    let taps = CustomNotificationTaps::default();
+    let mut receiver = taps.subscribe(EVENT.to_string(), CAPABILITY.to_string(), 4);
+    for declares in [true, false, true] {
+        let mut transport = taps.capture(scripted(declares, vec![notification(EVENT, 1)])?);
+        initialize_transport(&mut transport).await?;
+        let passed = transport.receive().await;
+        if declares {
+            assert!(passed.is_none());
+            assert_eq!(receiver.try_recv()?.params, Some(json!({ "n": 1 })));
+        } else {
+            assert_eq!(passed.and_then(custom_params), Some(json!({ "n": 1 })));
+            assert!(receiver.try_recv().is_err());
+        }
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn notification_before_initialize_is_not_claimed() {
+    let taps = CustomNotificationTaps::default();
+    let mut receiver = taps.subscribe(EVENT.to_string(), CAPABILITY.to_string(), 4);
+    let messages = VecDeque::from([JsonRpcMessage::notification(
+        ServerNotification::CustomNotification(notification(EVENT, 1)),
+    )]);
+    let mut transport = taps.capture(Scripted(messages));
+    assert_eq!(
+        transport.receive().await.and_then(custom_params),
+        Some(json!({ "n": 1 }))
+    );
+    assert!(receiver.try_recv().is_err());
+}
