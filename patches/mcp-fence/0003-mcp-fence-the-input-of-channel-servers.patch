+use crate::channel::ChannelHub;
+use crate::channel::ChannelNotification;
+use crate::channel::ChannelSubscription;
+
+const WAIT: Duration = Duration::from_secs(5);
+const QUIET: Duration = Duration::from_millis(200);
+
+/// A channel server that says hello unless it starts fenced, and follows `channel/fence`.
+#[derive(Clone)]
+struct FenceServer {
+    declares_fence: bool,
+    client_capabilities: mpsc::Sender<Value>,
+    requests: mpsc::Sender<Value>,
+}
+
+fn channel_notification(params: Value) -> ServerNotification {
+    ServerNotification::CustomNotification(CustomNotification::new(
+        CHANNEL_NOTIFICATION_METHOD,
+        Some(params),
+    ))
+}
+
+impl rmcp::ServerHandler for FenceServer {
+    fn get_info(&self) -> rmcp::model::ServerConfig {
+        let mut experimental = std::collections::BTreeMap::new();
+        experimental.insert(CHANNEL_CAPABILITY.to_string(), Default::default());
+        if self.declares_fence {
+            experimental.insert(CHANNEL_FENCE_CAPABILITY.to_string(), Default::default());
+        }
+        let mut capabilities = rmcp::model::ServerCapabilities::default();
+        capabilities.experimental = Some(experimental);
+        rmcp::model::ServerConfig::new(capabilities)
+    }
+
+    async fn on_initialized(&self, context: NotificationContext<RoleServer>) {
+        let capabilities = context
+            .peer
+            .peer_info()
+            .map(|info| json!(info.capabilities))
+            .unwrap_or_default();
+        let fenced =
+            capabilities["experimental"][CHANNEL_FENCE_CAPABILITY]["closed"] == json!(true);
+        self.client_capabilities
+            .send(capabilities)
+            .await
+            .expect("record client capabilities");
+        if !fenced {
+            context
+                .peer
+                .send_notification(channel_notification(json!({ "content": "hello" })))
+                .await
+                .expect("send hello");
+        }
+    }
+
+    async fn on_custom_request(
+        &self,
+        request: CustomRequest,
+        context: RequestContext<RoleServer>,
+    ) -> Result<CustomResult, rmcp::ErrorData> {
+        let params = request.params.unwrap_or_default();
+        if params["closed"] == json!(true) {
+            context
+                .peer
+                .send_notification(channel_notification(
+                    json!({ "content": "", "meta": { "fence": params["token"] } }),
+                ))
+                .await
+                .expect("send marker");
+        }
+        self.requests.send(params).await.expect("record request");
+        Ok(CustomResult::new(json!({})))
+    }
+}
+
+impl InProcessTransportFactory for FenceServer {
+    fn open(&self) -> BoxFuture<'static, std::io::Result<tokio::io::DuplexStream>> {
+        let server = self.clone();
+        async move {
+            let (client, transport) = tokio::io::duplex(/*max_buf_size*/ 4096);
+            tokio::spawn(async move {
+                let service = server.serve(transport).await.expect("serve");
+                let _ = service.waiting().await;
+            });
+            Ok(client)
+        }
+        .boxed()
+    }
+}
+
+struct Connection {
+    client: Arc<RmcpClient>,
+    client_capabilities: mpsc::Receiver<Value>,
+    requests: mpsc::Receiver<Value>,
+}
+
+/// Connects server `srv` of `hub`'s thread the way a runtime does.
+async fn connect(hub: &ChannelHub, declares_fence: bool) -> anyhow::Result<Connection> {
+    let (capabilities_sender, client_capabilities) = mpsc::channel(4);
+    let (requests_sender, requests) = mpsc::channel(4);
+    let client = Arc::new(
+        RmcpClient::new_in_process_client(Arc::new(FenceServer {
+            declares_fence,
+            client_capabilities: capabilities_sender,
+            requests: requests_sender,
+        }))
+        .await?,
+    );
+    hub.fence().attach("srv", &client);
+    let mut params = InitializeRequestParams::new(
+        ClientCapabilities::default(),
+        Implementation::new("test", "1"),
+    );
+    let channel = ChannelSubscription::prepare(Some(hub.clone()), &client, &mut params);
+    let initialize_result = client
+        .initialize(
+            params,
+            Some(WAIT),
+            Box::new(|_, _| async { anyhow::bail!("unexpected elicitation") }.boxed()),
+        )
+        .await?;
+    if let Some(channel) = channel {
+        channel.connect("srv".to_string(), &initialize_result);
+    }
+    Ok(Connection {
+        client,
+        client_capabilities,
+        requests,
+    })
+}
+
+async fn wait_for(
+    fence: &ChannelFence,
+    wanted: impl Fn(&[ChannelServerState]) -> bool,
+) -> anyhow::Result<Vec<ChannelServerState>> {
+    let mut revision = fence.subscribe();
+    timeout(WAIT, async {
+        loop {
+            let servers = fence.servers().await;
+            if wanted(&servers) {
+                return servers;
+            }
+            // Phases are read on demand, so poll as well.
+            let _ = timeout(Duration::from_millis(50), revision.changed()).await;
+        }
+    })
+    .await
+    .context("the channel fence did not reach the expected state")
+}
+
+async fn next(receiver: &mut mpsc::Receiver<Value>) -> anyhow::Result<Value> {
+    timeout(WAIT, receiver.recv())
+        .await?
+        .context("the server stopped recording")
+}
+
+async fn next_notification(
+    receiver: &mut mpsc::Receiver<ChannelNotification>,
+) -> anyhow::Result<ChannelNotification> {
+    timeout(WAIT, receiver.recv())
+        .await?
+        .context("the hub closed")
+}
+
+fn marker(generation: u64, token: &str) -> ChannelNotification {
+    ChannelNotification {
+        server: "srv".to_string(),
+        generation,
+        params: Some(json!({ "content": "", "meta": { "fence": token } })),
+    }
+}
+
+#[tokio::test]
+async fn closing_asks_a_ready_server_and_opening_releases_it() -> anyhow::Result<()> {
+    let hub = ChannelHub::default();
+    let mut notifications = hub.take_receiver().context("hub receiver")?;
+    let fence = hub.fence();
+    let mut connection = connect(&hub, /*declares_fence*/ true).await?;
+
+    let capabilities = next(&mut connection.client_capabilities).await?;
+    assert_eq!(
+        capabilities["experimental"][CHANNEL_FENCE_CAPABILITY],
+        json!({ "closed": false, "token": null })
+    );
+    let hello = next_notification(&mut notifications).await?;
+    assert_eq!(hello.generation, 1);
+    wait_for(&fence, |servers| {
+        servers.len() == 1 && servers[0].connection == ChannelConnection::Ready
+    })
+    .await?;
+
+    fence.set(Some("fence-1".to_string()));
+    assert_eq!(
+        next(&mut connection.requests).await?,
+        json!({ "closed": true, "token": "fence-1" })
+    );
+    assert_eq!(
+        next_notification(&mut notifications).await?,
+        marker(1, "fence-1")
+    );
+    let servers = wait_for(&fence, |servers| {
+        servers[0].fence == ServerFence::Acknowledged
+    })
+    .await?;
+    assert_eq!(
+        servers,
+        vec![ChannelServerState {
+            server: "srv".to_string(),
+            generation: 1,
+            pid: None,
+            connection: ChannelConnection::Ready,
+            init_fence: Some(InitFence {
+                closed: false,
+                token: None,
+            }),
+            fence: ServerFence::Acknowledged,
+        }]
+    );
+    assert_eq!(fence.token(), Some("fence-1".to_string()));
+
+    // Closing again with the same token asks nothing.
+    fence.set(Some("fence-1".to_string()));
+    assert!(timeout(QUIET, connection.requests.recv()).await.is_err());
+
+    fence.set(None);
+    assert_eq!(
+        next(&mut connection.requests).await?,
+        json!({ "closed": false, "token": null })
+    );
+    wait_for(&fence, |servers| servers[0].fence == ServerFence::Open).await?;
+    assert_eq!(fence.dropped(), 0);
+    connection.client.shutdown().await;
+    wait_for(&fence, |servers| {
+        servers[0].connection == ChannelConnection::Closed
+    })
+    .await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn a_connection_made_while_closed_starts_closed_and_is_asked_again() -> anyhow::Result<()> {
+    let hub = ChannelHub::default();
+    let mut notifications = hub.take_receiver().context("hub receiver")?;
+    let fence = hub.fence();
+    let mut first = connect(&hub, /*declares_fence*/ true).await?;
+    assert_eq!(next_notification(&mut notifications).await?.generation, 1);
+    wait_for(&fence, |servers| {
+        servers[0].connection == ChannelConnection::Ready
+    })
+    .await?;
+    fence.set(Some("fence-2".to_string()));
+    next(&mut first.requests).await?;
+    assert_eq!(
+        next_notification(&mut notifications).await?,
+        marker(1, "fence-2")
+    );
+
+    // A refresh replaces the connection while the fence is closed.
+    first.client.shutdown().await;
+    let mut second = connect(&hub, /*declares_fence*/ true).await?;
+    assert_eq!(
+        next(&mut second.client_capabilities).await?["experimental"][CHANNEL_FENCE_CAPABILITY],
+        json!({ "closed": true, "token": "fence-2" })
+    );
+    assert_eq!(
+        next(&mut second.requests).await?,
+        json!({ "closed": true, "token": "fence-2" })
+    );
+    // The fenced server sent no hello: its marker is the next notification.
+    assert_eq!(
+        next_notification(&mut notifications).await?,
+        marker(2, "fence-2")
+    );
+    let servers = wait_for(&fence, |servers| {
+        servers[0].generation == 2 && servers[0].fence == ServerFence::Acknowledged
+    })
+    .await?;
+    assert_eq!(
+        servers[0].init_fence,
+        Some(InitFence {
+            closed: true,
+            token: Some("fence-2".to_string()),
+        })
+    );
+    assert!(timeout(QUIET, first.requests.recv()).await.is_err());
+    second.client.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn a_server_without_the_capability_is_unsupported_and_its_launches_wait() -> anyhow::Result<()>
+{
+    let hub = ChannelHub::default();
+    let fence = hub.fence();
+    let mut connection = connect(&hub, /*declares_fence*/ false).await?;
+    wait_for(&fence, |servers| {
+        servers[0].connection == ChannelConnection::Ready
+    })
+    .await?;
+
+    fence.set(Some("fence-3".to_string()));
+    wait_for(&fence, |servers| {
+        servers[0].fence == ServerFence::Unsupported
+    })
+    .await?;
+    assert!(timeout(QUIET, connection.requests.recv()).await.is_err());
+
+    // A new connection of this server waits until the fence opens.
+    let launch = tokio::spawn({
+        let fence = fence.clone();
+        async move { fence.wait_for_launch("srv").await }
+    });
+    wait_for(&fence, |servers| {
+        servers[0].connection == ChannelConnection::FencedWaiting
+    })
+    .await?;
+    tokio::time::sleep(QUIET).await;
+    assert!(!launch.is_finished());
+
+    fence.set(None);
+    timeout(WAIT, launch).await??;
+    wait_for(&fence, |servers| {
+        servers[0].connection == ChannelConnection::Ready && servers[0].fence == ServerFence::Open
+    })
+    .await?;
+    connection.client.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn a_cancelled_launch_stops_waiting() -> anyhow::Result<()> {
+    let fence = ChannelFence::default();
+    fence.set(Some("fence-4".to_string()));
+    let launch = tokio::spawn({
+        let fence = fence.clone();
+        async move { fence.wait_for_launch("never-connected").await }
+    });
+    let servers = wait_for(&fence, |servers| {
+        servers.len() == 1 && servers[0].connection == ChannelConnection::FencedWaiting
+    })
+    .await?;
+    assert_eq!(servers[0].fence, ServerFence::Unsupported);
+    assert_eq!(servers[0].generation, 0);
+    launch.abort();
+    let servers = wait_for(&fence, |servers| {
+        servers[0].connection != ChannelConnection::FencedWaiting
+    })
+    .await?;
+    assert_eq!(servers[0].connection, ChannelConnection::Launching);
+    Ok(())
+}
