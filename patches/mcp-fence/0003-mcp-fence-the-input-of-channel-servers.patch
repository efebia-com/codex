new file mode 100644
index 0000000000..8273c67d10
--- /dev/null
+++ b/codex-rs/codex-mcp/src/channel_fence.rs
@@ -0,0 +1,521 @@
+//! A thread's fence on the input of its channel servers.
+//!
+//! Closing the fence asks every channel server that declares the `channel/fence` experimental
+//! capability to stop accepting input, emit what it already accepted, and then emit a marker:
+//! a `notifications/claude/channel` notification whose `meta.fence` is the fence token. Every
+//! `initialize` carries the current fence, so a server that restarts or reconnects while the
+//! fence is closed starts closed; each connection that becomes ready while the fence is closed
+//! is asked again. A server without the capability cannot fence itself: while the fence is
+//! closed, no process is launched for it, neither by recovery nor by a new connection.
+//!
+//! The fence belongs to the thread, not to any client of the app server, and survives every
+//! runtime refresh of the thread's MCP connections.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::MutexGuard;
+use std::sync::PoisonError;
+use std::sync::Weak;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use codex_rmcp_client::ConnectionPhase;
+use codex_rmcp_client::RmcpClient;
+use rmcp::model::JsonObject;
+use serde_json::Value;
+use serde_json::json;
+use tokio::sync::watch;
+use tracing::warn;
+
+/// Experimental capability declared by a server that can fence its input, and by Codex with
+/// the current fence: `{"closed": bool, "token": string | null}`.
+pub const CHANNEL_FENCE_CAPABILITY: &str = "channel/fence";
+/// Request that closes or opens a server's fence: `{"closed": bool, "token": string | null}`.
+pub const CHANNEL_FENCE_METHOD: &str = "channel/fence";
+
+const FENCE_REQUEST_TIMEOUT: Duration = Duration::from_secs(30);
+
+/// The fence an `initialize` carried.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct InitFence {
+    pub closed: bool,
+    pub token: Option<String>,
+}
+
+/// A channel server's connection, as the fence sees it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ChannelConnection {
+    /// The first connection, or a replacement, is being launched and initialized.
+    Launching,
+    Ready,
+    /// The connection ended and a replacement is pending.
+    Recovering,
+    /// No process runs, and none is launched while the fence stays closed.
+    FencedWaiting,
+    /// The connection ended and recovery gave up.
+    GaveUp,
+    /// The connection ended without recovery, or was shut down.
+    Closed,
+}
+
+/// A channel server's fence, for its current connection and the current token.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ServerFence {
+    /// The fence is open.
+    Open,
+    /// The fence is closed and the server has not answered yet.
+    Requested,
+    /// The server answered: its marker for the token precedes the answer.
+    Acknowledged,
+    /// The current connection did not declare the capability, or there is none.
+    Unsupported,
+    /// The request failed on the current connection.
+    Failed(String),
+}
+
+/// One channel server of the thread.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ChannelServerState {
+    pub server: String,
+    /// The current connection, numbered per server as connections initialize; 0 before the
+    /// first. It changes when a connection becomes ready.
+    pub generation: u64,
+    /// Local OS process ID of the server's latest process.
+    pub pid: Option<u32>,
+    pub connection: ChannelConnection,
+    /// What the current connection's `initialize` carried.
+    pub init_fence: Option<InitFence>,
+    pub fence: ServerFence,
+}
+
+/// The fence of one thread's channel servers. Clones share the same fence.
+#[derive(Clone, Default)]
+pub struct ChannelFence {
+    inner: Arc<Inner>,
+}
+
+struct Inner {
+    state: Mutex<FenceState>,
+    revision: watch::Sender<u64>,
+    dropped: Arc<AtomicU64>,
+}
+
+impl Default for Inner {
+    fn default() -> Self {
+        Self {
+            state: Mutex::default(),
+            revision: watch::channel(0).0,
+            dropped: Arc::default(),
+        }
+    }
+}
+
+#[derive(Default)]
+struct FenceState {
+    token: Option<String>,
+    servers: BTreeMap<String, ServerEntry>,
+}
+
+#[derive(Default)]
+struct ServerEntry {
+    /// The server's current client, once one is attached.
+    client: Option<Weak<RmcpClient>>,
+    /// Numbers the connections of every client of this server.
+    generations: Arc<AtomicU64>,
+    /// The latest connection observed ready.
+    ready_generation: u64,
+    /// Whether that connection declared the capability.
+    supported: bool,
+    /// A new connection waits for the fence to open.
+    waiting_launch: bool,
+    request: Option<FenceRequest>,
+}
+
+struct FenceRequest {
+    generation: u64,
+    token: Option<String>,
+    outcome: RequestOutcome,
+}
+
+#[derive(Clone)]
+enum RequestOutcome {
+    Pending,
+    Acknowledged,
+    Failed(String),
+}
+
+impl ChannelFence {
+    /// Closes the fence with `token`, or opens it. Returns at once; the servers are asked in
+    /// the background, and [`Self::servers`] shows their progress.
+    pub fn set(&self, token: Option<String>) {
+        let requests = {
+            let mut state = self.lock();
+            if state.token == token {
+                return;
+            }
+            state.token.clone_from(&token);
+            let flag = initialize_flag(token.as_deref());
+            let mut requests = Vec::new();
+            for (server, entry) in &mut state.servers {
+                let Some(client) = entry.client.as_ref().and_then(Weak::upgrade) else {
+                    continue;
+                };
+                client.set_initialize_experimental(CHANNEL_FENCE_CAPABILITY, Some(flag.clone()));
+                client.hold_launches(token.is_some() && !entry.supported);
+                if entry.supported && entry.ready_generation > 0 {
+                    entry.request = Some(FenceRequest {
+                        generation: entry.ready_generation,
+                        token: token.clone(),
+                        outcome: RequestOutcome::Pending,
+                    });
+                    requests.push((server.clone(), client, entry.ready_generation));
+                }
+            }
+            requests
+        };
+        self.changed();
+        for (server, client, generation) in requests {
+            self.request(server, client, generation, token.clone());
+        }
+    }
+
+    /// The current token, while the fence is closed.
+    pub fn token(&self) -> Option<String> {
+        self.lock().token.clone()
+    }
+
+    /// The channel servers of the thread that have started at least once.
+    pub async fn servers(&self) -> Vec<ChannelServerState> {
+        let (token, entries) = {
+            let state = self.lock();
+            let entries: Vec<_> = state
+                .servers
+                .iter()
+                .map(|(server, entry)| {
+                    (
+                        server.clone(),
+                        entry.client.clone(),
+                        entry.ready_generation,
+                        entry.waiting_launch,
+                        entry.request.as_ref().map(|request| {
+                            (
+                                request.generation,
+                                request.token.clone(),
+                                request.outcome.clone(),
+                            )
+                        }),
+                    )
+                })
+                .collect();
+            (state.token.clone(), entries)
+        };
+        let mut servers = Vec::with_capacity(entries.len());
+        for (server, client, ready_generation, waiting_launch, request) in entries {
+            let status = match client.as_ref().map(Weak::upgrade) {
+                Some(Some(client)) => Some(client.connection_status().await),
+                Some(None) | None => None,
+            };
+            let connection = if waiting_launch {
+                ChannelConnection::FencedWaiting
+            } else {
+                match (&client, &status) {
+                    (None, _) => ChannelConnection::Launching,
+                    (Some(_), None) => ChannelConnection::Closed,
+                    (Some(_), Some(status)) => match status.phase {
+                        ConnectionPhase::Launching => ChannelConnection::Launching,
+                        ConnectionPhase::Ready => ChannelConnection::Ready,
+                        ConnectionPhase::Recovering => ChannelConnection::Recovering,
+                        ConnectionPhase::Held => ChannelConnection::FencedWaiting,
+                        ConnectionPhase::GaveUp => ChannelConnection::GaveUp,
+                        ConnectionPhase::Closed => ChannelConnection::Closed,
+                    },
+                }
+            };
+            let generation = status
+                .as_ref()
+                .map_or(ready_generation, |status| status.generation);
+            let supported = status.as_ref().is_some_and(|status| {
+                status
+                    .server_experimental
+                    .iter()
+                    .any(|key| key == CHANNEL_FENCE_CAPABILITY)
+            });
+            let fence = match &token {
+                None => ServerFence::Open,
+                Some(_) if generation == 0 || !supported => ServerFence::Unsupported,
+                Some(token) => match request {
+                    Some((requested, Some(requested_token), outcome))
+                        if requested == generation && requested_token == *token =>
+                    {
+                        match outcome {
+                            RequestOutcome::Pending => ServerFence::Requested,
+                            RequestOutcome::Acknowledged => ServerFence::Acknowledged,
+                            RequestOutcome::Failed(error) => ServerFence::Failed(error),
+                        }
+                    }
+                    _ => ServerFence::Requested,
+                },
+            };
+            let init_fence = status.as_ref().and_then(|status| {
+                status
+                    .initialize_experimental
+                    .get(CHANNEL_FENCE_CAPABILITY)
+                    .map(parse_initialize_flag)
+            });
+            servers.push(ChannelServerState {
+                server,
+                generation,
+                pid: status.as_ref().and_then(|status| status.pid),
+                connection,
+                init_fence,
+                fence,
+            });
+        }
+        servers
+    }
+
+    /// A revision that changes whenever the fence or a server's state may have changed.
+    pub fn subscribe(&self) -> watch::Receiver<u64> {
+        self.inner.revision.subscribe()
+    }
+
+    /// Channel notifications of the thread dropped so far because a queue was full.
+    pub fn dropped(&self) -> u64 {
+        self.inner.dropped.load(Ordering::Relaxed)
+    }
+
+    pub(crate) fn dropped_counter(&self) -> Arc<AtomicU64> {
+        Arc::clone(&self.inner.dropped)
+    }
+
+    /// Waits while the fence is closed and `server` cannot fence itself, before a new
+    /// connection launches its process.
+    pub(crate) async fn wait_for_launch(&self, server: &str) {
+        let mut revision = self.subscribe();
+        let mut waiting: Option<WaitingLaunch> = None;
+        loop {
+            let hold = {
+                let mut state = self.lock();
+                let closed = state.token.is_some();
+                let entry = state.servers.entry(server.to_string()).or_default();
+                closed && !entry.supported
+            };
+            if !hold {
+                return;
+            }
+            if waiting.is_none() {
+                waiting = Some(WaitingLaunch::new(self.clone(), server.to_string()));
+            }
+            if revision.changed().await.is_err() {
+                return;
+            }
+        }
+    }
+
+    /// Makes `client` the server's current client. Call before `initialize`.
+    pub(crate) fn attach(&self, server: &str, client: &Arc<RmcpClient>) {
+        {
+            let mut state = self.lock();
+            let token = state.token.clone();
+            let entry = state.servers.entry(server.to_string()).or_default();
+            entry.client = Some(Arc::downgrade(client));
+            client.share_connection_generations(Arc::clone(&entry.generations));
+            client.set_initialize_experimental(
+                CHANNEL_FENCE_CAPABILITY,
+                Some(initialize_flag(token.as_deref())),
+            );
+            client.hold_launches(token.is_some() && !entry.supported);
+        }
+        self.changed();
+        let fence = self.clone();
+        let server = server.to_string();
+        let weak = Arc::downgrade(client);
+        let mut changes = client.connection_changes();
+        tokio::spawn(async move {
+            loop {
+                let Some(client) = weak.upgrade() else {
+                    break;
+                };
+                fence.observe(&server, &client).await;
+                drop(client);
+                if changes.changed().await.is_err() {
+                    break;
+                }
+            }
+            fence.changed();
+        });
+    }
+
+    /// Asks a connection that became ready while the fence is closed.
+    async fn observe(&self, server: &str, client: &Arc<RmcpClient>) {
+        let status = client.connection_status().await;
+        let request = {
+            let mut state = self.lock();
+            let token = state.token.clone();
+            let Some(entry) = state.servers.get_mut(server) else {
+                return;
+            };
+            let current = entry
+                .client
+                .as_ref()
+                .is_some_and(|current| std::ptr::eq(current.as_ptr(), Arc::as_ptr(client)));
+            if !current
+                || status.phase != ConnectionPhase::Ready
+                || status.generation <= entry.ready_generation
+            {
+                None
+            } else {
+                entry.ready_generation = status.generation;
+                entry.supported = status
+                    .server_experimental
+                    .iter()
+                    .any(|key| key == CHANNEL_FENCE_CAPABILITY);
+                client.hold_launches(token.is_some() && !entry.supported);
+                match token {
+                    Some(token) if entry.supported => {
+                        entry.request = Some(FenceRequest {
+                            generation: status.generation,
+                            token: Some(token.clone()),
+                            outcome: RequestOutcome::Pending,
+                        });
+                        Some((status.generation, token))
+                    }
+                    _ => None,
+                }
+            }
+        };
+        self.changed();
+        if let Some((generation, token)) = request {
+            self.request(
+                server.to_string(),
+                Arc::clone(client),
+                generation,
+                Some(token),
+            );
+        }
+    }
+
+    fn request(
+        &self,
+        server: String,
+        client: Arc<RmcpClient>,
+        generation: u64,
+        token: Option<String>,
+    ) {
+        let fence = self.clone();
+        tokio::spawn(async move {
+            let params = json!({ "closed": token.is_some(), "token": token });
+            let result = client
+                .send_custom_request_with_timeout(
+                    CHANNEL_FENCE_METHOD,
+                    Some(params),
+                    Some(FENCE_REQUEST_TIMEOUT),
+                )
+                .await;
+            drop(client);
+            fence.finish_request(&server, generation, token.as_deref(), result.map(|_| ()));
+        });
+    }
+
+    fn finish_request(
+        &self,
+        server: &str,
+        generation: u64,
+        token: Option<&str>,
+        result: anyhow::Result<()>,
+    ) {
+        {
+            let mut state = self.lock();
+            let Some(request) = state
+                .servers
+                .get_mut(server)
+                .and_then(|entry| entry.request.as_mut())
+            else {
+                return;
+            };
+            if request.generation != generation || request.token.as_deref() != token {
+                return;
+            }
+            request.outcome = match result {
+                Ok(()) => RequestOutcome::Acknowledged,
+                Err(error) => {
+                    warn!(
+                        server,
+                        generation, "MCP channel fence request failed: {error:#}"
+                    );
+                    RequestOutcome::Failed(format!("{error:#}"))
+                }
+            };
+        }
+        self.changed();
+    }
+
+    fn changed(&self) {
+        self.inner
+            .revision
+            .send_modify(|revision| *revision = revision.wrapping_add(1));
+    }
+
+    fn lock(&self) -> MutexGuard<'_, FenceState> {
+        self.inner
+            .state
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+    }
+}
+
+/// Marks a new connection of `server` as held by the fence until dropped.
+struct WaitingLaunch {
+    fence: ChannelFence,
+    server: String,
+}
+
+impl WaitingLaunch {
+    fn new(fence: ChannelFence, server: String) -> Self {
+        fence.set_waiting(&server, /*waiting*/ true);
+        Self { fence, server }
+    }
+}
+
+impl Drop for WaitingLaunch {
+    fn drop(&mut self) {
+        self.fence.set_waiting(&self.server, /*waiting*/ false);
+    }
+}
+
+impl ChannelFence {
+    fn set_waiting(&self, server: &str, waiting: bool) {
+        self.lock()
+            .servers
+            .entry(server.to_string())
+            .or_default()
+            .waiting_launch = waiting;
+        self.changed();
+    }
+}
+
+fn initialize_flag(token: Option<&str>) -> JsonObject {
+    let mut flag = JsonObject::new();
+    flag.insert("closed".to_string(), Value::Bool(token.is_some()));
+    flag.insert(
+        "token".to_string(),
+        token.map_or(Value::Null, |token| Value::String(token.to_string())),
+    );
+    flag
+}
+
+fn parse_initialize_flag(flag: &JsonObject) -> InitFence {
+    InitFence {
+        closed: flag.get("closed").and_then(Value::as_bool).unwrap_or(false),
+        token: flag
+            .get("token")
+            .and_then(Value::as_str)
+            .map(str::to_string),
+    }
+}
+
