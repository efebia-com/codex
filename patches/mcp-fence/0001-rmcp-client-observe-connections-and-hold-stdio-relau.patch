+//! Observable lifecycle of a client's connection: phase, generation and server process.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::PoisonError;
+use std::sync::atomic::AtomicU64;
+
+use rmcp::model::JsonObject;
+use tokio::sync::watch;
+
+use super::ClientState;
+use super::RmcpClient;
+
+/// Lifecycle phase of a client's connection.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ConnectionPhase {
+    /// The first connection, or a replacement, is being launched and initialized.
+    Launching,
+    /// A connection is installed and open.
+    Ready,
+    /// The connection ended and a replacement is pending.
+    Recovering,
+    /// The connection ended and launches are held; see [`RmcpClient::hold_launches`].
+    Held,
+    /// The connection ended and recovery gave up.
+    GaveUp,
+    /// The connection ended without recovery, or the client shut down.
+    Closed,
+}
+
+/// A snapshot of a client's connection.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ConnectionStatus {
+    /// Number of the installed connection, 0 before the first handshake succeeds. Connections
+    /// are numbered as their `initialize` responses arrive.
+    pub generation: u64,
+    /// Local OS process ID of the latest stdio server process, if any.
+    pub pid: Option<u32>,
+    pub phase: ConnectionPhase,
+    /// Experimental client capabilities added to the installed connection's `initialize`.
+    pub initialize_experimental: BTreeMap<String, JsonObject>,
+    /// Experimental capabilities declared by the installed connection's server.
+    pub server_experimental: Vec<String>,
+}
+
+impl RmcpClient {
+    /// A revision that changes whenever the connection's phase or generation may have changed.
+    pub fn connection_changes(&self) -> watch::Receiver<u64> {
+        self.connection_changes.subscribe()
+    }
+
+    /// The connection's current phase, generation and process.
+    pub async fn connection_status(&self) -> ConnectionStatus {
+        let installed = self
+            .ready_connection
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .clone()
+            .unwrap_or_default();
+        let phase = self.connection_phase().await;
+        let pid = match &self.stdio_process {
+            Some(slot) => slot.lock().await.process().pid(),
+            None => None,
+        };
+        ConnectionStatus {
+            generation: installed.generation,
+            pid,
+            phase,
+            initialize_experimental: installed.sent,
+            server_experimental: installed.declared,
+        }
+    }
+
+    /// Whether an initialized connection ended and its replacement is pending, launching or
+    /// held.
+    pub async fn is_recovering(&self) -> bool {
+        let state = self.state.lock().await;
+        let (ClientState::Ready { service, .. }, Some(restart)) = (&*state, &self.stdio_restart)
+        else {
+            return false;
+        };
+        let ended = service.is_closed() || service.peer().is_transport_closed();
+        matches!(
+            restart.phase(ended),
+            ConnectionPhase::Recovering | ConnectionPhase::Launching | ConnectionPhase::Held
+        )
+    }
+
+    /// Adds `value` under `key` to the experimental client capabilities of every later
+    /// `initialize`, those of recovered connections included, or stops adding it.
+    pub fn set_initialize_experimental(&self, key: impl Into<String>, value: Option<JsonObject>) {
+        self.custom_notifications
+            .set_initialize_experimental(key.into(), value);
+    }
+
+    /// Numbers this client's connections from `generations`, which the clients that precede
+    /// or replace it can share. Call before `initialize`.
+    pub fn share_connection_generations(&self, generations: Arc<AtomicU64>) {
+        self.custom_notifications.share_generations(generations);
+    }
+
+    /// While held, recovery launches no replacement for an ended stdio connection, and stops a
+    /// replacement that is still initializing. Held time spends none of the restart budget.
+    /// Clients without stdio recovery ignore this.
+    pub fn hold_launches(&self, hold: bool) {
+        if let Some(restart) = &self.stdio_restart {
+            restart.hold(hold);
+        }
+    }
+
+    pub(super) fn connection_changed(&self) {
+        self.connection_changes
+            .send_modify(|revision| *revision = revision.wrapping_add(1));
+    }
+
+    /// Records the connection that a successful handshake just installed.
+    pub(super) fn connection_installed(&self) {
+        *self
+            .ready_connection
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner) =
+            self.custom_notifications.latest_connection();
+        self.connection_changed();
+    }
+
+    async fn connection_phase(&self) -> ConnectionPhase {
+        let state = self.state.lock().await;
+        match &*state {
+            ClientState::Connecting { .. } => ConnectionPhase::Launching,
+            ClientState::Closed => ConnectionPhase::Closed,
+            ClientState::Ready { service, .. } => {
+                let ended = service.is_closed() || service.peer().is_transport_closed();
+                match &self.stdio_restart {
+                    Some(restart) => restart.phase(ended),
+                    None if ended => ConnectionPhase::Closed,
+                    None => ConnectionPhase::Ready,
+                }
+            }
+        }
+    }
+}
