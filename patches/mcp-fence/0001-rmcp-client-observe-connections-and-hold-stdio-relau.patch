+/// Records what the client sends, and receives like [`Scripted`].
+struct Recording {
+    sent: Arc<Mutex<Vec<Value>>>,
+    script: Scripted,
+}
+
+impl Transport<RoleClient> for Recording {
+    type Error = std::io::Error;
+
+    fn send(
+        &mut self,
+        message: TxJsonRpcMessage<RoleClient>,
+    ) -> impl Future<Output = Result<(), Self::Error>> + Send + 'static {
+        let recorded = serde_json::to_value(&message)
+            .map(|value| self.sent.lock().expect("sent messages").push(value))
+            .map_err(std::io::Error::other);
+        std::future::ready(recorded)
+    }
+
+    async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+        self.script.0.pop_front()
+    }
+
+    async fn close(&mut self) -> Result<(), Self::Error> {
+        Ok(())
+    }
+}
+
+fn flag(closed: bool) -> JsonObject {
+    json!({ "closed": closed })
+        .as_object()
+        .cloned()
+        .expect("flag object")
+}
+
+#[tokio::test]
+async fn initialize_carries_the_current_flags_and_connections_are_numbered() -> anyhow::Result<()> {
+    let taps = CustomNotificationTaps::default();
+    let mut receiver = taps.subscribe(EVENT.to_string(), CAPABILITY.to_string(), 4);
+    taps.share_generations(Arc::new(AtomicU64::new(41)));
+    for (sent_flag, generation) in [(Some(true), 42), (Some(false), 43), (None, 44)] {
+        taps.set_initialize_experimental("example/flag".to_string(), sent_flag.map(flag));
+        let sent = Arc::new(Mutex::new(Vec::new()));
+        let mut transport = taps.capture(Recording {
+            sent: Arc::clone(&sent),
+            script: scripted(true, vec![notification(EVENT, generation)])?,
+        });
+        initialize_transport(&mut transport).await?;
+        assert!(transport.receive().await.is_none());
+
+        let initialize = sent.lock().expect("sent messages")[0].clone();
+        let carried = &initialize["params"]["capabilities"]["experimental"]["example/flag"];
+        match sent_flag {
+            Some(closed) => assert_eq!(carried, &json!({ "closed": closed })),
+            None => assert_eq!(carried, &Value::Null),
+        }
+        let delivered = receiver.try_recv()?;
+        assert_eq!(
+            delivered.extensions.get::<ConnectionGeneration>(),
+            Some(&ConnectionGeneration(generation))
+        );
+        let latest = taps.latest_connection().expect("latest connection");
+        assert_eq!(latest.generation, generation);
+        assert_eq!(
+            latest.sent.get("example/flag"),
+            sent_flag.map(flag).as_ref()
+        );
+        assert_eq!(latest.declared, vec![CAPABILITY.to_string()]);
+    }
+    Ok(())
+}
+
+#[test]
+fn full_queue_drops_are_counted() {
+    let taps = CustomNotificationTaps::default();
+    let dropped = Arc::new(AtomicU64::new(0));
+    let _receiver = taps.subscribe_counting(
+        EVENT.to_string(),
+        CAPABILITY.to_string(),
+        1,
+        Arc::clone(&dropped),
+    );
+    for n in 1..=3 {
+        assert!(taps.offer(&notification(EVENT, n), &[CAPABILITY.to_string()], 0));
+    }
+    assert_eq!(dropped.load(std::sync::atomic::Ordering::Relaxed), 2);
+}
