+    let status = client.connection_status().await;
+    assert_eq!(status.phase, ConnectionPhase::Ready);
+    assert_eq!(status.generation, 1);
+    assert_eq!(status.pid, Some(u32::try_from(pid(&first)?)?));
+    assert!(!client.is_recovering().await);
+    // A new receiver has seen the current revision.
+    let changes = client.connection_changes();
+    kill(&first)?;
+    let status = wait_status(&client, |status| {
+        status.phase == ConnectionPhase::Recovering
+    })
+    .await?;
+    assert_eq!(status.generation, 1);
+    assert!(changes.has_changed()?);
+    assert!(client.is_recovering().await);
+    assert!(!client.is_closed().await);
+    wait_status(&client, |status| {
+        status.phase == ConnectionPhase::Ready && status.generation == 2
+    })
+    .await?;
+    assert!(!client.is_recovering().await);
+    let second = echo(&client).await?;
+    assert_eq!(
+        client.connection_status().await.pid,
