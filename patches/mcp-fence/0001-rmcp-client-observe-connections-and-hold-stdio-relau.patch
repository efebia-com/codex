+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        let generation = connections.generations.fetch_add(1, Ordering::AcqRel) + 1;
+        connections.latest = Some(InitializedConnection {
+            generation,
+            sent,
+            declared,
+        });
+        generation
+    }
