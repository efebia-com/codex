+    /// Adds `value` under `key` to the experimental capabilities of every later `initialize`,
+    /// or stops adding it.
+    pub(crate) fn set_initialize_experimental(&self, key: String, value: Option<JsonObject>) {
+        let mut connections = self
+            .connections
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        match value {
+            Some(value) => {
