@@ -0,0 +1,65 @@
+//! Opt-in recovery of private stdio MCP connections.
+
+use codex_config::ConfigLayerStack;
+use codex_config::TomlValue;
+
+pub(crate) fn restart_on_exit_enabled(layers: &ConfigLayerStack, server: &str) -> bool {
+    layers
+        .effective_config()
+        .get("mcp_servers")
+        .and_then(|servers| servers.get(server))
+        .and_then(|server| server.get("restart_on_exit"))
+        .and_then(TomlValue::as_bool)
+        .unwrap_or(false)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_config::ConfigLayerEntry;
+    use codex_config::ConfigLayerSource;
+    use serde_json::json;
+
+    #[test]
+    fn restart_config_accepts_a_boolean_and_rejects_other_types() {
+        for value in [true, false] {
+            serde_json::from_value::<codex_config::McpServerConfig>(json!({
+                "command": "server", "restart_on_exit": value,
+            }))
+            .expect("restart configuration");
+        }
+        assert!(
+            serde_json::from_value::<codex_config::McpServerConfig>(json!({
+                "command": "server", "restart_on_exit": "true",
+            }))
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn restart_requires_explicit_true_and_uses_layer_precedence() {
+        let layers = [
+            json!({"mcp_servers": {
+                "on": {"command": "server", "restart_on_exit": true},
+                "off": {"command": "server", "restart_on_exit": false},
+                "unset": {"command": "server"},
+                "overridden": {"command": "server", "restart_on_exit": true}
+            }}),
+            json!({"mcp_servers": {"overridden": {"restart_on_exit": false}}}),
+        ]
+        .into_iter()
+        .map(|value| {
+            ConfigLayerEntry::new(
+                ConfigLayerSource::SessionFlags,
+                serde_json::from_value(value).expect("TOML config"),
+            )
+        })
+        .collect();
+        let layers = ConfigLayerStack::new(layers, Default::default(), Default::default())
+            .expect("config layers");
+        assert!(restart_on_exit_enabled(&layers, "on"));
+        for server in ["off", "unset", "overridden", "missing"] {
+            assert!(!restart_on_exit_enabled(&layers, server));
+        }
+    }
+}
