diff --git a/codex-rs/rmcp-client/src/stdio_restart.rs b/codex-rs/rmcp-client/src/stdio_restart.rs
new file mode 100644
index 0000000000..87c36360e4
--- /dev/null
+++ b/codex-rs/rmcp-client/src/stdio_restart.rs
@@ -0,0 +1,479 @@
+//! Bounded recovery of an opted-in stdio connection, without replaying requests.
+
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::anyhow;
+use rmcp::service::RoleClient;
+use rmcp::service::RunningService;
+use rmcp::service::RxJsonRpcMessage;
+use rmcp::service::TxJsonRpcMessage;
+use rmcp::transport::Transport;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+use tokio_util::sync::DropGuard;
+use tracing::Instrument;
+use tracing::info;
+use tracing::warn;
+
+use super::ClientState;
+use super::RmcpClient;
+use super::TransportRecipe;
+use crate::elicitation_client_service::ElicitationClientService;
+use crate::stdio_server_launcher::StdioTermination;
+
+/// Retry delays and the uptime required to reset the budget of three launches.
+#[derive(Clone, Debug)]
+pub struct StdioRestartPolicy {
+    pub backoff: [Duration; 3],
+    pub stable_after: Duration,
+}
+
+impl Default for StdioRestartPolicy {
+    fn default() -> Self {
+        Self {
+            backoff: [1, 2, 4].map(Duration::from_secs),
+            stable_after: Duration::from_secs(60),
+        }
+    }
+}
+
+/// Keep this guard with the connection owner. Dropping its last copy stops recovery,
+/// including a recovery task that temporarily holds the client alive.
+#[must_use = "retain the guard for the lifetime of the MCP connection"]
+pub struct StdioRestartGuard {
+    _cancel_on_drop: DropGuard,
+}
+
+pub(super) struct StdioRestart {
+    policy: StdioRestartPolicy,
+    pub(super) shutdown: CancellationToken,
+    supervising: AtomicBool,
+    state: Mutex<RestartState>,
+    changed: tokio::sync::Notify,
+}
+
+#[derive(Default)]
+struct RestartState {
+    attempts: usize,
+    ready_since: Option<Instant>,
+    gave_up: Option<String>,
+    exit: Option<CancellationToken>,
+    recovering: bool,
+}
+
+impl StdioRestart {
+    fn new(policy: StdioRestartPolicy) -> Self {
+        Self {
+            policy,
+            shutdown: CancellationToken::new(),
+            supervising: AtomicBool::new(false),
+            state: Mutex::new(RestartState::default()),
+            changed: tokio::sync::Notify::new(),
+        }
+    }
+
+    pub(super) fn watch_connection(&self) -> CancellationToken {
+        let exit = CancellationToken::new();
+        self.state
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .exit = Some(exit.clone());
+        exit
+    }
+
+    pub(super) fn mark_ready(&self) {
+        {
+            let mut state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+            state.ready_since = Some(Instant::now());
+            state.recovering = false;
+        }
+        self.changed.notify_waiters();
+    }
+
+    fn exit(&self) -> Option<CancellationToken> {
+        self.state
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .exit
+            .clone()
+    }
+
+    pub(super) fn connection_exited(&self) -> bool {
+        let state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        state.recovering
+            || state
+                .exit
+                .as_ref()
+                .is_some_and(CancellationToken::is_cancelled)
+    }
+
+    pub(super) fn can_restart(&self) -> bool {
+        self.check_available().is_ok()
+    }
+
+    pub(super) fn check_available(&self) -> Result<()> {
+        if self.shutdown.is_cancelled() {
+            return Err(anyhow!("MCP client is shut down"));
+        }
+        if let Some(error) = &self
+            .state
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .gave_up
+        {
+            return Err(anyhow!(error.clone()));
+        }
+        Ok(())
+    }
+
+    fn reset_after_stable_connection(&self) {
+        let mut state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        state.recovering = true;
+        if state
+            .ready_since
+            .take()
+            .is_some_and(|since| since.elapsed() >= self.policy.stable_after)
+        {
+            state.attempts = 0;
+        }
+    }
+
+    fn next_attempt(&self) -> Option<(usize, Duration)> {
+        let mut state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        let delay = *self.policy.backoff.get(state.attempts)?;
+        state.attempts += 1;
+        Some((state.attempts, delay))
+    }
+
+    fn give_up(&self, error: &anyhow::Error) -> anyhow::Error {
+        let message =
+            format!("MCP server exited and was not restarted after 3 attempts: {error:#}");
+        self.state
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .gave_up = Some(message.clone());
+        self.changed.notify_waiters();
+        warn!("{message}");
+        anyhow!(message)
+    }
+
+    fn cleanup_failed(&self, error: anyhow::Error) -> anyhow::Error {
+        let message =
+            format!("MCP server could not be restarted because process cleanup failed: {error:#}");
+        self.state
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .gave_up = Some(message.clone());
+        self.changed.notify_waiters();
+        warn!("{message}");
+        anyhow!(message)
+    }
+}
+
+impl RmcpClient {
+    pub(super) async fn service_after_stdio_exit(
+        &self,
+    ) -> Result<Arc<RunningService<RoleClient, ElicitationClientService>>> {
+        let restart = self
+            .stdio_restart
+            .as_ref()
+            .context("stdio recovery is disabled")?;
+        if !restart.supervising.load(Ordering::Acquire) {
+            self.restart_stdio_after_exit().await?;
+        }
+        let wait = async {
+            loop {
+                let changed = restart.changed.notified();
+                tokio::pin!(changed);
+                changed.as_mut().enable();
+                restart.check_available()?;
+                {
+                    let state = self.state.lock().await;
+                    match &*state {
+                        ClientState::Ready { service, .. }
+                            if !service.is_closed()
+                                && !service.peer().is_transport_closed()
+                                && !restart.connection_exited() =>
+                        {
+                            return Ok(Arc::clone(service));
+                        }
+                        ClientState::Ready { .. } => {}
+                        _ => return Err(anyhow!("MCP client is shut down")),
+                    }
+                }
+                tokio::select! {
+                    biased;
+                    () = restart.shutdown.cancelled() => return Err(anyhow!("MCP client is shut down")),
+                    () = changed => {}
+                }
+            }
+        };
+        let timeout = self
+            .initialize_context
+            .lock()
+            .await
+            .as_ref()
+            .and_then(|context| context.timeout);
+        match timeout {
+            Some(timeout) => tokio::time::timeout(timeout, wait)
+                .await
+                .context("timed out waiting for MCP stdio server restart")?,
+            None => wait.await,
+        }
+    }
+
+    /// Enable recovery before initialize. Other transport kinds ignore this policy.
+    pub fn with_stdio_restart(mut self, policy: StdioRestartPolicy) -> Self {
+        if let TransportRecipe::Stdio { command, .. } = &mut self.transport_recipe
+            && let Some(slot) = &mut self.stdio_process
+            && let ClientState::Connecting {
+                transport: Some(super::PendingTransport::Stdio { transport }),
+            } = self.state.get_mut()
+        {
+            if let Some(slot) = Arc::get_mut(slot) {
+                slot.get_mut().retain_for_restart(transport);
+            }
+            // Pin host-resolved variables and defaults from the first actual launch.
+            // Executor-owned variables continue to be resolved by that executor.
+            *command = command.with_process_slot(Arc::clone(slot), transport.launch_env());
+            self.stdio_restart = Some(Arc::new(StdioRestart::new(policy)));
+        }
+        self
+    }
+
+    /// Start proactive exit detection after initialize and return its ownership guard.
+    pub fn supervise_stdio_restarts(self: &Arc<Self>) -> Option<StdioRestartGuard> {
+        self.supervise_stdio_restarts_with_cancellation(CancellationToken::new())
+    }
+
+    /// Also stop recovery when the owning connection is retired by a runtime refresh.
+    pub fn supervise_stdio_restarts_with_cancellation(
+        self: &Arc<Self>,
+        cancellation: CancellationToken,
+    ) -> Option<StdioRestartGuard> {
+        let restart = self.stdio_restart.as_ref()?;
+        if restart.supervising.swap(true, Ordering::AcqRel) {
+            return None;
+        }
+        let restart = Arc::clone(restart);
+        let weak = Arc::downgrade(self);
+        let guard = StdioRestartGuard {
+            _cancel_on_drop: restart.shutdown.clone().drop_guard(),
+        };
+        tokio::spawn(
+            async move {
+                let cancelled = async {
+                    tokio::select! {
+                        () = restart.shutdown.cancelled() => {}
+                        () = cancellation.cancelled() => restart.shutdown.cancel(),
+                    }
+                };
+                tokio::pin!(cancelled);
+                loop {
+                    let Some(exit) = restart.exit() else {
+                        return;
+                    };
+                    tokio::select! {
+                        biased;
+                        () = &mut cancelled => {
+                            if let Some(client) = weak.upgrade() { client.shutdown().await; }
+                            return;
+                        }
+                        () = exit.cancelled() => {}
+                    }
+                    let Some(client) = weak.upgrade() else {
+                        return;
+                    };
+                    tokio::select! {
+                        biased;
+                        () = &mut cancelled => {
+                            client.shutdown().await;
+                            return;
+                        }
+                        result = client.restart_stdio_after_exit() => {
+                            if result.is_err() { return; }
+                        }
+                    }
+                }
+            }
+            .in_current_span(),
+        );
+        Some(guard)
+    }
+
+    async fn stop_stdio_process(&self) -> Result<()> {
+        if let Some(slot) = &self.stdio_process {
+            let process = slot.lock().await.process();
+            process.terminate(StdioTermination::Shutdown).await?;
+        }
+        Ok(())
+    }
+
+    pub(super) async fn restart_stdio_after_exit(&self) -> Result<()> {
+        let restart = self
+            .stdio_restart
+            .as_ref()
+            .context("stdio recovery is disabled")?;
+        let _recovery = tokio::select! {
+            biased;
+            () = restart.shutdown.cancelled() => return Err(anyhow!("MCP client is shut down")),
+            permit = self.session_recovery_lock.acquire() => permit?,
+        };
+        restart.check_available()?;
+        {
+            let state = self.state.lock().await;
+            match &*state {
+                ClientState::Ready { service, .. }
+                    if !service.is_closed()
+                        && !service.peer().is_transport_closed()
+                        && !restart.connection_exited() =>
+                {
+                    return Ok(());
+                }
+                ClientState::Ready { .. } => {}
+                _ => return Err(anyhow!("MCP client is shut down")),
+            }
+        }
+        let context = self
+            .initialize_context
+            .lock()
+            .await
+            .clone()
+            .context("MCP client cannot recover before initialize succeeds")?;
+        restart.reset_after_stable_connection();
+        let mut last_error = anyhow!("stdio transport closed");
+        while let Some((attempt, delay)) = restart.next_attempt() {
+            // Also clean up failed handshakes before attempting another launch.
+            self.stop_stdio_process()
+                .await
+                .map_err(|error| restart.cleanup_failed(error))?;
+            tokio::select! {
+                biased;
+                () = restart.shutdown.cancelled() => return Err(anyhow!("MCP client is shut down")),
+                () = tokio::time::sleep(delay) => {}
+            }
+            let connect = async {
+                let transport = Self::create_pending_transport(&self.transport_recipe).await?;
+                self.connect_pending_transport_with_initialize_retries(transport, &context)
+                    .await
+            };
+            let result = tokio::select! {
+                biased;
+                () = restart.shutdown.cancelled() => return Err(anyhow!("MCP client is shut down")),
+                result = async {
+                    match context.timeout {
+                        Some(timeout) => tokio::time::timeout(timeout, connect).await
+                            .context("timed out restarting MCP server")?,
+                        None => connect.await,
+                    }
+                } => result,
+            };
+            match result {
+                Ok((service, oauth)) => {
+                    let mut state = self.state.lock().await;
+                    if matches!(*state, ClientState::Closed) || restart.shutdown.is_cancelled() {
+                        return Err(anyhow!("MCP client is shut down"));
+                    }
+                    *state = ClientState::Ready { service, oauth };
+                    restart.mark_ready();
+                    self.tool_list_revision.fetch_add(1, Ordering::AcqRel);
+                    info!(attempt, "restarted MCP stdio server");
+                    return Ok(());
+                }
+                Err(error) => {
+                    warn!(attempt, error = %error, "failed to restart MCP stdio server");
+                    last_error = error;
+                }
+            }
+        }
+        self.stop_stdio_process()
+            .await
+            .map_err(|error| restart.cleanup_failed(error))?;
+        Err(restart.give_up(&last_error))
+    }
+}
+
+impl Drop for RmcpClient {
+    fn drop(&mut self) {
+        if let Some(restart) = &self.stdio_restart {
+            restart.shutdown.cancel();
+        }
+    }
+}
+
+pub(super) fn watch_exit<T: Transport<RoleClient> + 'static>(
+    inner: T,
+    exit: CancellationToken,
+) -> impl Transport<RoleClient, Error = T::Error> {
+    ExitWatch { inner, exit }
+}
+
+struct ExitWatch<T> {
+    inner: T,
+    exit: CancellationToken,
+}
+
+impl<T> Drop for ExitWatch<T> {
+    fn drop(&mut self) {
+        self.exit.cancel();
+    }
+}
+
+impl<T: Transport<RoleClient> + 'static> Transport<RoleClient> for ExitWatch<T> {
+    type Error = T::Error;
+
+    fn send(
+        &mut self,
+        message: TxJsonRpcMessage<RoleClient>,
+    ) -> impl Future<Output = std::result::Result<(), Self::Error>> + Send + 'static {
+        let send = self.inner.send(message);
+        let exit = self.exit.clone();
+        async move {
+            let result = send.await;
+            if result.is_err() {
+                exit.cancel();
+            }
+            result
+        }
+    }
+
+    async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+        let result = self.inner.receive().await;
+        if result.is_none() {
+            self.exit.cancel();
+        }
+        result
+    }
+
+    fn close(&mut self) -> impl Future<Output = std::result::Result<(), Self::Error>> + Send {
+        self.inner.close()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn budget_resets_only_after_a_stable_connection() {
+        let restart = StdioRestart::new(StdioRestartPolicy::default());
+        assert_eq!(restart.next_attempt(), Some((1, Duration::from_secs(1))));
+        restart.mark_ready();
+        restart.reset_after_stable_connection();
+        assert_eq!(restart.next_attempt(), Some((2, Duration::from_secs(2))));
+        assert_eq!(restart.next_attempt(), Some((3, Duration::from_secs(4))));
+        assert!(restart.next_attempt().is_none());
+        restart.state.lock().expect("restart state").ready_since =
+            Some(Instant::now() - Duration::from_secs(60));
+        restart.reset_after_stable_connection();
+        assert_eq!(restart.next_attempt(), Some((1, Duration::from_secs(1))));
+    }
+}
