@@ -0,0 +1,70 @@
+use crate::McpServerConfig;
+use crate::McpServerEnvVar;
+use crate::McpServerTransportConfig;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn stdio_server_accepts_codex_sourced_session_variables() {
+    let config: McpServerConfig = toml::from_str(
+        r#"
+            command = "echo"
+            env_vars = [
+                { name = "CODEX_SESSION_ID", source = "codex" },
+                { name = "CODEX_THREAD_ID", source = "codex" },
+                "PLAIN",
+            ]
+        "#,
+    )
+    .expect("codex-sourced session variables should be accepted");
+
+    let McpServerTransportConfig::Stdio { env_vars, .. } = config.transport else {
+        panic!("expected stdio transport");
+    };
+    assert_eq!(
+        env_vars
+            .iter()
+            .map(|env_var| (env_var.name(), env_var.is_codex_source()))
+            .collect::<Vec<_>>(),
+        vec![
+            ("CODEX_SESSION_ID", true),
+            ("CODEX_THREAD_ID", true),
+            ("PLAIN", false),
+        ]
+    );
+}
+
+#[test]
+fn codex_source_rejects_other_variable_names() {
+    let err = toml::from_str::<McpServerConfig>(
+        r#"
+            command = "echo"
+            env_vars = [{ name = "HOME", source = "codex" }]
+        "#,
+    )
+    .expect_err("codex source should only provide session variables");
+
+    assert!(
+        err.to_string().contains(
+            "env_vars entry `HOME` uses source `codex`, which only supports `CODEX_SESSION_ID` and `CODEX_THREAD_ID`"
+        ),
+        "unexpected error: {err}"
+    );
+}
+
+#[test]
+fn codex_source_round_trips_through_serialization() {
+    let env_var = McpServerEnvVar::Config {
+        name: "CODEX_THREAD_ID".to_string(),
+        source: Some("codex".to_string()),
+    };
+
+    let serialized = serde_json::to_value(&env_var).expect("serialize env var");
+    assert_eq!(
+        serialized,
+        serde_json::json!({ "name": "CODEX_THREAD_ID", "source": "codex" })
+    );
+    let deserialized: McpServerEnvVar =
+        serde_json::from_value(serialized).expect("deserialize env var");
+    assert_eq!(deserialized, env_var);
+    assert_eq!(deserialized.validate_source(), Ok(()));
+}
