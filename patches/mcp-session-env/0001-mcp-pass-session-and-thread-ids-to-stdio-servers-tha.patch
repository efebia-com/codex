+//! Variables that Codex itself provides to opted-in stdio MCP servers.
+
+use codex_protocol::shell_environment::CODEX_SESSION_ID_ENV_VAR;
+use codex_protocol::shell_environment::CODEX_THREAD_ID_ENV_VAR;
+
+/// `env_vars` source whose value Codex provides for the thread that starts the server.
+pub const MCP_CODEX_ENV_VAR_SOURCE: &str = "codex";
+
+/// Variable names accepted with [`MCP_CODEX_ENV_VAR_SOURCE`].
+pub const MCP_CODEX_ENV_VAR_NAMES: &[&str] = &[CODEX_SESSION_ID_ENV_VAR, CODEX_THREAD_ID_ENV_VAR];
+
+pub(crate) fn validate_codex_env_var_name(name: &str) -> Result<(), String> {
+    if MCP_CODEX_ENV_VAR_NAMES.contains(&name) {
+        return Ok(());
+    }
+    Err(format!(
+        "env_vars entry `{name}` uses source `{MCP_CODEX_ENV_VAR_SOURCE}`, which only supports {}",
+        MCP_CODEX_ENV_VAR_NAMES
+            .iter()
+            .map(|name| format!("`{name}`"))
+            .collect::<Vec<_>>()
+            .join(" and ")
+    ))
+}
+
+#[cfg(test)]
+#[path = "mcp_codex_env_tests.rs"]
+mod tests;
