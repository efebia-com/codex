@@ -0,0 +1,84 @@
+//! Thread identity for stdio MCP servers that request it with `env_vars` source `codex`.
+
+use std::collections::HashMap;
+
+use codex_config::McpServerEnvVar;
+use codex_protocol::SessionId;
+use codex_protocol::ThreadId;
+use codex_protocol::shell_environment::CODEX_SESSION_ID_ENV_VAR;
+use codex_protocol::shell_environment::CODEX_THREAD_ID_ENV_VAR;
+
+/// Session and thread that own an MCP runtime.
+///
+/// The values match those given to shell commands: `CODEX_SESSION_ID` identifies the root
+/// thread and is shared by its descendant agents; `CODEX_THREAD_ID` is the thread itself.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct McpSessionEnv {
+    session_id: SessionId,
+    thread_id: ThreadId,
+}
+
+impl McpSessionEnv {
+    pub fn new(session_id: SessionId, thread_id: ThreadId) -> Self {
+        Self {
+            session_id,
+            thread_id,
+        }
+    }
+
+    fn value(&self, name: &str) -> Option<String> {
+        match name {
+            CODEX_SESSION_ID_ENV_VAR => Some(self.session_id.to_string()),
+            CODEX_THREAD_ID_ENV_VAR => Some(self.thread_id.to_string()),
+            _ => None,
+        }
+    }
+}
+
+/// Values requested through `source = "codex"`, sorted by name.
+///
+/// Without a thread, as when a server is started only to inspect it, nothing is provided.
+pub(crate) fn requested_codex_env(
+    session_env: Option<&McpSessionEnv>,
+    env_vars: &[McpServerEnvVar],
+) -> Vec<(String, String)> {
+    let Some(session_env) = session_env else {
+        return Vec::new();
+    };
+    let mut values = env_vars
+        .iter()
+        .filter(|env_var| env_var.is_codex_source())
+        .filter_map(|env_var| {
+            session_env
+                .value(env_var.name())
+                .map(|value| (env_var.name().to_string(), value))
+        })
+        .collect::<Vec<_>>();
+    values.sort();
+    values.dedup();
+    values
+}
+
+/// Adds the requested values to a stdio server's literal `env`, which they override.
+pub(crate) fn with_codex_env(
+    env: Option<HashMap<String, String>>,
+    session_env: Option<&McpSessionEnv>,
+    env_vars: &[McpServerEnvVar],
+) -> Option<HashMap<String, String>> {
+    let values = requested_codex_env(session_env, env_vars);
+    if values.is_empty() {
+        return env;
+    }
+    let mut env = env.unwrap_or_default();
+    for (name, value) in values {
+        if cfg!(windows) {
+            env.retain(|key, _| !key.eq_ignore_ascii_case(&name));
+        }
+        env.insert(name, value);
+    }
+    Some(env)
+}
+
+#[cfg(test)]
+#[path = "session_env_tests.rs"]
+mod tests;
