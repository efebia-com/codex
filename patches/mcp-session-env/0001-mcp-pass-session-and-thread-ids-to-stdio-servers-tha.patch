+use std::collections::HashMap;
+
+use codex_config::McpServerEnvVar;
+use codex_protocol::SessionId;
+use codex_protocol::ThreadId;
+use pretty_assertions::assert_eq;
+
+use super::McpSessionEnv;
+use super::requested_codex_env;
+use super::with_codex_env;
+
+const SESSION: &str = "00000000-0000-7000-8000-000000000001";
+const THREAD: &str = "00000000-0000-7000-8000-000000000002";
+
+fn session_env() -> McpSessionEnv {
+    McpSessionEnv::new(
+        SessionId::from_string(SESSION).expect("session id"),
+        ThreadId::from_string(THREAD).expect("thread id"),
+    )
+}
+
+fn sourced(name: &str, source: &str) -> McpServerEnvVar {
+    McpServerEnvVar::Config {
+        name: name.to_string(),
+        source: Some(source.to_string()),
+    }
+}
+
+#[test]
+fn provides_only_requested_codex_values() {
+    let env_vars = [
+        sourced("CODEX_THREAD_ID", "codex"),
+        sourced("CODEX_SESSION_ID", "local"),
+        "CODEX_SESSION_ID".into(),
+    ];
+
+    assert_eq!(
+        requested_codex_env(Some(&session_env()), &env_vars),
+        vec![("CODEX_THREAD_ID".to_string(), THREAD.to_string())]
+    );
+}
+
+#[test]
+fn provides_both_values_in_name_order() {
+    let env_vars = [
+        sourced("CODEX_THREAD_ID", "codex"),
+        sourced("CODEX_SESSION_ID", "codex"),
+        sourced("CODEX_THREAD_ID", "codex"),
+    ];
+
+    assert_eq!(
+        requested_codex_env(Some(&session_env()), &env_vars),
+        vec![
+            ("CODEX_SESSION_ID".to_string(), SESSION.to_string()),
+            ("CODEX_THREAD_ID".to_string(), THREAD.to_string()),
+        ]
+    );
+}
+
+#[test]
+fn without_a_thread_the_environment_is_unchanged() {
+    let env_vars = [sourced("CODEX_THREAD_ID", "codex")];
+    let env = Some(HashMap::from([("A".to_string(), "1".to_string())]));
+
+    assert_eq!(requested_codex_env(/*session_env*/ None, &env_vars), vec![]);
+    assert_eq!(
+        with_codex_env(env.clone(), /*session_env*/ None, &env_vars),
+        env
+    );
+    assert_eq!(
+        with_codex_env(/*env*/ None, /*session_env*/ None, &env_vars),
+        None
+    );
+}
+
+#[test]
+fn servers_without_the_opt_in_keep_their_environment() {
+    let env_vars = ["CODEX_THREAD_ID".into()];
+
+    assert_eq!(
+        with_codex_env(/*env*/ None, Some(&session_env()), &env_vars),
+        None
+    );
+}
+
+#[test]
+fn codex_values_override_literal_env() {
+    let env_vars = [sourced("CODEX_THREAD_ID", "codex")];
+    let env = Some(HashMap::from([
+        ("CODEX_THREAD_ID".to_string(), "configured".to_string()),
+        ("A".to_string(), "1".to_string()),
+    ]));
+
+    assert_eq!(
+        with_codex_env(env, Some(&session_env()), &env_vars),
+        Some(HashMap::from([
+            ("CODEX_THREAD_ID".to_string(), THREAD.to_string()),
+            ("A".to_string(), "1".to_string()),
+        ]))
+    );
+}
+
+#[tokio::test]
+async fn pooled_connections_never_serve_another_thread_that_requested_identity() {
+    use crate::connection_pool::tests as fixture;
+    use codex_config::McpServerConfig;
+
+    let opted_in: McpServerConfig = serde_json::from_value(serde_json::json!({
+        "command": "test-server",
+        "env_vars": [{ "name": "CODEX_THREAD_ID", "source": "codex" }],
+    }))
+    .expect("opted-in config");
+    let plain = fixture::config();
+    let other_thread = McpSessionEnv::new(
+        SessionId::from_string(SESSION).expect("session id"),
+        ThreadId::from_string("00000000-0000-7000-8000-000000000003").expect("thread id"),
+    );
+    // Threads of one process share the environment registry; only their identity differs.
+    let process = fixture::context();
+    let thread_a = process.clone().with_session_env(session_env());
+    let thread_b = process.with_session_env(other_thread);
+
+    assert!(fixture::key(&thread_a, &opted_in) != fixture::key(&thread_b, &opted_in));
+    assert!(fixture::key(&thread_a, &opted_in) == fixture::key(&thread_a, &opted_in));
+    assert!(fixture::key(&thread_a, &plain) == fixture::key(&thread_b, &plain));
+}
